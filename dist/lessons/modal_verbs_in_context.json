  "sections": [
    {
      "kind": "section",
      "id": "a-weekend-in-telemark",
      "role": "orient",
      "title": "A weekend in Telemark",
      "objective_ids": [
        "obj-modal-verbs-in-context-01"
      ],
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "It is Thursday. Colleagues Ingrid and Thomas meet in the office kitchen with their coffee."
            }
          ],
          "id": "a-weekend-in-telemark-block-1"
        },
        {
          "kind": "reading",
          "spans": [
            {
              "kind": "text",
              "value": "Nå er det snart helg igjen. Har du noen planer, Thomas?"
            }
          ],
          "translation": "Soon it's the weekend again. Do you have any plans, Thomas?",
          "speaker_id": "ingrid",
          "speaker_name": "Ingrid",
          "dialogue_id": "office",
          "id": "a-weekend-in-telemark-block-2",
          "turn_index": 1,
          "speaker_icon_url": "https://api.dicebear.com/10.x/open-peeps/svg?seed=2743e010a7805edd604b6461d07aa32e00ebb2abbe5788262aff85fbb331913d"
        },
        {
          "kind": "reading",
          "spans": [
            {
              "kind": "text",
              "value": "Jeg skal til familiehytta i Telemark. Du kan bli med, hvis du vil."
            }
          ],
          "translation": "I'm going to the family cabin in Telemark. You can come along, if you like.",
          "speaker_id": "thomas",
          "speaker_name": "Thomas",
          "dialogue_id": "office",
          "id": "a-weekend-in-telemark-block-3",
          "turn_index": 2,
          "speaker_icon_url": "https://api.dicebear.com/10.x/open-peeps/svg?seed=4ed22d9e7946487c17bf636864548b6220b4ca6a1b460b9c99a07535f5103c44"
        },
        {
          "kind": "reading",
          "spans": [
            {
              "kind": "text",
              "value": "Det vil jeg gjerne! Jeg har lyst til å komme meg ut av byen."
            }
          ],
          "translation": "I'd really like that! I want to get out of the city.",
          "speaker_id": "ingrid",
          "speaker_name": "Ingrid",
          "dialogue_id": "office",
          "id": "a-weekend-in-telemark-block-4",
          "turn_index": 3,
          "speaker_icon_url": "https://api.dicebear.com/10.x/open-peeps/svg?seed=2743e010a7805edd604b6461d07aa32e00ebb2abbe5788262aff85fbb331913d"
        },
        {
          "kind": "reading",
          "spans": [
            {
              "kind": "text",
              "value": "Koselig! Men vi reiser allerede klokka ti på fredag, så du må ta deg fri den dagen."
            }
          ],
          "translation": "Lovely! But we're leaving already at ten on Friday, so you have to take that day off.",
          "speaker_id": "thomas",
          "speaker_name": "Thomas",
          "dialogue_id": "office",
          "id": "a-weekend-in-telemark-block-5",
          "turn_index": 4,
          "speaker_icon_url": "https://api.dicebear.com/10.x/open-peeps/svg?seed=4ed22d9e7946487c17bf636864548b6220b4ca6a1b460b9c99a07535f5103c44"
        },
        {
          "kind": "reading",
          "spans": [
            {
              "kind": "text",
              "value": "Det skal gå greit. Jeg har nok feriedager til gode."
            }
          ],
          "translation": "That will be fine. I have enough holiday days left to take.",
          "speaker_id": "ingrid",
          "speaker_name": "Ingrid",
          "dialogue_id": "office",
          "id": "a-weekend-in-telemark-block-6",
          "turn_index": 5,
          "speaker_icon_url": "https://api.dicebear.com/10.x/open-peeps/svg?seed=2743e010a7805edd604b6461d07aa32e00ebb2abbe5788262aff85fbb331913d"
        },
        {
          "kind": "reading",
          "spans": [
            {
              "kind": "text",
              "value": "Kan du ta med bilen din, eller skal vi ta toget?"
            }
          ],
          "translation": "Can you bring your car, or should we take the train?",
          "speaker_id": "thomas",
          "speaker_name": "Thomas",
          "dialogue_id": "office",
          "id": "a-weekend-in-telemark-block-7",
          "turn_index": 6,
          "speaker_icon_url": "https://api.dicebear.com/10.x/open-peeps/svg?seed=4ed22d9e7946487c17bf636864548b6220b4ca6a1b460b9c99a07535f5103c44"
        },
        {
          "kind": "reading",
          "spans": [
            {
              "kind": "text",
              "value": "Jeg kan kjøre. Så kan vi dele på bensinen."
            }
          ],
          "translation": "I can drive. Then we can split the petrol.",
          "speaker_id": "ingrid",
          "speaker_name": "Ingrid",
          "dialogue_id": "office",
          "id": "a-weekend-in-telemark-block-8",
          "turn_index": 7,
          "speaker_icon_url": "https://api.dicebear.com/10.x/open-peeps/svg?seed=2743e010a7805edd604b6461d07aa32e00ebb2abbe5788262aff85fbb331913d"
        },
        {
          "kind": "reading",
          "spans": [
            {
              "kind": "text",
              "value": "Greit. Og du bør ta med ordentlige støvler — stien opp til hytta er ganske gjørmete nå."
            }
          ],
          "translation": "Fine. And you should bring proper boots — the path up to the cabin is rather muddy right now.",
          "speaker_id": "thomas",
          "speaker_name": "Thomas",
          "dialogue_id": "office",
          "id": "a-weekend-in-telemark-block-9",
          "turn_index": 8,
          "speaker_icon_url": "https://api.dicebear.com/10.x/open-peeps/svg?seed=4ed22d9e7946487c17bf636864548b6220b4ca6a1b460b9c99a07535f5103c44"
        },
        {
          "kind": "reading",
          "spans": [
            {
              "kind": "text",
              "value": "Godt at jeg ikke har noen... Da må jeg ut og kjøpe et par i kveld."
            }
          ],
          "translation": "Good thing I don't own any... Then I have to go out and buy a pair tonight.",
          "speaker_id": "ingrid",
          "speaker_name": "Ingrid",
          "dialogue_id": "office",
          "id": "a-weekend-in-telemark-block-10",
          "turn_index": 9,
          "speaker_icon_url": "https://api.dicebear.com/10.x/open-peeps/svg?seed=2743e010a7805edd604b6461d07aa32e00ebb2abbe5788262aff85fbb331913d"
        },
        {
          "kind": "reading",
          "spans": [
            {
              "kind": "text",
              "value": "Husk bare at man ikke må gå med sko inne i hytta. Det er en husregel hos oss."
            }
          ],
          "translation": "Just remember that you mustn't wear shoes inside the cabin. That's a house rule of ours.",
          "speaker_id": "thomas",
          "speaker_name": "Thomas",
          "dialogue_id": "office",
          "id": "a-weekend-in-telemark-block-11",
          "turn_index": 10,
          "speaker_icon_url": "https://api.dicebear.com/10.x/open-peeps/svg?seed=4ed22d9e7946487c17bf636864548b6220b4ca6a1b460b9c99a07535f5103c44"
        },
        {
          "kind": "reading",
          "spans": [
            {
              "kind": "text",
              "value": "Godt å vite! Hva med mat — hva skal jeg ta med?"
            }
          ],
          "translation": "Good to know! What about food — what am I supposed to bring?",
          "speaker_id": "ingrid",
          "speaker_name": "Ingrid",
          "dialogue_id": "office",
          "id": "a-weekend-in-telemark-block-12",
          "turn_index": 11,
          "speaker_icon_url": "https://api.dicebear.com/10.x/open-peeps/svg?seed=2743e010a7805edd604b6461d07aa32e00ebb2abbe5788262aff85fbb331913d"
        },
        {
          "kind": "reading",
          "spans": [
            {
              "kind": "text",
              "value": "Ta med det du vil ha. Men det vil sikkert bli kaldt der oppe om natten, så pakk noe varmt."
            }
          ],
          "translation": "Bring whatever you want. But it will surely get cold up there at night, so pack something warm.",
          "speaker_id": "thomas",
          "speaker_name": "Thomas",
          "dialogue_id": "office",
          "id": "a-weekend-in-telemark-block-13",
          "turn_index": 12,
          "speaker_icon_url": "https://api.dicebear.com/10.x/open-peeps/svg?seed=4ed22d9e7946487c17bf636864548b6220b4ca6a1b460b9c99a07535f5103c44"
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "strong",
              "value": "What is happening"
            }
          ],
          "id": "a-weekend-in-telemark-block-14"
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Thomas is going to his family's cabin and invites Ingrid. The catch: they leave at ten on Friday, so Ingrid has to take the day off — which she can, since she has holiday days to spare. She drives, they split the petrol, and Thomas passes on some practical advice about boots, a house rule about shoes, and a warning about cold nights. Notice how much of this negotiation runs through five tiny verbs: "
            },
            {
              "kind": "emphasis",
              "value": "må, kan, skal, vil, bør"
            },
            {
              "kind": "text",
              "value": "."
            }
          ],
          "id": "a-weekend-in-telemark-block-15"
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "strong",
              "value": "Useful expressions to take with you"
            }
          ],
          "id": "a-weekend-in-telemark-block-16"
        },
        {
          "kind": "examples",
          "items": [
            {
              "id": "a-weekend-in-telemark-block-17-item-1",
              "no": [
                {
                  "kind": "text",
                  "value": "Det skal gå greit."
                }
              ],
              "en": [
                {
                  "kind": "text",
                  "value": "It will be fine. (said to reassure someone)"
                }
              ]
            },
            {
              "id": "a-weekend-in-telemark-block-17-item-2",
              "no": [
                {
                  "kind": "text",
                  "value": "Det vil jeg gjerne!"
                }
              ],
              "en": [
                {
                  "kind": "text",
                  "value": "I'd really like to!"
                }
              ]
            },
            {
              "id": "a-weekend-in-telemark-block-17-item-3",
              "no": [
                {
                  "kind": "text",
                  "value": "Godt å vite!"
                }
              ],
              "en": [
                {
                  "kind": "text",
                  "value": "Good to know!"
                }
              ]
            },
            {
              "id": "a-weekend-in-telemark-block-17-item-4",
              "no": [
                {
                  "kind": "text",
                  "value": "å ta seg fri"
                }
              ],
              "en": [
                {
                  "kind": "text",
                  "value": "to take time off work"
                }
              ]
            },
            {
              "id": "a-weekend-in-telemark-block-17-item-5",
              "no": [
                {
                  "kind": "text",
                  "value": "feriedager til gode"
                }
              ],
              "en": [
                {
                  "kind": "text",
                  "value": "holiday days still left to take"
                }
              ]
            },
            {
              "id": "a-weekend-in-telemark-block-17-item-6",
              "no": [
                {
                  "kind": "text",
                  "value": "husregel"
                }
              ],
              "en": [
                {
                  "kind": "text",
                  "value": "house rule"
                }
              ]
            }
          ],
          "id": "a-weekend-in-telemark-block-17"
        }
      ]
    },
    {
      "kind": "section",
      "id": "earlier-modal-foundation",
      "role": "recap",
      "title": "What you bring from earlier modal lessons",
      "objective_ids": [
        "obj-modal-verbs-in-context-01"
      ],
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "This B2 lesson assumes that you can already use a modal directly before a bare infinitive and recognize the everyday action meanings:"
            }
          ],
          "id": "earlier-modal-foundation-block-1"
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "emphasis",
                "value": "må"
              },
              {
                "kind": "text",
                "value": " — necessity or prohibition with "
              },
              {
                "kind": "emphasis",
                "value": "ikke"
              }
            ],
            [
              {
                "kind": "emphasis",
                "value": "kan"
              },
              {
                "kind": "text",
                "value": " — ability, possibility, or permission"
              }
            ],
            [
              {
                "kind": "emphasis",
                "value": "skal"
              },
              {
                "kind": "text",
                "value": " — a plan, arrangement, promise, or assigned action"
              }
            ],
            [
              {
                "kind": "emphasis",
                "value": "vil"
              },
              {
                "kind": "text",
                "value": " — a wish or prediction"
              }
            ],
            [
              {
                "kind": "emphasis",
                "value": "bør"
              },
              {
                "kind": "text",
                "value": " — advice"
              }
            ]
          ],
          "id": "earlier-modal-foundation-block-2"
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "You have also compared future "
            },
            {
              "kind": "emphasis",
              "value": "skal/vil"
            },
            {
              "kind": "text",
              "value": " and past or hypothetical "
            },
            {
              "kind": "emphasis",
              "value": "skulle/ville"
            },
            {
              "kind": "text",
              "value": ". Here the task changes: the same present-tense forms can frame a claim rather than direct an action. The surrounding evidence, source, and expectation—not the modal by itself—tell you which reading is active."
            }
          ],
          "id": "earlier-modal-foundation-block-3"
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "You may hear "
            },
            {
              "kind": "emphasis",
              "value": "burde"
            },
            {
              "kind": "text",
              "value": " in present advice as well as in past, hypothetical, or counterfactual contexts. Those distinctions are outside this lesson; do not treat "
            },
            {
              "kind": "emphasis",
              "value": "burde"
            },
            {
              "kind": "text",
              "value": " as an automatically softer version of "
            },
            {
              "kind": "emphasis",
              "value": "bør"
            },
            {
              "kind": "text",
              "value": ". This lesson uses "
            },
            {
              "kind": "emphasis",
              "value": "bør"
            },
            {
              "kind": "text",
              "value": " so that the contrast with expectation stays clear."
            }
          ],
          "id": "earlier-modal-foundation-block-4"
        }
      ]
    },
    {
      "kind": "section",
      "id": "when-the-modal-evaluates-evidence",
      "role": "contrast",
      "title": "When the modal evaluates the evidence",
      "objective_ids": [
        "obj-modal-verbs-in-context-01"
      ],
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The core meanings above concern an action: someone has to act, plans to act, or is advised to act. In other contexts, "
            },
            {
              "kind": "emphasis",
              "value": "må"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "emphasis",
              "value": "skal"
            },
            {
              "kind": "text",
              "value": ", and "
            },
            {
              "kind": "emphasis",
              "value": "bør"
            },
            {
              "kind": "text",
              "value": " can instead show how the speaker reaches or presents a claim."
            }
          ],
          "id": "when-the-modal-evaluates-evidence-block-1"
        },
        {
          "kind": "examples",
          "items": [
            {
              "id": "when-the-modal-evaluates-evidence-block-2-item-1",
              "no": [
                {
                  "kind": "text",
                  "value": "Kari må være hjemme; lyset er på."
                }
              ],
              "en": [
                {
                  "kind": "text",
                  "value": "Kari must be at home; the light is on. (my inference from evidence)"
                }
              ]
            },
            {
              "id": "when-the-modal-evaluates-evidence-block-2-item-2",
              "no": [
                {
                  "kind": "text",
                  "value": "Den nye restauranten skal være veldig god, ifølge anmeldelsene."
                }
              ],
              "en": [
                {
                  "kind": "text",
                  "value": "The new restaurant is said to be very good, according to the reviews. (reported information)"
                }
              ]
            },
            {
              "id": "when-the-modal-evaluates-evidence-block-2-item-3",
              "no": [
                {
                  "kind": "text",
                  "value": "Toget bør være her om fem minutter hvis rutetabellen holder."
                }
              ],
              "en": [
                {
                  "kind": "text",
                  "value": "The train should be here in five minutes if the timetable holds. (a reasonable expectation)"
                }
              ]
            }
          ],
          "id": "when-the-modal-evaluates-evidence-block-2"
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Compare each one with its action meaning:"
            }
          ],
          "id": "when-the-modal-evaluates-evidence-block-3"
        },
        {
          "kind": "examples",
          "items": [
            {
              "id": "when-the-modal-evaluates-evidence-block-4-item-1",
              "no": [
                {
                  "kind": "text",
                  "value": "Kari må være hjemme før elleve."
                }
              ],
              "en": [
                {
                  "kind": "text",
                  "value": "Kari has to be home before eleven. (a requirement)"
                }
              ]
            },
            {
              "id": "when-the-modal-evaluates-evidence-block-4-item-2",
              "no": [
                {
                  "kind": "text",
                  "value": "Vi skal spise på den nye restauranten på fredag."
                }
              ],
              "en": [
                {
                  "kind": "text",
                  "value": "We are eating at the new restaurant on Friday. (a plan)"
                }
              ]
            },
            {
              "id": "when-the-modal-evaluates-evidence-block-4-item-3",
              "no": [
                {
                  "kind": "text",
                  "value": "Du bør sjekke rutetabellen."
                }
              ],
              "en": [
                {
                  "kind": "text",
                  "value": "You should check the timetable. (advice)"
                }
              ]
            }
          ],
          "id": "when-the-modal-evaluates-evidence-block-4"
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The modal alone does not decide the reading. Look for the subject's control over an action, an explicit source such as "
            },
            {
              "kind": "emphasis",
              "value": "ifølge"
            },
            {
              "kind": "text",
              "value": ", and evidence or normal expectations in the surrounding sentence. These are contextual tendencies, not mechanical translation rules."
            }
          ],
          "id": "when-the-modal-evaluates-evidence-block-5"
        }
      ]
    },
    {
      "kind": "section",
      "id": "sunday-evening",
      "role": "model",
      "title": "Sunday evening",
      "objective_ids": [
        "obj-modal-verbs-in-context-01"
      ],
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The trip is over. The same two people, now tired and happy, exchange messages — and the five verbs come along, doing new jobs."
            }
          ],
          "id": "sunday-evening-block-1"
        },
        {
          "kind": "reading",
          "spans": [
            {
              "kind": "text",
              "value": "Hjemme igjen. Hvordan går det med beina?"
            }
          ],
          "translation": "Home again. How are your legs doing?",
          "speaker_id": "thomas",
          "speaker_name": "Thomas",
          "dialogue_id": "sunday",
          "id": "sunday-evening-block-2",
          "turn_index": 1,
          "speaker_icon_url": "https://api.dicebear.com/10.x/open-peeps/svg?seed=4ed22d9e7946487c17bf636864548b6220b4ca6a1b460b9c99a07535f5103c44"
        },
        {
          "kind": "reading",
          "spans": [
            {
              "kind": "text",
              "value": "Stive! Men jeg vil tilbake til hytta så fort jeg kan."
            }
          ],
          "translation": "Stiff! But I want to get back to the cabin as soon as I can.",
          "speaker_id": "ingrid",
          "speaker_name": "Ingrid",
          "dialogue_id": "sunday",
          "id": "sunday-evening-block-3",
          "turn_index": 2,
          "speaker_icon_url": "https://api.dicebear.com/10.x/open-peeps/svg?seed=2743e010a7805edd604b6461d07aa32e00ebb2abbe5788262aff85fbb331913d"
        },
        {
          "kind": "reading",
          "spans": [
            {
              "kind": "text",
              "value": "Naboen skal ha fyrt opp for oss hver fredag i vinter."
            }
          ],
          "translation": "The neighbour is said to have lit the stove for us every Friday this winter.",
          "speaker_id": "thomas",
          "speaker_name": "Thomas",
          "dialogue_id": "sunday",
