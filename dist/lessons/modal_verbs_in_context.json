      "objective_id": "obj-modal-verbs-in-context-01",
      "prompt": [
        {
          "kind": "text",
          "value": "Melding fra lageret: «Budbilen forlot terminalen klokka 09.15. Vanlig kjøretid er 45 minutter, men pakken har ikke kommet klokka 11.00.» Kunden trenger pakken før klokka 14.00. Nora kan ringe transportselskapet, og Amir møter kunden klokka 13.30. Skriv en dialog. Bruk må til en slutning om forsinkelsen, skal til å gjengi lagerets beskjed, bør til en forventning på vilkår og et modalverb til å foreslå neste steg."
        }
      ],
      "explanation": [
        {
          "kind": "text",
          "value": "Bruk må til slutningen, skal til opplysningen fra lageret, bør til forventningen og et modalverb om handling til neste steg."
        }
      ],
      "payload": {
        "response_language": "no",
        "min_words": 30,
        "max_words": 70,
        "judge_prompt": "Evaluate criteria dialogue-purpose, facts-supported, inference-from-clues, reported-information, conditional-expectation, action-modal, and natural-bokmal as gating criteria. Accept natural Bokmål variants that use the required modal readings accurately. Quote relevant evidence. Do not add requirements.",
        "criteria": [
          {
            "id": "dialogue-purpose",
            "instruction": "The response is a coherent workplace dialogue that interprets the delay and agrees on a next action."
          },
          {
            "id": "facts-supported",
            "instruction": "The dialogue does not contradict the warehouse message or supplied facts."
          },
          {
            "id": "natural-bokmal",
            "instruction": "The response is understandable, natural Bokmål."
          },
          {
            "id": "inference-from-clues",
            "instruction": "Uses må to draw a plausible inference from the delivery facts."
          },
          {
            "id": "reported-information",
            "instruction": "Uses skal to relay the warehouse's information as attributed to that source."
          },
          {
            "id": "conditional-expectation",
            "instruction": "Uses bør for an expectation tied to a condition, such as ordinary travel conditions."
          },
          {
            "id": "action-modal",
            "instruction": "Uses a modal with an action meaning to propose or agree on a next step."
          }
        ]
      }
    },
