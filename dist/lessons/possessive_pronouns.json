{
  "schema_version": "3.0",
  "key": "possessive_pronouns",
  "concept_slug": "possessive_pronouns",
  "grounding_mode": "fallback_no_wiki",
  "title": "Saying My, Your, and Our in Norwegian",
  "cefr_level": "A1",
  "goal": "Use basic Norwegian possessive pronouns with the noun they belong to.",
  "elements": [
    {
      "kind": "section",
      "role": "orient",
      "title": "The Basic Idea",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Possessive pronouns are words like my, your, his, her, and our. In Norwegian, some possessive pronouns change to match the owned noun, not the owner."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "The form of "
            },
            {
              "kind": "foreign_term",
              "value": "min",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " changes according to the owned noun: masculine, feminine, neuter, or plural."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Grammatical gender means masculine, feminine, or neuter. Number means singular or plural. These two things decide the possessive form."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "no"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Owned noun type"
              }
            ],
            [
              {
                "kind": "text",
                "value": "My"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Example"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "masculine singular"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "min"
                }
              ],
