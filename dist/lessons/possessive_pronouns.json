      "title": "My, Your, His, Her, Our",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The same agreement pattern works for your and our. His and her are fixed forms, so they do not change with the owned noun."
            }
          ]
        },
