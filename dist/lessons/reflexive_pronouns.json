{
  "schema_version": "3.0",
  "key": "reflexive_pronouns",
  "concept_slug": "reflexive_pronouns",
  "grounding_mode": "fallback_no_wiki",
  "title": "Reflexive Pronouns: meg, deg, seg, oss, dere",
  "cefr_level": "A2",
  "goal": "Choose the right reflexive pronoun when the object is the same person as the subject.",
  "elements": [
    {
      "kind": "section",
      "role": "orient",
      "title": "What Reflexive Means",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A reflexive pronoun is an object pronoun that points back to the subject. The subject is the person or thing doing the action. The object is the person or thing receiving the action."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use a reflexive pronoun when the subject and the object are the same person or group."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg ser meg i speilet."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I see myself in the mirror."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Du vasker deg."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "You wash yourself."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "English often uses forms like myself, yourself, and themselves. Norwegian uses a smaller set of object forms, and the third person form is especially important."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "model",
      "title": "The Forms",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Match the reflexive pronoun to the subject. First person means the speaker, second person means the listener, and third person means someone or something else being talked about."
            }
          ]
        },
        {
