          "level": "tip",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "The form "
                },
                {
                  "kind": "foreign_term",
                  "value": "seg",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " covers he, she, it, and they when the object points back to that same subject."
                }
              ]
            }
          ]
        },
        {
