        }
      ],
      "explanation": [
        {
          "kind": "text",
          "value": "Correct. "
        },
        {
          "kind": "foreign_term",
          "value": "kommer til å ha",
          "lang": "no"
        },
        {
          "kind": "text",
          "value": " fits a prediction, and "
        },
        {
          "kind": "foreign_term",
