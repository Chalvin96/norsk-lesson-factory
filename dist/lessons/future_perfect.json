        {
          "kind": "text",
          "value": "."
        }
      ],
      "payload": {
        "options": [
          {
            "option_id": "a",
            "text": "Neste sommer kommer de til å ha fullført prosjektet.",
            "why": "Correct. This expresses an expected completed result by a future time with an explicit future-perfect marker."
          },
          {
            "option_id": "b",
            "text": "Neste sommer kommer de til å fullføre prosjektet.",
            "why": "This is simple future: they will complete it then, not necessarily before then."
          },
          {
            "option_id": "c",
            "text": "Neste sommer har de fullført prosjektet.",
            "why": "This can express future completion with the time phrase neste sommer, but it does not use the explicit target marker kommer til å ha."
          }
        ],
        "answer_id": "a",
        "stem": [
          {
            "kind": "text",
            "value": "By next summer, they will probably have completed the project."
          }
        ]
      }
    },
