{
  "schema_version": "3.0",
  "key": "future_perfect",
  "concept_slug": "future_perfect",
  "grounding_mode": "fallback_no_wiki",
  "title": "Future Completion with ha and the Past Participle",
  "cefr_level": "B2",
  "goal": "Use skal ha, vil ha, and kommer til å ha to show that something is completed before a later point.",
  "elements": [
    {
      "kind": "section",
      "role": "orient",
      "title": "The Job of Future Perfect",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The future perfect is a future meaning that treats an action as completed before a later time. In Norwegian, you usually make it with a future marker, then "
            },
            {
              "kind": "foreign_term",
              "value": "ha",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", then the past participle, which is the verb form used after "
            },
            {
              "kind": "foreign_term",
              "value": "ha",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", such as "
            },
            {
              "kind": "foreign_term",
              "value": "gjort",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "lest",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", or "
            },
            {
              "kind": "foreign_term",
              "value": "sendt",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Future perfect means: by a future point, the action is already complete."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Innen fredag skal jeg ha sendt rapporten."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "By Friday, I will have sent the report."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Når du kommer, vil hun ha laget middag."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "When you arrive, she will have made dinner."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The later point can be a time expression like "
            },
            {
              "kind": "foreign_term",
              "value": "innen fredag",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " or a clause like "
            },
            {
              "kind": "foreign_term",
              "value": "når du kommer",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". The completed action is the part with "
            },
            {
              "kind": "foreign_term",
              "value": "ha",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus the past participle."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "model",
      "title": "The Form You Need",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The finite verb comes in normal second position in a main clause. The rest of the future perfect stays together later in the verb phrase: future marker plus "
            },
            {
              "kind": "foreign_term",
              "value": "ha",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus past participle."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "no"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Use"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Pattern"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Example"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "Plan or arranged result"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "skal ha gjort"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "I morgen skal vi ha ryddet hele lageret."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "Expected completed result"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "kommer til å ha gjort"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Om et år kommer de til å ha flyttet til Bergen."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "Prediction or inference"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "vil ha gjort"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Hun vil ha forstått poenget før møtet er over."
                }
              ]
            ]
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Do not drop "
            },
            {
              "kind": "foreign_term",
              "value": "ha",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ": "
            },
            {
              "kind": "foreign_term",
              "value": "skal ha sendt",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is complete, but "
            },
            {
              "kind": "foreign_term",
              "value": "skal sendt",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is not grammatical."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Før kurset starter kommer alle deltakerne til å ha fått en e-post."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Before the course starts, all participants will have received an email."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "warning",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "In a main clause with a fronted time expression, keep the finite verb in second position: "
                },
                {
                  "kind": "foreign_term",
                  "value": "Før kurset starter kommer alle deltakerne til å ha fått en e-post",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ". Here the fronted time clause is first, "
                },
                {
                  "kind": "foreign_term",
                  "value": "kommer",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " is the finite verb in second position, the subject "
                },
                {
                  "kind": "foreign_term",
                  "value": "alle deltakerne",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " follows it, and the rest of the verb phrase is "
                },
                {
                  "kind": "foreign_term",
                  "value": "til å ha fått",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": "."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "contrast",
      "title": "Plan, Expectation, or Inference",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian can use several future markers before "
            },
            {
              "kind": "foreign_term",
              "value": "ha",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". The choice changes the flavor: arranged completion, expected completion, or a speaker's inference. The structure stays the same."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Klokka seks skal vi ha avsluttet intervjuene."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "By six o'clock, we will have finished the interviews."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Klokka seks kommer vi til å ha avsluttet intervjuene."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "By six o'clock, we are going to have finished the interviews."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Han svarer ikke; han vil ha lagt seg allerede."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "He is not answering; he will have gone to bed already."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "foreign_term",
                "value": "skal ha",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " often presents a planned or required completed state."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "kommer til å ha",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " often presents a prediction based on how things are developing."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "vil ha",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " can present either future completion or an inference about what is probably already true."
              }
            ]
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "contrast",
      "title": "Not Just Future, Not Conditional Perfect",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Future perfect is different from simple future because it looks back from a later point. Simple future says that something will happen; future perfect says it will already be finished by then."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg skal lese rapporten i morgen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I will read the report tomorrow."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg skal ha lest rapporten før møtet."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I will have read the report before the meeting."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Do not confuse this with conditional perfect, a form used for unreal past situations, such as English would have done. That pattern uses modal simple past forms like "
            },
            {
              "kind": "foreign_term",
              "value": "ville ha gjort",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". Future perfect uses future-oriented forms like "
            },
            {
              "kind": "foreign_term",
              "value": "skal ha gjort",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "vil ha gjort",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", or "
            },
            {
              "kind": "foreign_term",
              "value": "kommer til å ha gjort",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "After "
            },
            {
              "kind": "foreign_term",
              "value": "ha",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", use the past participle, not an infinitive, which is the base form with "
            },
            {
              "kind": "foreign_term",
              "value": "å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        }
      ]
    },
