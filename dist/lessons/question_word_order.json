{
  "schema_version": "3.0",
  "key": "question_word_order",
  "concept_slug": "question_word_order",
  "grounding_mode": "fallback_no_wiki",
  "title": "Putting the verb first in Norwegian questions",
  "cefr_level": "A1",
  "goal": "Ask and recognize simple Norwegian yes/no, negative, wh-, and permission questions.",
  "elements": [
    {
      "kind": "section",
      "role": "orient",
      "title": "The question shape",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "In Norwegian yes/no questions, the verb comes first. Put the subject right after it."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Yes/no question order: verb + subject + the rest."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Snakker du norsk?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Do you speak Norwegian?"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Bor hun her?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Does she live here?"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Har de kaffe?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Do they have coffee?"
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "en"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Sentence type"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Order"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Meaning"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "Statement"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Du snakker norsk."
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "You speak Norwegian."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "Question"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Snakker du norsk?"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Do you speak Norwegian?"
                }
              ]
            ]
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "model",
      "title": "Negative yes/no questions",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A negative yes/no question still begins with the verb. With a simple pronoun subject like "
            },
            {
              "kind": "foreign_term",
              "value": "du",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " or "
            },
            {
              "kind": "foreign_term",
              "value": "jeg",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " usually comes after the subject in this question pattern."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Negative yes/no question order: verb + subject + "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " + the rest."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Har du ikke kaffe?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Don’t you have coffee?"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Er han ikke hjemme?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Isn’t he at home?"
            }
          ]
        },
        {
          "kind": "callout",
          "level": "note",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Here you only need the question order. The fuller use of "
                },
                {
                  "kind": "foreign_term",
                  "value": "ikke",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " in ordinary statements can wait until you study negation directly."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "contrast",
      "title": "Question words",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A wh-question asks for information. In Norwegian, common question words include "
            },
            {
              "kind": "foreign_term",
              "value": "hva",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "hvem",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "hvor",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and "
            },
            {
              "kind": "foreign_term",
              "value": "hvordan",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". Put the question word first, then the finite verb, then the subject."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Wh-question order: question word + finite verb + subject + the rest."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hva gjør du?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "What are you doing?"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hvor bor du?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Where do you live?"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hvordan går det?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "How is it going?"
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "There is one important simple pattern: when the question word itself is the subject, do not add another subject after the verb."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "If "
            },
            {
              "kind": "foreign_term",
              "value": "hvem",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " means who as the subject, use question word + verb."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hvem kommer?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Who is coming?"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hvem bor her?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Who lives here?"
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "model",
      "title": "Permission with får",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "får",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " at the start of a question to ask whether something is allowed. The useful everyday pattern is "
            },
            {
              "kind": "foreign_term",
              "value": "får jeg",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ": may I or can I."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Permission question order: "
            },
            {
              "kind": "foreign_term",
              "value": "får",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " + subject + infinitive, the base verb form."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Får jeg sitte her?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "May I sit here?"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Får vi komme inn?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "May we come in?"
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "recap",
      "title": "Question order recap",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "To check a Norwegian question, look for the first two positions. A yes/no question starts with the finite verb. A wh-question starts with the question word, then the finite verb. A permission question with "
            },
            {
              "kind": "foreign_term",
              "value": "får",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " starts with "
            },
            {
              "kind": "foreign_term",
              "value": "får",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " and then the subject."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "text",
                "value": "Yes/no: "
              },
              {
                "kind": "foreign_term",
                "value": "Snakker du norsk?",
                "lang": "no"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Negative yes/no: "
              },
              {
                "kind": "foreign_term",
                "value": "Har du ikke kaffe?",
                "lang": "no"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Wh-question with subject after the verb: "
              },
              {
                "kind": "foreign_term",
                "value": "Hva gjør du?",
                "lang": "no"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Wh-subject question with no extra subject: "
              },
              {
                "kind": "foreign_term",
                "value": "Hvem kommer?",
                "lang": "no"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Permission: "
              },
              {
                "kind": "foreign_term",
                "value": "Får jeg sitte her?",
                "lang": "no"
              }
            ]
          ]
        }
      ]
    },
