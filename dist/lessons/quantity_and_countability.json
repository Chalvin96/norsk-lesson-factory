            ],
            [
              {
                "kind": "text",
                "value": "Norwegian form"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Pattern"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "All of a masculine or feminine singular noun"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "all"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "before a definite noun"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "All of a neuter singular noun, or everything"
                }
              ],
              [
                {
