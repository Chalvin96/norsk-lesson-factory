{
  "schema_version": "3.0",
  "key": "quantity_and_countability",
  "concept_slug": "quantity_and_countability",
  "grounding_mode": "fallback_no_wiki",
  "title": "Quantity Words for Countable and Uncountable Things",
  "cefr_level": "A2",
  "goal": "Choose common Norwegian quantity words for countable things, amounts, all, whole, and both.",
  "elements": [
    {
      "kind": "section",
      "role": "orient",
      "title": "Countable or Amount",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian quantity words often depend on countability. A countable noun is a noun you can count as one, two, three separate items. An uncountable noun is a noun you usually treat as an amount, such as water, time, money, or coffee."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "mange",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " with countable plural nouns, and "
            },
            {
              "kind": "foreign_term",
              "value": "mye",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " with uncountable amounts."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg har mange bøker."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I have many books."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi drikker mye kaffe."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We drink a lot of coffee."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The same countability idea helps with "
            },
            {
              "kind": "foreign_term",
              "value": "noen",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " and "
            },
            {
              "kind": "foreign_term",
              "value": "noe",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". Use "
            },
            {
              "kind": "foreign_term",
              "value": "noen",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for countable plural nouns and "
            },
            {
              "kind": "foreign_term",
              "value": "noe",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for uncountable amounts or a general thing."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Har du noen epler?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Do you have any apples?"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vil du ha noe vann?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Do you want some water?"
            }
          ]
        }
      ]
    },
