    {
      "kind": "section",
      "role": "model",
      "title": "All and Whole",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian separates all of something from a whole unit. A noun phrase is a noun together with its small grammar words, such as a determiner. A determiner is a word placed before a noun to point to amount or identity, like English all or the."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "en"
          ],
          "headers": [
