              "value": "begge",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for both of two people or things. Use "
            },
            {
              "kind": "foreign_term",
              "value": "både ... og",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for both X and Y."
            }
