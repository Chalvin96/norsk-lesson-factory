    {
      "kind": "section",
      "role": "contrast",
      "title": "A Little or Too Little",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "For small amounts, Norwegian makes a useful tone contrast. Tone means the attitude the sentence suggests: enough for the situation, or not enough."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "litt",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for a small amount with a neutral or positive tone. Use "
            },
            {
              "kind": "foreign_term",
              "value": "lite",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when the amount feels insufficient."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg har litt penger."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I have a little money."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg har lite penger."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I have little money."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Kan jeg få litt hjelp?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Can I get a little help?"
            }
          ]
        }
      ]
    },
