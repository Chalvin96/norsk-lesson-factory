        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Dette er andre kapittel."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "This is the second chapter."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Les den tredje setningen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Read the third sentence."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "contrast",
      "title": "Where they appear",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Ordinal numbers often sit before a noun, the word for a person, place, or thing. For a specific noun, Norwegian often uses "
            },
            {
              "kind": "foreign_term",
              "value": "den",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " or "
            },
            {
              "kind": "foreign_term",
              "value": "det",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " before the ordinal."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det andre rommet er stort."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The second room is large."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Den første bussen går nå."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The first bus leaves now."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "In rankings, Norwegian commonly uses "
            },
            {
              "kind": "foreign_term",
              "value": "på",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " before the position."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Han kom på tiende plass."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "He came in tenth place."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "contrast",
      "title": "Order, not amount",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Cardinal numbers count quantity: one, two, three. Ordinal numbers show order: first, second, third. Ask yourself whether the sentence answers how many or which place in an order."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg har tre bøker."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I have three books."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg leser den tredje boka."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I am reading the third book."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use a cardinal number for amount; use an ordinal number for place in an order."
            }
          ]
        }
      ]
    },
