{
  "schema_version": "3.0",
  "key": "ordinal_numbers",
  "concept_slug": "ordinal_numbers",
  "grounding_mode": "fallback_no_wiki",
  "title": "Ordering Things with Første, Andre, and More",
  "cefr_level": "A1",
  "goal": "Use common Norwegian ordinal numbers to show order, rank, and position.",
  "elements": [
    {
      "kind": "section",
      "role": "orient",
      "title": "What ordinal numbers do",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "An ordinal number shows order or rank: first, second, third. Use ordinals for places in a line, floors in a building, and items in a list."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use ordinal numbers for position or rank, not for how many things there are."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun er den første i køen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She is first in the line."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi bor i fjerde etasje."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We live on the fourth floor."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "model",
      "title": "Core forms",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The first few ordinal forms are very common and must be learned as whole words. After that, you will often see endings like "
            },
            {
              "kind": "foreign_term",
              "value": "-ende",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", as in "
            },
            {
              "kind": "foreign_term",
              "value": "tiende",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "en"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Order"
              }
