              "kind": "foreign_term",
              "value": "tiende",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "If the meaning is how many, use a cardinal number. If the meaning is which position, use an ordinal number."
            }
          ]
        }
      ]
