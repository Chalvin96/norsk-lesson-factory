      "explanation": [
        {
          "kind": "text",
          "value": "For floor order, Norwegian uses the ordinal form."
        }
      ],
      "payload": {
        "options": [
          {
            "option_id": "a",
            "text": "Vi bor i fire etasje.",
            "why": "This uses a counting number, not an ordinal."
          },
          {
            "option_id": "b",
            "text": "Vi bor i fjerde etasje.",
            "why": "This uses the ordinal for fourth."
          },
          {
            "option_id": "c",
            "text": "Vi bor i første etasje.",
            "why": "This means first floor, not fourth floor."
          }
        ],
        "answer_id": "b",
        "stem": [
          {
            "kind": "text",
            "value": "Which sentence means We live on the fourth floor?"
          }
