              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "tredje",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and "
            },
            {
              "kind": "foreign_term",
              "value": "fjerde",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". You also saw the common later pattern in "
