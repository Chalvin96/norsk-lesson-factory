                }
              ]
            ]
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Møtet skal begynne klokka ni."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The meeting is scheduled to start at nine."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Han skal ha sagt ja til forslaget."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "He is said to have agreed to the proposal."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg vil snakke med deg etterpå."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I want to talk with you afterwards."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun vil nok ikke rekke toget."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She probably won't make the train."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Du bør lese kontrakten nøye."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "You should read the contract carefully."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Pakken bør komme før helgen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The package should arrive before the weekend."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "model",
      "title": "Small Words That Move the Stance",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian often uses short stance particles, small words that show how the speaker relates to the statement. They are easy to overtranslate, so listen for their function rather than for one fixed English word."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "no",
            "en",
            "no"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Particle"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Typical force"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Example"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "jo"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "the speaker treats the point as known, obvious, or already shared"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Du vet jo hvor nøkkelen ligger."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "vel"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "soft assumption, often inviting confirmation"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Du kommer vel på fredag?"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "nok"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "probability or expectation, often stronger than a casual maybe"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Det går nok bra."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "da"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "limited emphasis, reaction, or mild correction"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Kom da, så rekker vi toget."
                }
              ]
            ]
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "foreign_term",
              "value": "jo",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " strengthens shared knowledge, "
            },
            {
              "kind": "foreign_term",
              "value": "vel",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " softens toward confirmation, "
            },
            {
              "kind": "foreign_term",
              "value": "nok",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " marks probability, and "
            },
            {
              "kind": "foreign_term",
              "value": "da",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " adds limited emphasis or reaction."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun er jo lege, så hun kjenner systemet."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She is a doctor, after all, so she knows the system."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Dette blir nok dyrere enn vi trodde."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "This will probably be more expensive than we thought."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Du har vel sendt søknaden?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "You have sent the application, right?"
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "contrast",
      "title": "Do Not Stack Every Signal",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Because these words are subtle, learners sometimes put several in the same sentence. Native Norwegian can combine them, but too much stacking makes your sentence sound uncertain, pushy, or cluttered. Pick the one signal that matches your intended stance."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det går nok bra."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "It will probably be fine."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det går vel nok bra da."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "It'll probably turn out okay, I guess, you know, then."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "warning",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "In careful writing, keep stance particles sparse. Use them when they add a clear meaning, not just to make the sentence sound Norwegian."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "recap",
      "title": "Quick Choice Guide",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "When you meet a modal or particle, first ask what job it is doing. Is it controlling an action, evaluating likelihood, reporting an expectation, or managing what the listener already knows?"
            }
          ]
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "text",
                "value": "Use "
              },
              {
                "kind": "foreign_term",
                "value": "må",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " for obligation or strong inference."
              }
            ],
            [
              {
                "kind": "text",
                "value": "Use "
              },
              {
                "kind": "foreign_term",
                "value": "kan",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " for permission, ability, or possibility."
              }
            ],
            [
              {
                "kind": "text",
                "value": "Use "
              },
              {
                "kind": "foreign_term",
                "value": "skal",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " for plans, rules, promises, or reported expectation."
              }
            ],
            [
              {
                "kind": "text",
                "value": "Use "
              },
              {
                "kind": "foreign_term",
                "value": "vil",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " for wanting, willingness, or a prediction."
              }
            ],
            [
              {
                "kind": "text",
                "value": "Use "
              },
              {
                "kind": "foreign_term",
                "value": "bør",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " for advice or a reasonable expectation."
              }
            ],
            [
              {
                "kind": "text",
                "value": "Use one particle when one is enough: "
              },
              {
                "kind": "foreign_term",
                "value": "jo",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "kind": "foreign_term",
                "value": "vel",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "kind": "foreign_term",
                "value": "nok",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": ", or "
              },
              {
                "kind": "foreign_term",
                "value": "da",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": "."
              }
            ]
          ]
        }
      ]
    },
