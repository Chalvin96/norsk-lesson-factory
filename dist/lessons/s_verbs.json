            {
              "kind": "foreign_term",
              "value": "å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", also ends in "
            },
            {
              "kind": "foreign_term",
              "value": "s",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
