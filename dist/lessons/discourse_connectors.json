    {
      "kind": "section",
      "role": "recap",
      "title": "Quick Recap",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Use connectors to show the reader how your ideas fit together, then check the word order if the connector starts a main clause."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "foreign_term",
                "value": "Først",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " starts a sequence."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "Dessuten",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " adds another point."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "Likevel",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " shows something happens despite expectation."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "Derimot",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " contrasts two people, things, or situations."
