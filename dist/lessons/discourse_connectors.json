    {
      "kind": "exercise",
      "id": "ex_choose_connector",
      "operation": "choose",
      "prompt": [
        {
          "kind": "text",
          "value": "Choose the connector that best fits the meaning."
        }
      ],
      "explanation": [
        {
          "kind": "foreign_term",
          "value": "Likevel",
          "lang": "no"
        },
        {
          "kind": "text",
          "value": " fits because the second sentence happens despite the rain."
        }
      ],
      "payload": {
        "options": [
          {
            "option_id": "a",
            "text": "Først",
            "why": "This starts a sequence, but the meaning here is contrast."
          },
          {
            "option_id": "b",
            "text": "Likevel",
            "why": "This shows that the walk happened despite the rain."
          },
          {
            "option_id": "c",
            "text": "Dessuten",
            "why": "This adds information, but it does not show the surprising result."
          }
        ],
        "answer_id": "b",
        "stem": [
          {
            "kind": "foreign_term",
            "value": "Det regnet hele dagen. … gikk vi til parken.",
            "lang": "no"
          }
        ]
      }
    },
