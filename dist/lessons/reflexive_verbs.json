  "grounding_mode": "fallback_no_wiki",
  "title": "Using Norwegian Reflexive Verbs",
  "cefr_level": "A2",
  "goal": "Use common reflexive verbs with the pronoun that matches the subject.",
  "elements": [
    {
      "kind": "section",
      "role": "orient",
      "title": "What a Reflexive Verb Is",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A reflexive verb is used with a pronoun that points back to the subject. In English, you may say yourself or herself, but Norwegian uses this pattern much more often with everyday verbs."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "With a reflexive verb, the subject does the action in a way that points back to the same person or people."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg gleder meg til helgen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I am looking forward to the weekend."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi koser oss hjemme."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We are enjoying ourselves at home."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Dictionary lists often show these verbs with "
            },
            {
              "kind": "foreign_term",
              "value": "seg",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", because "
            },
            {
              "kind": "foreign_term",
              "value": "seg",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is the third person reflexive form. In a real sentence, the pronoun usually changes to match the subject."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "foreign_term",
                "value": "glede seg",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " means to look forward to something."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "skynde seg",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " means to hurry."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "kose seg",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " means to have a nice time or enjoy oneself."
