    {
      "kind": "section",
      "role": "recap",
      "title": "What to remember",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "In statements and wh-questions, keep the verb in position 2. If something other than the subject starts a statement, put the subject after the verb. In yes/no questions, start with the verb. Sentence adverbs such as ikke, aldri, ofte, and kanskje belong in the middle field."
            }
          ]
        }
      ]
