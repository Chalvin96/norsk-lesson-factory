    {
      "kind": "exercise",
      "id": "ex-choose-v2",
      "operation": "choose",
      "prompt": [
        {
          "kind": "text",
          "value": "Choose the sentence with correct word order."
        }
      ],
      "explanation": [
        {
          "kind": "text",
          "value": "After a fronted time phrase, the verb comes before the subject: Nå leser Maria."
        }
      ],
      "payload": {
        "options": [
          {
            "option_id": "o0",
            "text": "Nå Maria leser.",
            "why": "Nå is first, so the verb must come next."
          },
          {
            "option_id": "o1",
            "text": "Nå leser Maria.",
            "why": "The verb leser is in position 2."
          },
          {
            "option_id": "o2",
            "text": "Leser nå Maria.",
            "why": "A statement can't begin with the finite verb; Nå should be first, then the verb."
          },
          {
            "option_id": "o3",
            "text": "Maria nå leser.",
            "why": "The verb is too late for a main clause."
          }
        ],
        "answer_id": "o1",
        "stem": [
          {
            "kind": "text",
            "value": "Which sentence has correct V2 word order?"
          }
        ]
      }
    },
