{
  "schema_version": "3.0",
  "key": "word_order_main_clauses",
  "concept_slug": "word_order_main_clauses",
  "grounding_mode": "fallback_no_wiki",
  "title": "Word Order in Main Clauses",
  "cefr_level": "A1",
  "goal": "Make simple Norwegian main clauses with the verb in second position, including subject-first statements, fronted phrases, yes/no questions, wh-questions, and common sentence-adverb placement.",
  "elements": [
    {
      "kind": "section",
      "role": "orient",
      "title": "The main idea: verb second",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "In a Norwegian "
            },
            {
              "kind": "foreign_term",
              "value": "helsetning",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " (main clause: a complete sentence), the finite verb normally comes in position 2. This is often called "
            },
            {
              "kind": "foreign_term",
              "value": "V2",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " — verb second."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg bor i Oslo."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I live in Oslo."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Position 1 can be one word: in "
            },
            {
              "kind": "foreign_term",
              "value": "Jeg bor i Oslo",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "Jeg",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " fills position 1 and "
            },
            {
              "kind": "foreign_term",
              "value": "bor",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is in position 2. Position 1 can also be a whole phrase: in "
            },
            {
              "kind": "foreign_term",
              "value": "I dag drikker jeg te",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", the phrase "
            },
            {
              "kind": "foreign_term",
              "value": "I dag",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " fills position 1, so "
            },
            {
              "kind": "foreign_term",
              "value": "drikker",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is still in position 2."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "model",
      "title": "Subject first: the simple pattern",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "When the subject starts the sentence, the order is subject + verb + rest."
            }
