{
  "schema_version": "3.0",
  "key": "embedded_questions",
  "concept_slug": "embedded_questions",
  "grounding_mode": "fallback_no_wiki",
  "title": "Questions Inside Sentences",
  "cefr_level": "B1",
  "goal": "Use embedded questions with Norwegian subordinate-clause word order.",
  "elements": [
    {
      "kind": "section",
      "role": "orient",
      "title": "What an embedded question is",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "An embedded question is a question placed inside another sentence, often after phrases like I know, I wonder, can you tell me, or she asks. In Norwegian, the embedded question does not use normal question order."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "In an embedded question, do not use direct question inversion. Put the subject before the verb."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hvor bor han?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Where does he live?"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg vet hvor han bor."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I know where he lives."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The direct question has the verb before the subject: "
            },
            {
              "kind": "foreign_term",
              "value": "bor han",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". The embedded question has the subject before the verb: "
            },
            {
              "kind": "foreign_term",
              "value": "han bor",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "model",
      "title": "Embedded wh-questions",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "With question words such as what, where, who, when, and why, Norwegian keeps the question word at the start of the embedded question. The change is inside the clause: the subject comes before the verb."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "no",
            "no",
            "en"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Direct question"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Embedded question"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Meaning"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "Hva betyr det?"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Jeg vet hva det betyr."
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "I know what it means."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "Hvor ligger apoteket?"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Kan du si meg hvor apoteket ligger?"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Can you tell me where the pharmacy is?"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "Når begynner møtet?"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Hun spør når møtet begynner."
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "She asks when the meeting starts."
                }
              ]
            ]
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "After a wh-word in an embedded question, use normal subordinate-clause order: wh-word plus subject plus finite verb."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg lurer på hvorfor hun reiser så tidlig."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I wonder why she is leaving so early."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "contrast",
      "title": "Yes or no: use om",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "When the embedded question can be answered yes or no, Norwegian normally uses "
            },
            {
              "kind": "foreign_term",
              "value": "om",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". This is different from reported statements, which use "
            },
            {
              "kind": "foreign_term",
              "value": "at",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Kommer han?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Is he coming?"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg vet ikke om han kommer."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I do not know whether he is coming."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Sentence adverbs, words such as not, often, and always that comment on the whole clause, come before the finite verb in embedded questions."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "In embedded questions, place "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " before the finite verb."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun spør hvorfor jeg ikke svarer."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She asks why I am not answering."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Kan du sjekke om toget ikke går i dag?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Can you check whether the train is not running today?"
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "model",
      "title": "When hvem is the subject",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "When the wh-word itself is the subject, the person or thing doing the action, Norwegian often adds "
            },
            {
              "kind": "foreign_term",
              "value": "som",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " in the embedded question. For people, this gives the useful pattern "
            },
            {
              "kind": "foreign_term",
              "value": "hvem som",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hvem kommer i kveld?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Who is coming tonight?"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg vet ikke hvem som kommer i kveld."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I do not know who is coming tonight."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "note",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "This lesson uses "
                },
                {
                  "kind": "foreign_term",
                  "value": "som",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " only for embedded subject questions. Other uses of "
                },
                {
                  "kind": "foreign_term",
                  "value": "som",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " belong to relative clauses."
                }
              ]
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "hvem som",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when who is the subject inside an embedded question."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "recap",
      "title": "Core pattern",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Embedded questions let you make questions part of a larger sentence. The main job is to switch from direct question order to subordinate-clause order."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "text",
                "value": "Wh-question: "
              },
              {
                "kind": "foreign_term",
                "value": "Jeg vet hvor han bor.",
                "lang": "no"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Yes or no question: "
              },
              {
                "kind": "foreign_term",
                "value": "Jeg vet ikke om han kommer.",
                "lang": "no"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Negation before the finite verb: "
              },
              {
                "kind": "foreign_term",
                "value": "Hun spør hvorfor jeg ikke svarer.",
                "lang": "no"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Who as subject: "
              },
              {
                "kind": "foreign_term",
                "value": "Jeg vet hvem som ringte.",
                "lang": "no"
              }
            ]
          ]
        }
      ]
    },
    {
      "kind": "exercise",
      "id": "ex_choose_word_order",
      "operation": "choose",
      "prompt": [
        {
          "kind": "text",
          "value": "Choose the natural embedded question."
        }
      ],
      "explanation": [
        {
          "kind": "text",
          "value": "Good choice. Embedded questions use subject before the finite verb, so "
        },
        {
          "kind": "foreign_term",
          "value": "hva klokka er",
          "lang": "no"
        },
        {
          "kind": "text",
          "value": " is the right order."
        }
      ],
      "payload": {
        "options": [
          {
            "option_id": "a",
            "text": "Kan du si meg hva klokka er?",
            "why": "Correct. The subject klokka comes before the finite verb er."
          },
          {
            "option_id": "b",
            "text": "Kan du si meg hva er klokka?",
            "why": "This keeps direct question order inside the sentence."
          },
          {
            "option_id": "c",
            "text": "Kan du si meg er hva klokka?",
            "why": "The finite verb cannot move in front of the embedded question."
          }
        ],
        "answer_id": "a",
        "stem": [
          {
            "kind": "text",
            "value": "Which sentence means “Can you tell me what time it is?”"
          }
        ]
      }
    },
