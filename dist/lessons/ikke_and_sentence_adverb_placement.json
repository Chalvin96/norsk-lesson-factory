{
  "schema_version": "3.0",
  "key": "ikke_and_sentence_adverb_placement",
  "concept_slug": "ikke_and_sentence_adverb_placement",
  "grounding_mode": "fallback_no_wiki",
  "title": "Putting ikke and sentence adverbs in the right place",
  "cefr_level": "B1",
  "goal": "Place ikke and common sentence adverbs correctly in main and subordinate clauses.",
  "elements": [
    {
      "kind": "section",
      "role": "orient",
      "title": "What sentence adverbs do",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A sentence adverb is a word that comments on the whole clause, such as whether something happens, how often it happens, or how certain it is. Here, the main examples are "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "alltid",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "ofte",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and "
            },
            {
              "kind": "foreign_term",
              "value": "kanskje",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". Their position changes depending on the clause type."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The finite verb is the verb that shows tense, such as present or simple past. The key contrast is this: in a main clause, the finite verb comes before the sentence adverb; in a subordinate clause, the sentence adverb comes before the finite verb."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Main clause: finite verb before the sentence adverb. Subordinate clause: sentence adverb before the finite verb."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg kommer ikke i dag."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I am not coming today."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg vet at du ikke kommer i dag."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I know that you are not coming today."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "model",
      "title": "Main clauses",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A main clause is a clause that can stand alone as a sentence. In a normal main clause with subject first, put the sentence adverb after the finite verb. This is the same slot used by "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " and many frequency or certainty words."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "no",
            "no"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Pattern"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Subject"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Finite verb"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Sentence adverb"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "Negation"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Jeg"
                }
              ],
              [
                {
