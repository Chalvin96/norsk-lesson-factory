              ],
              [
                {
                  "kind": "text",
                  "value": "Hun"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "drikker"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "alltid"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
