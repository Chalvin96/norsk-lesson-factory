        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun drikker alltid kaffe om morgenen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She always drinks coffee in the morning."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi går ofte på tur etter jobb."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We often go for a walk after work."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Han kommer kanskje senere."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "He may come later."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "contrast",
      "title": "Subordinate clauses",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A subordinate clause is a clause that depends on another clause, often introduced by words like that, because, if, or when. In Norwegian, the sentence adverb comes before the finite verb inside the subordinate clause."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "After subordinators such as "
            },
            {
              "kind": "foreign_term",
              "value": "at",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "fordi",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "hvis",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and "
            },
            {
              "kind": "foreign_term",
              "value": "når",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", place the sentence adverb before the finite verb."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun sier at hun ikke har tid."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She says that she does not have time."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi blir hjemme fordi det ofte regner her."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We stay home because it often rains here."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg ringer hvis han kanskje trenger hjelp."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I will call if he maybe needs help."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "tip",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Do not move the whole English word order into Norwegian. Compare: "
                },
                {
                  "kind": "foreign_term",
                  "value": "Jeg vet at hun ikke kommer",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ", not "
                },
                {
                  "kind": "foreign_term",
                  "value": "Jeg vet at hun kommer ikke",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": "."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "contrast",
      "title": "When something comes first",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Fronting means putting another element first, before the subject, such as a time phrase. Norwegian still keeps the finite verb in second position. The sentence adverb stays after the finite verb, but its position compared with the subject can change."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "With a short pronoun subject such as "
            },
            {
              "kind": "foreign_term",
              "value": "jeg",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "du",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", or "
            },
            {
              "kind": "foreign_term",
              "value": "hun",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", the pronoun normally comes before "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". With a heavier noun subject, "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " often comes before the subject."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "I morgen kan hun ikke komme."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Tomorrow she cannot come."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "I morgen kan ikke læreren komme."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Tomorrow the teacher cannot come."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "På fredager spiser vi ofte middag hos venner."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "On Fridays we often eat dinner at friends' homes."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "After fronting, keep the finite verb second. Pronoun subjects usually stand before the sentence adverb; heavier noun subjects often stand after "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        }
      ]
    },
    {
      "kind": "exercise",
      "id": "ex_choose_main_ikke",
      "operation": "choose",
      "prompt": [
        {
          "kind": "text",
          "value": "Choose the correct main-clause order."
        }
