      "explanation": [
        {
          "kind": "text",
          "value": "In a main clause, the finite verb comes before "
        },
        {
          "kind": "foreign_term",
          "value": "ikke",
          "lang": "no"
        },
        {
          "kind": "text",
          "value": "."
        }
      ],
      "payload": {
        "options": [
          {
            "option_id": "a",
            "text": "Jeg forstår ikke spørsmålet.",
            "why": "Correct. The finite verb forstår comes before ikke."
          },
          {
            "option_id": "b",
            "text": "Jeg ikke forstår spørsmålet.",
            "why": "In a main clause, ikke does not normally come before the finite verb."
          },
          {
            "option_id": "c",
            "text": "Ikke jeg forstår spørsmålet.",
            "why": "This puts ikke in the wrong position for a neutral main clause."
          }
        ],
        "answer_id": "a",
        "stem": [
          {
            "kind": "text",
            "value": "Which sentence means: I do not understand the question?"
          }
        ]
      }
    },
