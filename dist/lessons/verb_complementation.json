{
  "schema_version": "3.0",
  "key": "verb_complementation",
  "concept_slug": "verb_complementation",
  "grounding_mode": "fallback_no_wiki",
  "title": "Choosing å or at after Norwegian verbs",
  "cefr_level": "B1",
  "goal": "Choose between å-infinitives, at-clauses, and bare infinitives after common Norwegian verbs.",
  "elements": [
    {
      "kind": "section",
      "role": "orient",
      "title": "What comes after the verb",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Many Norwegian verbs expect a particular kind of complement, the word group that completes the verb's meaning. The main choice is between an infinitive, the base verb form, and a clause, a small sentence with its own subject and finite verb. A finite verb is the verb that shows tense, such as "
            },
            {
              "kind": "foreign_term",
              "value": "kommer",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " or "
            },
            {
              "kind": "foreign_term",
              "value": "sa",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus infinitive when the next verb names an action controlled or started by the same subject."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "at",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when the complement is a full clause with its own subject and finite verb."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg prøver å forstå meldingen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I am trying to understand the message."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun sier at møtet begynner klokka ni."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She says that the meeting starts at nine."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "model",
      "title": "Verbs followed by å",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Some verbs commonly point forward to another action. In these patterns, Norwegian uses "
            },
            {
              "kind": "foreign_term",
              "value": "å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " before the second verb. The second verb stays in the infinitive form, so it does not show tense."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "no",
            "en",
            "no"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Pattern"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Use"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Example"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "prøve å"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "try to do something"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Vi prøver å finne en løsning."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "begynne å"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "begin to do something"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "De begynner å forstå reglene."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "pleie å"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "usually do something"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Jeg pleier å ta bussen."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "glemme å"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "forget to do something"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Han glemte å betale regningen."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "håpe å"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "hope to do something"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Vi håper å reise i juli."
                }
              ]
            ]
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Maria begynner å jobbe tidligere denne uka."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Maria is starting to work earlier this week."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg pleier å lese avisen om morgenen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I usually read the newspaper in the morning."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "tip",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "After these verbs, do not add a new subject unless you change the structure to a clause. "
                },
                {
                  "kind": "foreign_term",
                  "value": "Jeg håper å komme",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " means the same person hopes and comes."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "contrast",
      "title": "Verbs followed by at",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Speech, thought, opinion, and knowledge verbs often introduce a clause with "
            },
            {
              "kind": "foreign_term",
              "value": "at",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". This clause normally has its own subject and a finite verb. The verbs "
            },
            {
              "kind": "foreign_term",
              "value": "tro",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "vite",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and "
            },
            {
              "kind": "foreign_term",
              "value": "mene",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " follow the meaning distinctions you have seen before: belief, factual knowledge, and considered opinion."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "no",
            "en",
            "no"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Pattern"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Meaning"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Example"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "si at"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "say that"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Han sier at han er syk."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "tro at"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "believe or think that"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Jeg tror at toget er forsinket."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "vite at"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "know a fact that"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Vi vet at butikken stenger klokka seks."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "mene at"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "be of the opinion that"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Hun mener at planen er realistisk."
                }
              ]
            ]
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Læreren sier at vi må levere oppgaven i morgen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The teacher says that we must hand in the assignment tomorrow."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg tror at du har rett."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I think that you are right."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "note",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "In everyday Norwegian, "
                },
                {
                  "kind": "foreign_term",
                  "value": "at",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " is sometimes left out after verbs like "
                },
                {
                  "kind": "foreign_term",
                  "value": "tro",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " and "
                },
                {
                  "kind": "foreign_term",
                  "value": "si",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ". Keeping "
                },
                {
                  "kind": "foreign_term",
                  "value": "at",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " is clear and safe in writing."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "contrast",
      "title": "When å disappears",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A bare infinitive is an infinitive without "
            },
            {
              "kind": "foreign_term",
              "value": "å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". Norwegian uses it after modal verbs such as "
            },
            {
              "kind": "foreign_term",
              "value": "kan",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "må",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "skal",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and "
            },
            {
              "kind": "foreign_term",
              "value": "vil",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". It also appears after some perception verbs, verbs of seeing or hearing, especially "
            },
            {
              "kind": "foreign_term",
              "value": "se",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " and "
            },
            {
              "kind": "foreign_term",
              "value": "høre",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "After modal verbs, use the bare infinitive: "
            },
            {
              "kind": "foreign_term",
              "value": "kan komme",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", not "
            },
            {
              "kind": "foreign_term",
              "value": "kan å komme",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg kan hjelpe deg etter jobb."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I can help you after work."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi hørte naboen synge i går kveld."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We heard the neighbor sing last night."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "This contrast helps you avoid overusing "
            },
            {
              "kind": "foreign_term",
              "value": "å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". Compare "
            },
            {
              "kind": "foreign_term",
              "value": "Jeg prøver å lese",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " with "
            },
            {
              "kind": "foreign_term",
              "value": "Jeg kan lese",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". The first has a main verb that takes "
            },
            {
              "kind": "foreign_term",
              "value": "å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "; the second has a modal verb."
            }
          ]
        }
      ]
    },
