{
  "schema_version": "3.0",
  "key": "fronting_and_v2_inversion",
  "concept_slug": "fronting_and_v2_inversion",
  "grounding_mode": "fallback_no_wiki",
  "title": "Start with Time, Place, or Reason: Verb Second in Main Clauses",
  "cefr_level": "A2",
  "goal": "Put the finite verb second when a Norwegian main clause starts with something other than the subject.",
  "elements": [
    {
      "kind": "section",
      "role": "orient",
      "title": "The Second Position Rule",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "In a Norwegian main clause, the finite verb, the verb that shows tense, normally comes in second position. The first position is the opening slot of the clause. One whole phrase can fill that slot."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Main clause pattern: first position plus finite verb plus the rest of the sentence."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "I dag kommer han klokka fem."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Today he is coming at five o'clock."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Nå leser jeg en bok."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Now I am reading a book."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The first position can be the subject, a time expression, a place expression, or a reason word. The important point is that the finite verb still takes the next position."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "no",
            "no"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "First-position type"
              }
            ],
            [
              {
                "kind": "text",
                "value": "First position"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Finite verb"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Rest"
              }
            ]
          ],
          "rows": [
            [
              [
