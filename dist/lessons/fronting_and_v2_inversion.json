                }
              ],
              [
                {
                  "kind": "text",
                  "value": "han tidlig"
                }
              ]
            ]
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "model",
      "title": "When the Subject Moves Back",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "When you put something before the verb, the subject moves after the finite verb. This is called inversion: the usual subject and verb order is reversed."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "If a time, place, or reason phrase starts the main clause, put the finite verb next, then the subject."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg jobber hjemme i dag."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I am working at home today."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "I dag jobber jeg hjemme."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Today I am working at home."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi tar bussen nå."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We are taking the bus now."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Nå tar vi bussen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Now we are taking the bus."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "note",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "This lesson is about main clauses. Clauses that start with words like "
                },
                {
                  "kind": "foreign_term",
                  "value": "fordi",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " or "
                },
                {
                  "kind": "foreign_term",
                  "value": "hvis",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " use a different word order."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "contrast",
      "title": "Useful Starters",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Fronting is useful when you want to connect ideas or highlight time. Common starters include "
            },
            {
              "kind": "foreign_term",
              "value": "i dag",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "nå",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and "
            },
            {
              "kind": "foreign_term",
              "value": "derfor",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". After each one, the finite verb comes immediately."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Derfor blir jeg hjemme."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Therefore I am staying home."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "På mandag begynner kurset."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "On Monday the course begins."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Her bor søsteren min."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "My sister lives here."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Do not count each word in the fronted phrase separately. The whole phrase fills position one, and the finite verb is position two."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "contrast",
      "title": "Fronting with Ikke",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "With "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", the finite verb still stays in second position. The placement of the subject depends on whether the subject is a pronoun, a short word like "
            },
            {
              "kind": "foreign_term",
              "value": "han",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", or a noun phrase, a noun with possible extra words like "
            },
            {
              "kind": "foreign_term",
              "value": "Per",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " or "
            },
            {
              "kind": "foreign_term",
              "value": "den nye læreren",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "After fronting, a pronoun subject usually comes before "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". A noun subject often comes after "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "I dag vil han ikke spise fisk."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Today he does not want to eat fish."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "I dag vil ikke Per spise fisk."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Today Per does not want to eat fish."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Nå kan vi ikke vente."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Now we cannot wait."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Nå kan ikke læreren vente."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Now the teacher cannot wait."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "recap",
      "title": "Check the Pattern",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "To check a fronted main clause, find the opening phrase first. Then check that the finite verb comes right after it. If the subject is not first, it must come after the finite verb."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": true,
          "items": [
            [
              {
                "kind": "text",
                "value": "Choose what fills first position: subject, time, place, or reason."
              }
            ],
            [
              {
                "kind": "text",
                "value": "Put the finite verb immediately after it."
              }
            ],
            [
              {
                "kind": "text",
                "value": "Put a pronoun subject before "
              },
              {
                "kind": "foreign_term",
                "value": "ikke",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": ", but a noun subject can naturally come after "
              },
              {
                "kind": "foreign_term",
                "value": "ikke",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": "."
              }
            ]
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Derfor kommer han ikke på festen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Therefore he is not coming to the party."
            }
          ]
        }
      ]
    },
    {
