{
  "schema_version": "3.0",
  "key": "cleft_sentences",
  "concept_slug": "cleft_sentences",
  "grounding_mode": "fallback_no_wiki",
  "title": "Highlighting Information with Det er and Det var",
  "cefr_level": "B1",
  "goal": "Use cleft sentences to emphasize who, what, when, or where in Bokmål.",
  "elements": [
    {
      "kind": "section",
      "role": "orient",
      "title": "What a Cleft Sentence Does",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A cleft sentence is a sentence that splits information into two parts so one part gets special focus. In Norwegian, you often do this with "
            },
            {
              "kind": "foreign_term",
              "value": "det er",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " or "
            },
            {
              "kind": "foreign_term",
              "value": "det var",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". It is useful when you want to correct, clarify, or emphasize one detail."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg møtte Anna på stasjonen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I met Anna at the station."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det var Anna jeg møtte på stasjonen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "It was Anna I met at the station."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The second sentence puts the focus on "
            },
            {
              "kind": "foreign_term",
              "value": "Anna",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". The rest of the sentence tells what happened with that focused part."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use a cleft sentence when the focused detail is the answer to an implied question like who, what, when, or where."
            }
          ]
        }
      ]
    },
    {
      "kind": "exercise",
      "id": "ex_focus_recognition",
      "operation": "choose",
      "prompt": [
        {
          "kind": "text",
          "value": "Which detail is emphasized?"
        }
      ],
      "explanation": [
        {
          "kind": "text",
          "value": "The focused part comes right after "
        },
        {
          "kind": "foreign_term",
          "value": "det var",
          "lang": "no"
        },
        {
          "kind": "text",
          "value": ", so "
        },
        {
          "kind": "foreign_term",
          "value": "i går",
          "lang": "no"
        },
        {
          "kind": "text",
          "value": " is the emphasized detail."
        }
      ],
      "payload": {
        "options": [
          {
            "option_id": "a",
            "text": "i går",
            "why": "Correct. The time phrase after det var is the focused detail."
          },
          {
            "option_id": "b",
            "text": "jeg",
            "why": "This is the subject of the following clause, not the focused detail."
          },
          {
            "option_id": "c",
            "text": "e-posten",
            "why": "This is the object in the following clause, not the focused detail."
          }
        ],
        "answer_id": "a",
        "stem": [
          {
            "kind": "text",
            "value": "Det var i går jeg sendte e-posten."
          }
        ]
      }
    },
    {
      "kind": "section",
      "role": "model",
      "title": "Focusing on the Subject",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "When the focused part is the subject, the person or thing doing the action, Norwegian normally uses "
            },
            {
              "kind": "foreign_term",
              "value": "som",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " after the focused part."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Subject focus: "
            },
            {
              "kind": "foreign_term",
              "value": "Det er",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " or "
            },
            {
              "kind": "foreign_term",
              "value": "det var",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " + focused subject + "
            },
            {
              "kind": "foreign_term",
              "value": "som",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " + the rest of the sentence."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det er læreren som forklarer regelen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "It is the teacher who explains the rule."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det var naboen som ringte."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "It was the neighbor who called."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Choose "
            },
            {
              "kind": "foreign_term",
              "value": "det er",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when the emphasis belongs to the present situation. Choose "
            },
            {
              "kind": "foreign_term",
              "value": "det var",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when the emphasis belongs to a past situation."
            }
          ]
        },
