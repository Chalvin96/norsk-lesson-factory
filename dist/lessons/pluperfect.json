        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg hadde vært i Bergen før, så jeg fant fram til hotellet."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I had been in Bergen before, so I found my way to the hotel."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "De hadde gjort leksene før læreren kom."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "They had done the homework before the teacher came."
            }
          ]
        }
      ]
