{
  "schema_version": "3.0",
  "key": "pluperfect",
  "concept_slug": "pluperfect",
  "grounding_mode": "fallback_no_wiki",
  "title": "Past Perfect with hadde",
  "cefr_level": "B1",
  "goal": "Use hadde plus a past participle to show what was already completed before another past point.",
  "elements": [
    {
      "kind": "section",
      "role": "orient",
      "title": "The Job of Past Perfect",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Past perfect, also called pluskvamperfektum in Norwegian, is a verb form for something that was already completed before another past point. You use it when a story has two past moments and you need to show which one came first."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "hadde",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus a past participle, the completed verb form used after "
            },
            {
              "kind": "foreign_term",
              "value": "har",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " or "
            },
            {
              "kind": "foreign_term",
              "value": "hadde",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", for an action completed before another past action or past time."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Da jeg kom hjem, hadde hun laget middag."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "When I came home, she had made dinner."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi hadde snakket om planen før møtet begynte."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We had talked about the plan before the meeting began."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "tip",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Timeline: first "
                },
                {
                  "kind": "foreign_term",
                  "value": "hadde snakket",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ", then "
                },
                {
                  "kind": "foreign_term",
                  "value": "møtet begynte",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ". The past perfect points to the earlier past event."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "model",
      "title": "The Form",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The form is stable: "
            },
            {
              "kind": "foreign_term",
              "value": "hadde",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " stays the same for all subjects, and the main verb uses its past participle."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "en"
          ],
          "headers": [
            [
              {
