    {
      "kind": "exercise",
      "id": "ex_recall_hadde_vaert",
      "operation": "recall_fill",
      "prompt": [
        {
          "kind": "text",
          "value": "Complete the sentence with the form that means had been."
        }
      ],
      "explanation": [
        {
          "kind": "foreign_term",
          "value": "hadde vært",
          "lang": "no"
        },
        {
          "kind": "text",
          "value": " is the pluperfect and places the illness before another past event ("
        },
        {
          "kind": "foreign_term",
          "value": "eksamen begynte",
          "lang": "no"
        },
        {
          "kind": "text",
          "value": "). "
        },
        {
          "kind": "foreign_term",
          "value": "har vært",
          "lang": "no"
        },
        {
          "kind": "text",
          "value": " is the present perfect and would link the illness to now rather than to that past point. "
        },
        {
          "kind": "foreign_term",
          "value": "var",
          "lang": "no"
        },
        {
          "kind": "text",
          "value": " is the simple past was, but it does not mark a state that preceded another past event the way the pluperfect does."
        }
      ],
      "payload": {
        "segments": [
          {
            "kind": "span",
            "spans": [
