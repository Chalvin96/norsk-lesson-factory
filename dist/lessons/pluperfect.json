    {
      "kind": "section",
      "role": "recap",
      "title": "Keep the Timeline Clear",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Use past perfect when your sentence looks back from one past point to something earlier. The form is "
            },
            {
              "kind": "foreign_term",
              "value": "hadde",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus a past participle."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "text",
                "value": "For a single finished past event, use simple past."
              }
            ],
            [
              {
                "kind": "text",
                "value": "For a result or experience connected to now, use present perfect."
              }
            ],
            [
              {
                "kind": "text",
                "value": "For something completed before another past point, use past perfect."
              }
            ]
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Da toget kom, hadde vi ventet i en time."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "When the train arrived, we had waited for an hour."
            }
          ]
        }
      ]
    }
