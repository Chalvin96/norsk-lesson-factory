{
  "schema_version": "3.0",
  "key": "zero_article",
  "concept_slug": "zero_article",
  "grounding_mode": "fallback_no_wiki",
  "title": "When Norwegian Uses No Article",
  "cefr_level": "A2",
  "goal": "Use no article with common roles, languages, sports, mass nouns, transport, and indefinite plurals.",
  "elements": [
    {
      "kind": "section",
      "role": "orient",
      "title": "The Missing Article",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "An article is a small word like English a, an, or the. Norwegian often leaves the article out where English needs one. This is called zero article: the noun stands alone."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use no article in several everyday Norwegian patterns: roles after "
            },
            {
              "kind": "foreign_term",
              "value": "være",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " or "
            },
            {
              "kind": "foreign_term",
              "value": "bli",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", languages, sports, mass nouns, transport phrases, and indefinite plurals."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun er lege."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She is a doctor."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg snakker norsk."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I speak Norwegian."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "De spiller fotball."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "They play soccer."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "model",
      "title": "Jobs And Roles",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "After "
            },
            {
              "kind": "foreign_term",
              "value": "være",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " and "
            },
            {
              "kind": "foreign_term",
              "value": "bli",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", Norwegian normally uses no article for a person's job, role, nationality, or identity category. English often adds a or an, but Norwegian usually does not."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Say "
            },
            {
              "kind": "foreign_term",
              "value": "Hun er lærer",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", not "
            },
            {
              "kind": "foreign_term",
              "value": "Hun er en lærer",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", when you simply mean her profession."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Han er student."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "He is a student."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Maria blir ingeniør."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Maria is becoming an engineer."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "note",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Norwegian can use an indefinite article when you mean one specific example of a kind, but for the basic job or role pattern, leave it out."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "model",
      "title": "Common Zero Article Patterns",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A mass noun is a noun for something you usually do not count as single items, such as milk, coffee, or water. Norwegian also leaves out the article with languages, many sports and activities, and common transport phrases."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "en"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Pattern"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Norwegian"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Meaning"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "Language"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Vi snakker engelsk."
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "We speak English."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "Sport or activity"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Hun spiller tennis."
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "She plays tennis."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "Mass noun"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Jeg drikker melk."
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "I drink milk."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "Transport"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Vi kjører bil."
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "We drive by car."
                }
              ]
            ]
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Barna drikker vann."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The children drink water."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg kjører bil til jobben."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I drive to work."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "contrast",
      "title": "Plural Nouns Without A Word For Some",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "An indefinite plural means more than one thing, without saying exactly which ones. English often uses some, but Norwegian usually uses the plural noun alone."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "For indefinite plurals, use the plural noun without an article: "
            },
            {
              "kind": "foreign_term",
              "value": "Jeg har bøker",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " means I have books or I have some books."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi kjøper epler."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We are buying apples."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun leser aviser."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She reads newspapers."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "tip",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "If English tempts you to insert a or some, check the Norwegian pattern first. Jobs, languages, sports, mass nouns, transport, and indefinite plurals often need no article."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "exercise",
      "id": "ex_zero_article_choose_role",
      "operation": "choose",
      "prompt": [
        {
          "kind": "text",
          "value": "Choose the natural Norwegian sentence."
        }
      ],
      "explanation": [
        {
          "kind": "text",
          "value": "After "
        },
        {
          "kind": "foreign_term",
          "value": "er",
          "lang": "no"
        },
        {
          "kind": "text",
          "value": ", a profession normally has no article."
        }
      ],
      "payload": {
        "options": [
          {
            "option_id": "a",
            "text": "Hun er lege.",
            "why": "The profession follows er with no article."
          },
          {
            "option_id": "b",
            "text": "Hun er en lege.",
            "why": "Too English-like for the basic profession statement."
          },
          {
            "option_id": "c",
            "text": "Hun er legen.",
            "why": "This means the doctor, a definite noun."
          }
        ],
        "answer_id": "a",
        "stem": [
          {
            "kind": "text",
            "value": "She is a doctor."
          }
        ]
      }
    },
    {
      "kind": "exercise",
      "id": "ex_zero_article_recall_language",
      "operation": "recall_fill",
      "prompt": [
        {
          "kind": "text",
          "value": "Complete the sentence with the zero article pattern."
        }
      ],
      "explanation": [
        {
          "kind": "foreign_term",
          "value": "snakker norsk",
          "lang": "no"
        },
        {
          "kind": "text",
          "value": " is correct — language names take zero article after "
        },
        {
          "kind": "foreign_term",
          "value": "snakker",
          "lang": "no"
        },
        {
          "kind": "text",
          "value": ". "
        },
        {
          "kind": "foreign_term",
          "value": "snakker en norsk",
          "lang": "no"
        },
        {
          "kind": "text",
          "value": " inserts the indefinite article "
        },
        {
          "kind": "foreign_term",
          "value": "en",
          "lang": "no"
        },
        {
          "kind": "text",
          "value": " before the language name, which is not used with language names in this construction. "
        },
        {
          "kind": "foreign_term",
          "value": "snakker norsken",
          "lang": "no"
        },
        {
          "kind": "text",
          "value": " adds the definite suffix "
        },
        {
          "kind": "foreign_term",
          "value": "-en",
          "lang": "no"
        },
        {
          "kind": "text",
          "value": " to the language name, which is also incorrect; language names stand bare after verbs like "
        },
        {
          "kind": "foreign_term",
          "value": "snakker",
          "lang": "no"
        },
        {
          "kind": "text",
          "value": "."
        }
      ],
      "payload": {
        "segments": [
          {
            "kind": "span",
            "spans": [
