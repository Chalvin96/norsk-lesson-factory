{
  "schema_version": "3.0",
  "key": "present_perfect",
  "concept_slug": "present_perfect",
  "grounding_mode": "fallback_no_wiki",
  "title": "Using har + past participle for what matters now",
  "cefr_level": "A2",
  "goal": "Use Norwegian present perfect to talk about experience, results, and recent events with present relevance.",
  "elements": [
    {
      "kind": "section",
      "role": "orient",
      "title": "The basic idea",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian often uses har plus another verb form for past actions connected to now. The grammar name is present perfect. The pattern is "
            },
            {
              "kind": "foreign_term",
              "value": "har",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus the past participle, the form used after "
            },
            {
              "kind": "foreign_term",
              "value": "har",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "har",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus the past participle to say that something has happened and is relevant now."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg har snakket med læreren."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I have spoken with the teacher."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun har vært i Bergen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She has been to Bergen."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi har gjort leksene."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We have done the homework."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "model",
      "title": "How to build it",
      "blocks": [
