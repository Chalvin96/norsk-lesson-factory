              "kind": "text",
              "value": "The core form is "
            },
            {
              "kind": "foreign_term",
              "value": "har",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus a past participle. Use it when a past action connects to now through experience, result, or current relevance."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "foreign_term",
                "value": "har snakket",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " means has or have spoken."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "har vært",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " means has or have been."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "har gjort",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " means has or have done."
              }
            ]
          ]
        }
      ]
    },
