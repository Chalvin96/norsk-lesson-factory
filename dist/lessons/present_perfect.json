    {
      "kind": "section",
      "role": "model",
      "title": "Three common uses",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Present perfect often says that an experience exists, a result is visible now, or a recent action matters now. The exact time is usually not the point."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "text",
                "value": "Experience: something has happened at least once."
              }
            ],
            [
              {
                "kind": "text",
                "value": "Result: the action has created the current situation."
              }
            ],
            [
              {
                "kind": "text",
                "value": "Recent relevance: the action just happened or still matters."
              }
            ]
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg har aldri vært i Tromsø."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I have never been to Tromsø."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Han har mistet nøkkelen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "He has lost the key."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi har nettopp kommet hjem."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We have just come home."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "contrast",
      "title": "Present perfect or simple past",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Use the simple past, the one-word past tense for a finished event, when you give a finished past time such as "
            },
            {
              "kind": "foreign_term",
              "value": "i går",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". Use present perfect when the time is open or the result matters now."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "With a finished time expression, choose simple past; without one, or when the result matters now, choose present perfect."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg snakket med legen i går."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I spoke with the doctor yesterday."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg har snakket med legen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I have spoken with the doctor."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "recap",
      "title": "Quick recap",
      "blocks": [
