            {
              "kind": "foreign_term",
              "value": "har",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". The past participle comes after it. The participle does not change for "
            },
            {
              "kind": "foreign_term",
              "value": "jeg",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
