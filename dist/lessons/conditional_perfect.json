  "title": "Talking About What Would Have Happened",
  "cefr_level": "B2",
  "goal": "Use skulle, ville, burde, and kunne ha plus a past participle to describe unreal past outcomes, regrets, missed obligations, and possibilities.",
  "elements": [
    {
      "kind": "section",
      "role": "orient",
      "title": "The Core Pattern",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian uses a modal verb (like can, must, should, or will) in the simple past (the ordinary past tense, called "
            },
            {
              "kind": "foreign_term",
              "value": "preteritum",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " in Norwegian), followed by "
            },
            {
              "kind": "foreign_term",
              "value": "ha",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " and a past participle (the verb form used after have, such as "
            },
            {
              "kind": "foreign_term",
              "value": "gjort",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "sagt",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", or "
            },
            {
              "kind": "foreign_term",
              "value": "kommet",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "). This pattern talks about something that did not happen, or may not have happened, in the past."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Pattern: simple past modal plus "
            },
            {
              "kind": "foreign_term",
              "value": "ha",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus past participle."
            }
          ]
        },
