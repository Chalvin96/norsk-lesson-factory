      "role": "contrast",
      "title": "With Past Hypothetical Clauses",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A conditional clause is an if-clause. In Norwegian, "
            },
            {
              "kind": "foreign_term",
              "value": "hvis",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
