        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Unreal past condition: "
            },
            {
              "kind": "foreign_term",
              "value": "hvis",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus past perfect, then simple past modal plus "
            },
            {
              "kind": "foreign_term",
              "value": "ha",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus past participle."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
