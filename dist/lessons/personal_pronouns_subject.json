    {
      "kind": "section",
      "role": "model",
      "title": "Pronouns In Simple Sentences",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "In a simple statement, the subject pronoun often comes first. The next word is usually the verb, the action or state word. For now, focus on choosing the right subject pronoun."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg heter Anna."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "My name is Anna."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Du bor i Oslo."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "You live in Oslo."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Han er lærer."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "He is a teacher."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun er student."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She is a student."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi snakker norsk."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We speak Norwegian."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Dere jobber her."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "You work here."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "De bor i Bergen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "They live in Bergen."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "contrast",
      "title": "One You, More Than One You",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "English uses you for one person and also for a group. Bokmål makes a clear difference. Use "
            },
            {
              "kind": "foreign_term",
              "value": "du",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for one person you are speaking to, and "
            },
            {
              "kind": "foreign_term",
              "value": "dere",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for two or more people you are speaking to."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "foreign_term",
              "value": "du",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " means one you; "
            },
            {
              "kind": "foreign_term",
              "value": "dere",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " means you as a group."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Du er trøtt."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "You are tired."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Dere er trøtte."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "You are tired."
            }
          ]
        }
      ]
    },
    {
