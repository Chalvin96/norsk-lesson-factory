            {
              "kind": "foreign_term",
              "value": "noen",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " and "
            },
            {
              "kind": "foreign_term",
              "value": "noe",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " often mean some, any, someone, or something, depending on the sentence."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "noen",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for unspecified people or countable things, and "
            },
            {
              "kind": "foreign_term",
              "value": "noe",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for unspecified things, activities, or uncountable amounts."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg kjenner noen i Oslo."
