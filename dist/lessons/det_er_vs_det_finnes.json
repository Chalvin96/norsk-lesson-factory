{
  "schema_version": "3.0",
  "key": "det_er_vs_det_finnes",
  "concept_slug": "det_er_vs_det_finnes",
  "grounding_mode": "fallback_no_wiki",
  "title": "Using det er and det finnes",
  "cefr_level": "A2",
  "goal": "Choose between det er for identifying or describing and det finnes for existence or availability.",
  "elements": [
    {
      "kind": "section",
      "role": "orient",
      "title": "The shared little word det",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian often starts these sentences with "
            },
            {
              "kind": "foreign_term",
              "value": "det",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". Here it is a placeholder subject: a required subject that does not point to one concrete thing. English often uses "
            },
            {
              "kind": "foreign_term",
              "value": "it",
              "lang": "en"
            },
            {
              "kind": "text",
              "value": " or "
            },
            {
              "kind": "foreign_term",
              "value": "there",
              "lang": "en"
            },
            {
              "kind": "text",
              "value": " in similar sentences."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "det er",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when you identify or describe something; use "
            },
            {
              "kind": "foreign_term",
              "value": "det finnes",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when you mean that something exists or is available."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det er en kafé ved stasjonen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "There is a café by the station."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det finnes en kafé ved stasjonen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "There is a café by the station."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The difference is not about the English word "
            },
            {
              "kind": "foreign_term",
              "value": "there",
              "lang": "en"
            },
            {
              "kind": "text",
              "value": " by itself. It is about what you are doing: pointing out or describing something, or saying that it exists."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "model",
      "title": "det er identifies and describes",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "det er",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when the sentence gives an identity, a description, a day, a date, or a clock time. The verb that shows present tense is "
            },
            {
              "kind": "foreign_term",
              "value": "er",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", so the pattern is very useful for present-time facts."
            }
          ]
        },
