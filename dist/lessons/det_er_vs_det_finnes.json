            {
              "kind": "text",
              "value": "There is a pharmacy in the town center."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det finnes ikke billetter igjen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "There are no tickets left."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "You can use "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " with this pattern to say that something is not available. Details about words like "
            },
            {
              "kind": "foreign_term",
              "value": "noen",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " and "
            },
            {
              "kind": "foreign_term",
              "value": "noe",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " belong to a separate pattern; here, focus on choosing "
            },
            {
              "kind": "foreign_term",
              "value": "det finnes",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for existence or availability."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
