    {
      "kind": "section",
      "role": "model",
      "title": "det finnes means exists or is available",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "det finnes",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when you are saying that something exists, can be found, or is available. It often sounds like English "
            },
            {
              "kind": "foreign_term",
              "value": "there is",
              "lang": "en"
            },
            {
              "kind": "text",
              "value": " or "
            },
            {
              "kind": "foreign_term",
              "value": "there are",
              "lang": "en"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "foreign_term",
              "value": "Det finnes",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " does not identify one known thing; it presents something as existing or available."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det finnes mange gode apper for norsk."
            }
          ],
