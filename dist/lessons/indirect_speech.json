    {
      "kind": "exercise",
      "id": "ex_choose_wh_order",
      "operation": "choose",
      "prompt": [
        {
          "kind": "text",
          "value": "Choose the natural reported wh-question."
        }
      ],
      "explanation": [
        {
          "kind": "text",
          "value": "After a reporting verb, a wh-question uses subordinate-clause word order: question word, subject, finite verb."
        }
      ],
      "payload": {
        "options": [
          {
            "option_id": "a",
            "text": "Hun spurte hvor jeg bodde.",
            "why": "Correct. The subject comes before the finite verb."
          },
          {
            "option_id": "b",
            "text": "Hun spurte hvor bodde jeg.",
            "why": "This keeps direct question word order, which is not used here."
          },
          {
            "option_id": "c",
            "text": "Hun spurte om hvor jeg bodde.",
            "why": "Om is for yes/no questions, not this wh-question."
          }
        ],
        "answer_id": "a",
        "stem": [
          {
            "kind": "text",
            "value": "Direct question: Hvor bor du?"
          }
        ]
      }
    },
