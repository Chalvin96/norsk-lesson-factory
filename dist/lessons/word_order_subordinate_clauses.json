{
  "schema_version": "3.0",
  "key": "word_order_subordinate_clauses",
  "concept_slug": "word_order_subordinate_clauses",
  "grounding_mode": "fallback_no_wiki",
  "title": "Word Order After at, fordi, and hvis",
  "cefr_level": "A2",
  "goal": "Place ikke and other sentence adverbs before the finite verb in subordinate clauses with at, fordi, and hvis.",
  "elements": [
    {
      "kind": "section",
      "role": "orient",
      "title": "Dependent Clauses Need Their Own Order",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A subordinate clause is a dependent part of a sentence: it cannot stand alone as a full sentence. In Norwegian, many subordinate clauses begin with a subordinating conjunction such as "
            },
            {
              "kind": "foreign_term",
              "value": "at",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "fordi",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", or "
            },
            {
              "kind": "foreign_term",
              "value": "hvis",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "After one of these subordinating conjunctions, use this basic order: subordinating conjunction + subject + sentence adverb + finite verb."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The subject is the person or thing the clause is about. A sentence adverb is a small word that comments on the whole clause, such as "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " meaning not, "
            },
            {
              "kind": "foreign_term",
              "value": "alltid",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " meaning always, or "
            },
            {
              "kind": "foreign_term",
              "value": "ofte",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " means often. The finite verb is the verb that shows tense, such as "
            },
            {
              "kind": "foreign_term",
              "value": "kommer",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " or "
            },
            {
              "kind": "foreign_term",
              "value": "kan",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg tror at han ikke kommer."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I think that he is not coming."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi blir hjemme hvis det regner."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We are staying home if it rains."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "model",
      "title": "The Core Pattern",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The key place to watch is just before the finite verb. In a subordinate clause, "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " and similar sentence adverbs usually come before that verb."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "no",
            "no",
            "no"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Function"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Subordinating conjunction"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Subject"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Sentence adverb"
              }
            ],
            [
              {
