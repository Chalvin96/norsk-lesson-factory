            ]
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg vet at han ikke kommer i dag."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I know that he is not coming today."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun går hjem fordi hun ikke kan vente."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She is going home because she cannot wait."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi tar bussen hvis det ofte regner om morgenen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We take the bus if it often rains in the morning."
            }
          ]
        }
      ]
