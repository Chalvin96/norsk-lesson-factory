            {
              "kind": "text",
              "value": "An adjective describes a noun, such as big, new, or red. In Norwegian, when you point to a known thing with "
            },
            {
              "kind": "foreign_term",
              "value": "den",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "det",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", or "
            },
            {
              "kind": "foreign_term",
              "value": "de",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " before an adjective, the adjective normally takes the ending "
            },
            {
              "kind": "foreign_term",
              "value": "-e",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "After "
            },
            {
              "kind": "foreign_term",
              "value": "den",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "det",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and "
            },
            {
              "kind": "foreign_term",
              "value": "de",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", use the definite adjective form: usually adjective plus "
            },
            {
              "kind": "foreign_term",
              "value": "-e",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
