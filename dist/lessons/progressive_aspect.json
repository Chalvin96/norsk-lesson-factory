                  "value": "ongoing activity, often everyday or informal"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "sitter og"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "sitter og skriver"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "ongoing action while sitting"
                }
              ]
            ]
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "After "
            },
            {
              "kind": "foreign_term",
              "value": "og",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", use a finite verb form: "
            },
            {
              "kind": "foreign_term",
              "value": "driver og leser",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "sitter og jobber",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "contrast",
      "title": "Ongoing Action in the Past",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The same frames can appear in the simple past, the past-tense form. This is useful when one action was already in progress at a past moment."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg holdt på å lage middag da du ringte."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I was making dinner when you called."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Barna satt og tegnet da læreren kom inn."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The children were sitting and drawing when the teacher came in."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "To show a past action in progress, put the frame verb in the simple past: "
            },
            {
              "kind": "foreign_term",
              "value": "holdt på å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "drev og",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "satt og",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "recap",
      "title": "Keep the Frame Light",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Use these frames when the ongoing activity matters. If the sentence only says what is happening now, the ordinary present tense is often the most natural Norwegian choice."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "foreign_term",
                "value": "Jeg skriver.",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " can mean I am writing."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "Jeg holder på å skrive.",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " makes the ongoing action more explicit."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "Jeg sitter og skriver.",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " adds that the person is sitting while writing."
              }
            ]
          ]
        },
        {
          "kind": "callout",
          "level": "tip",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "When translating from English, do not add an activity frame automatically for every am or is. First ask whether Norwegian needs to highlight the action as underway."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "exercise",
      "id": "ex_choose_optional",
      "operation": "choose",
      "prompt": [
        {
          "kind": "text",
          "value": "Choose the most natural Norwegian sentence for a simple answer to What are you doing now?"
        }
      ],
      "explanation": [
        {
          "kind": "text",
          "value": "The ordinary present tense can translate English present continuous when no special emphasis on the ongoing action is needed."
        }
      ],
      "payload": {
        "options": [
          {
            "option_id": "a",
            "text": "Jeg leser.",
            "why": "The ordinary present tense is natural here."
          },
          {
            "option_id": "b",
            "text": "Jeg er leser.",
            "why": "This copies English structure and is not a correct way to form the continuous meaning."
          },
          {
            "option_id": "c",
            "text": "Jeg holder på lese.",
            "why": "The frame needs å before the infinitive: holder på å lese."
          }
        ],
        "answer_id": "a",
        "stem": [
          {
            "kind": "text",
            "value": "I am reading."
          }
        ]
      }
    },
