{
  "schema_version": "3.0",
  "key": "progressive_aspect",
  "concept_slug": "progressive_aspect",
  "grounding_mode": "fallback_no_wiki",
  "title": "Showing an Action in Progress",
  "cefr_level": "B1",
  "goal": "Use Norwegian activity frames to highlight actions happening right now or around a past moment.",
  "elements": [
    {
      "kind": "section",
      "role": "orient",
      "title": "Norwegian Has No Separate Continuous Tense",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "English often uses the present continuous, a verb form like am eating or is working, to show that something is happening now. Norwegian does not have a separate tense for this. Very often, the ordinary present tense, the verb form used for now or generally, is enough."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg lager middag."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I am making dinner."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun jobber hjemme i dag."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She is working from home today."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "When you want to highlight the activity as ongoing, Norwegian can add an activity-frame construction, a short phrase that frames the main verb as something in progress. These frames are natural, but optional."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use the ordinary present tense for many English present continuous meanings; add an activity frame when you want to stress that the action is actively underway."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "model",
      "title": "holder på å",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "foreign_term",
              "value": "holder på å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is the clearest general frame for an action in progress. After "
            },
            {
              "kind": "foreign_term",
              "value": "å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", use the infinitive, the base form of the verb such as "
            },
            {
              "kind": "foreign_term",
              "value": "å spise",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " or "
            },
            {
              "kind": "foreign_term",
              "value": "å skrive",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg holder på å spise."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I am eating."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "De holder på å flytte til Bergen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "They are moving to Bergen."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "foreign_term",
              "value": "holde på å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus infinitive highlights an action that is underway: "
            },
            {
              "kind": "foreign_term",
              "value": "holder på å skrive",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", not "
            },
            {
              "kind": "foreign_term",
              "value": "holder på å skriver",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "contrast",
      "title": "driver og, sitter og, står og, ligger og",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "foreign_term",
              "value": "driver og",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " also presents an activity as ongoing, often with a slightly informal or everyday tone. "
            },
            {
              "kind": "foreign_term",
              "value": "sitter og",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "står og",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and "
            },
            {
              "kind": "foreign_term",
              "value": "ligger og",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " add a body position when that position is natural or visible."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Han driver og leser om norsk historie."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "He is reading about Norwegian history."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun sitter og jobber på biblioteket."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She is sitting and working at the library."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi står og venter utenfor stasjonen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We are standing and waiting outside the station."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "no",
