      "id": "ex_structure_match",
      "operation": "match_pairs",
      "prompt": [
        {
          "kind": "text",
          "value": "Match each message part with its job."
        }
      ],
      "explanation": [
        {
          "kind": "text",
          "value": "Good. A short message normally moves from greeting to body to sign-off."
        }
      ],
      "payload": {
        "left": [
          {
            "left_id": "l_greeting",
            "text": "Greeting"
          },
          {
            "left_id": "l_body",
            "text": "Body"
          },
          {
            "left_id": "l_signoff",
            "text": "Sign-off"
          }
        ],
        "right": [
          {
            "right_id": "r_opens",
            "text": "Opens the message"
          },
          {
            "right_id": "r_main",
            "text": "Gives the main information"
          },
          {
            "right_id": "r_closes",
            "text": "Closes politely before the name"
          }
        ],
        "pairs": [
          {
            "left_id": "l_greeting",
            "right_id": "r_opens"
          },
          {
            "left_id": "l_body",
            "right_id": "r_main"
          },
          {
            "left_id": "l_signoff",
            "right_id": "r_closes"
          }
        ]
      }
    },
    {
      "kind": "exercise",
      "id": "ex_choose_greeting",
      "operation": "choose",
      "prompt": [
        {
          "kind": "text",
          "value": "Choose the best everyday greeting."
        }
      ],
      "explanation": [
        {
          "kind": "foreign_term",
          "value": "Hei",
          "lang": "no"
        },
        {
          "kind": "text",
          "value": " is the common neutral choice for short everyday messages."
        }
      ],
      "payload": {
        "options": [
          {
            "option_id": "o_hei",
            "text": "Hei Jonas,",
            "why": "Correct. This is friendly, neutral, and common before the message body."
          },
          {
            "option_id": "o_kjaere",
            "text": "Kjære Jonas,",
            "why": "This is possible, but it sounds warmer or more letter-like."
          },
          {
            "option_id": "o_hilsen",
            "text": "Hilsen Jonas",
            "why": "This is a sign-off, not a greeting."
          }
        ],
        "answer_id": "o_hei",
        "stem": [
          {
            "kind": "text",
            "value": "You are writing a short message to a colleague you know."
          }
        ]
      }
    },
