          },
          {
            "item_id": "i3",
            "text": "Regnet gjorde oss våte.",
            "bucket_id": "create_state"
          }
        ]
      }
    },
    {
      "kind": "exercise",
      "id": "ex_choose_gjore",
      "operation": "choose",
      "prompt": [
        {
          "kind": "text",
          "value": "Choose the best completion."
        }
      ],
      "explanation": [
        {
          "kind": "text",
          "value": "Correct. The result is an adjective, so "
        },
        {
          "kind": "foreign_term",
          "value": "gjorde oss nervøse",
          "lang": "no"
        },
        {
          "kind": "text",
          "value": " is the natural causative frame."
        }
      ],
      "payload": {
        "options": [
          {
            "option_id": "a",
            "text": "gjorde oss nervøse.",
            "why": "This means made us nervous, with object plus adjective."
          },
          {
            "option_id": "b",
            "text": "lot oss nervøse.",
            "why": "La is used before an action, not before an adjective result."
          },
          {
            "option_id": "c",
            "text": "fikk oss til å nervøse.",
            "why": "Få noen til å needs an infinitive verb after til å."
          }
        ],
        "answer_id": "a",
        "stem": [
          {
            "kind": "text",
            "value": "Forsinkelsen ..."
          }
        ]
      }
    },
    {
      "kind": "section",
      "role": "recap",
      "title": "Choose by meaning",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The safest way to choose the right causative is to ask what happens after the object. If someone is pushed, persuaded, or arranged into doing an action, use "
            },
            {
              "kind": "foreign_term",
              "value": "få noen til å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". If someone is allowed to do an action, use "
            },
            {
              "kind": "foreign_term",
              "value": "la noen",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". If someone becomes a quality or state, use "
            },
            {
              "kind": "foreign_term",
              "value": "gjøre noen",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus an adjective."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "foreign_term",
                "value": "få + object + til å + infinitive",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": ": get someone to do something"
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "la + object + bare infinitive",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": ": let someone do something"
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "gjøre + object + adjective",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": ": make someone become something"
              }
            ]
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun fikk meg til å smile."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She got me to smile."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun lot meg smile."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She let me smile."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun gjorde meg glad."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She made me happy."
            }
          ]
        }
      ]
    },
