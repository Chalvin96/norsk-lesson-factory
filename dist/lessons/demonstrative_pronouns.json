{
  "schema_version": "3.0",
  "key": "demonstrative_pronouns",
  "concept_slug": "demonstrative_pronouns",
  "grounding_mode": "fallback_no_wiki",
  "title": "This, That, These, and Those in Norwegian",
  "cefr_level": "A1",
  "goal": "Choose the right Norwegian demonstrative and use the definite noun form after it.",
  "elements": [
    {
      "kind": "section",
      "role": "orient",
      "title": "Pointing Words",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Demonstratives are pointing words like this, that, these, and those. In Norwegian, choose the form from the noun: common-gender singular, neuter singular, or plural."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "For nearby things, use "
            },
            {
              "kind": "foreign_term",
              "value": "denne",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " with a common-gender singular noun, "
            },
            {
              "kind": "foreign_term",
              "value": "dette",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " with a neuter singular noun, and "
            },
            {
              "kind": "foreign_term",
              "value": "disse",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " with plural nouns."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "no"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Noun type"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Near: this or these"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Example"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "Common-gender singular"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "denne"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "denne bilen"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "Neuter singular"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "dette"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "dette huset"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "Plural"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "disse"
                }
