              [
                {
                  "kind": "text",
                  "value": "disse bøkene"
                }
              ]
            ]
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Denne bilen er rød."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "This car is red."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Dette huset er lite."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "This house is small."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Disse bøkene er nye."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "These books are new."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "model",
      "title": "The Noun Becomes Definite",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "When a demonstrative stands before a noun, the noun normally takes the definite noun form, the form that means the car, the house, or the books."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use demonstrative plus definite noun: "
            },
            {
              "kind": "foreign_term",
              "value": "denne bilen",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "dette huset",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "disse bøkene",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "This is different from English. English says this car, but Norwegian says this the-car: "
            },
            {
              "kind": "foreign_term",
              "value": "denne bilen",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg liker denne bilen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I like this car."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi bor i dette huset."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We live in this house."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun leser disse bøkene."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She is reading these books."
            }
          ]
        }
      ]
    },
    {
