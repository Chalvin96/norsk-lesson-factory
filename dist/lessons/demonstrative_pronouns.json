    {
      "kind": "section",
      "role": "model",
      "title": "Det er and Dette er",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A predicative sentence describes or identifies something after the verb, as in it is a house. In Norwegian, "
            },
            {
              "kind": "foreign_term",
              "value": "det er",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is a very common way to introduce or identify something."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "dette er",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when you point to something close and say this is. Use "
            },
            {
              "kind": "foreign_term",
              "value": "det er",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for it is or that is in simple introductions."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "foreign_term",
              "value": "Dette er",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " points to something close. "
            },
            {
              "kind": "foreign_term",
              "value": "Det er",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " introduces or identifies something more generally."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Dette er en bil."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "This is a car."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det er et hus."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "It is a house."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det er en bok."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "It is a book."
            }
          ]
        }
      ]
    },
