      "title": "That and Those",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "For something farther away, Norwegian uses "
            },
            {
              "kind": "foreign_term",
              "value": "den",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "det",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and "
            },
            {
              "kind": "foreign_term",
              "value": "de",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " before a definite noun. You'll also see this pattern when contrasting one thing with another."
            }
          ]
        },
