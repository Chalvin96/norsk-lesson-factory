      "explanation": [
        {
          "kind": "text",
          "value": "In a yes/no question, the finite verb comes first, then the subject, then "
        },
        {
          "kind": "foreign_term",
          "value": "ikke",
          "lang": "no"
        },
        {
          "kind": "text",
          "value": "."
        }
      ],
      "payload": {
        "options": [
          {
            "option_id": "a",
            "text": "Kommer du ikke?",
            "why": "Kommer is first, du is the subject, and ikke follows the subject."
          },
          {
            "option_id": "b",
            "text": "Du kommer ikke?",
            "why": "This can be heard as a question with intonation, but it is not the basic yes/no question order."
          },
          {
            "option_id": "c",
            "text": "Kommer ikke du?",
            "why": "This word order can have a special contrastive meaning, but it is not the basic pattern taught here."
          }
