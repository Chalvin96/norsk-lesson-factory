{
  "schema_version": "3.0",
  "key": "negation_ikke_basic",
  "concept_slug": "negation_ikke_basic",
  "grounding_mode": "fallback_no_wiki",
  "title": "Put ikke in basic sentences",
  "cefr_level": "A1",
  "goal": "Place ikke correctly in simple Bokmål statements and questions.",
  "elements": [
    {
      "kind": "section",
      "role": "orient",
      "title": "The basic job of ikke",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Negation means making a sentence negative. In Bokmål, the basic negative word is "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ": not."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "A finite verb is the verb that shows tense. In a simple main clause, a complete sentence that can stand alone, put "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " right after the finite verb."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg snakker ikke norsk."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I do not speak Norwegian."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun bor ikke her."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She does not live here."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det er ikke kaldt."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "It is not cold."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "model",
      "title": "Positive and negative pairs",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The subject, the person or thing the sentence is about, usually comes before the finite verb in a simple statement. To make the sentence negative, keep the subject and verb in place, then add "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " after the verb."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "no"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Pattern"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Positive"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Negative"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "I speak"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Jeg snakker norsk."
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Jeg snakker ikke norsk."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "She lives"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Hun bor her."
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Hun bor ikke her."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "It is"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Det er dyrt."
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Det er ikke dyrt."
                }
              ]
            ]
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "English often uses do not or does not. Norwegian does not add a helper word here. The finite verb stays in second position in these simple statements, and "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " follows it."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi jobber ikke i dag."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We are not working today."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "contrast",
      "title": "Ikke in questions",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "In a yes/no question, the finite verb comes first. "
            },
            {
              "kind": "foreign_term",
              "value": "Ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " still comes after the finite verb and usually after the subject."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Kommer du ikke?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Are you not coming?"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Er Maria ikke hjemme?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Is Maria not at home?"
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "In a question-word question, a question word such as who, what, or where comes first. The finite verb still comes before the subject, and "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " comes after that verb pattern."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hvorfor kommer du ikke?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Why are you not coming?"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hvorfor spiser hun ikke frokost?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Why doesn't she eat breakfast?"
            }
          ]
        },
        {
          "kind": "callout",
          "level": "note",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Some question words can be the subject themselves, as in who comes. In that case there is no extra subject after the verb."
                }
              ]
            },
            {
              "kind": "example",
              "no": [
                {
                  "kind": "text",
                  "value": "Hvem kommer ikke?"
                }
              ],
              "en": [
                {
                  "kind": "text",
                  "value": "Who is not coming?"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "recap",
      "title": "Quick pattern check",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "For the basic pattern, look for the finite verb first. In simple statements and questions, "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " normally comes right after the finite verb pattern."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "text",
                "value": "Statement: subject plus finite verb plus "
              },
              {
                "kind": "foreign_term",
                "value": "ikke",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            [
              {
                "kind": "text",
                "value": "Yes/no question: finite verb plus subject plus "
              },
              {
                "kind": "foreign_term",
                "value": "ikke",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            [
              {
                "kind": "text",
                "value": "Question-word question: question word plus finite verb plus subject plus "
              },
              {
                "kind": "foreign_term",
                "value": "ikke",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": "."
              }
            ]
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg liker ikke kaffe."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I do not like coffee."
            }
          ]
        }
      ]
    },
    {
      "kind": "exercise",
      "id": "ex_choose_position_statement",
      "operation": "choose",
      "prompt": [
        {
          "kind": "text",
          "value": "Choose the sentence with "
        },
        {
          "kind": "foreign_term",
          "value": "ikke",
          "lang": "no"
        },
        {
          "kind": "text",
          "value": " in the normal place."
        }
      ],
      "explanation": [
        {
          "kind": "text",
          "value": "In a simple statement, "
        },
        {
          "kind": "foreign_term",
          "value": "ikke",
          "lang": "no"
        },
        {
          "kind": "text",
          "value": " follows the finite verb."
        }
      ],
      "payload": {
        "options": [
          {
            "option_id": "a",
            "text": "Jeg ikke snakker norsk.",
            "why": "Ikke is before the finite verb, so this is not the normal basic pattern."
          },
          {
            "option_id": "b",
            "text": "Jeg snakker ikke norsk.",
            "why": "Snakker is the finite verb, and ikke comes right after it."
          },
          {
            "option_id": "c",
            "text": "Ikke jeg snakker norsk.",
            "why": "This starts with ikke and does not match the basic statement pattern."
          }
        ],
        "answer_id": "b",
        "stem": [
          {
            "kind": "text",
            "value": "Which sentence means I do not speak Norwegian?"
          }
        ]
      }
    },
