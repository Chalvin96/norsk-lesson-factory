    {
      "kind": "section",
      "role": "contrast",
      "title": "Same Verb with Every Subject",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Bokmål does not change the present-tense verb to match the subject. The subject is who does the action, such as I, you, she, or they."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Keep the same present-tense verb after every subject."
