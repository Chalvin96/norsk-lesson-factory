{
  "schema_version": "3.0",
  "key": "present_tense",
  "concept_slug": "present_tense",
  "grounding_mode": "fallback_no_wiki",
  "title": "Present Tense for Now and Habits",
  "cefr_level": "A1",
  "goal": "Form and understand simple Bokmål present-tense statements with regular verbs and er, har, gjør.",
  "elements": [
    {
      "kind": "section",
      "role": "orient",
      "title": "What Present Tense Does",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Use the present tense for things happening now, current states, and habits. In Bokmål, one present-tense form can cover both English meanings like I speak and I am speaking."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use one present-tense verb form for now, current states, and habits."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg snakker norsk."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I speak Norwegian. / I am speaking Norwegian."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun jobber i dag."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She works today. / She is working today."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi bor i Oslo."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We live in Oslo."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "note",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "English often separates simple present and present continuous. Bokmål usually uses the same present-tense form for both, so context tells you the meaning."
                }
              ]
            }
          ]
        }
      ]
    },
