      "title": "Who Does It, Who Receives It",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian personal pronouns change form depending on their job in the sentence. A subject is the person or thing doing the action. An object is the person or thing receiving the action."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use subject forms for the doer, and object forms after verbs like "
            },
            {
              "kind": "foreign_term",
              "value": "ser",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "hører",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "hjelper",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and "
            },
            {
              "kind": "foreign_term",
              "value": "liker",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg ser deg."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I see you."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Du hører meg."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "You hear me."
            }
          ]
        }
      ]
    },
