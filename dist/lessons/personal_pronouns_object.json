        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "In a simple statement, the object pronoun usually comes after the finite verb. Keep this basic pattern in your head first: subject, verb, object."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Basic pattern: subject + verb + object pronoun."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Læreren hjelper meg."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The teacher helps me."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Maria ringer oss."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Maria calls us."
            }
