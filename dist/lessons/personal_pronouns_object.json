            {
              "kind": "foreign_term",
              "value": "henne",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for male and female people; use "
            },
            {
              "kind": "foreign_term",
              "value": "dem",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for several people."
            }
          ]
