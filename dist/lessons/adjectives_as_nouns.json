{
  "schema_version": "3.0",
  "key": "adjectives_as_nouns",
  "concept_slug": "adjectives_as_nouns",
  "grounding_mode": "fallback_no_wiki",
  "title": "Using Adjectives as Nouns",
  "cefr_level": "B1",
  "goal": "Use Norwegian adjectives as noun phrases with correct definiteness, number, and neuter forms.",
  "elements": [
    {
      "kind": "section",
      "role": "orient",
      "title": "When an Adjective Stands Alone",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "An adjective is a word that describes a person or thing, like old, young, important, or new. A noun is a word for a person, thing, or idea. Norwegian can let an adjective stand where a noun phrase would normally stand. This is called a nominalized adjective: an adjective used as a noun phrase."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "A nominalized adjective points to a person, people, or thing without repeating the noun."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "De unge trenger flere møteplasser."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The young people need more meeting places."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Den gamle bor alene."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The old person lives alone."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "English often adds people, one, or thing. Norwegian often lets the adjective carry that meaning together with a small word such as "
            },
            {
              "kind": "foreign_term",
              "value": "den",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "det",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", or "
            },
            {
              "kind": "foreign_term",
              "value": "de",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "model",
      "title": "Definite People: Den, Det, De",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Definite means known or specific. When a nominalized adjective refers to known people, Norwegian usually uses "
            },
            {
              "kind": "foreign_term",
              "value": "den",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for one common-gender person, "
            },
            {
              "kind": "foreign_term",
              "value": "det",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for one neuter idea or thing, and "
            },
            {
              "kind": "foreign_term",
              "value": "de",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for plural, more than one."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "no"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Meaning"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Form"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Example"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "one known person"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "den gamle"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Den gamle smilte."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "known people"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "de unge"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "De unge svarte først."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "one known neuter thing or idea"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "det viktige"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Det viktige er å lytte."
                }
              ]
            ]
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "In definite nominalized adjectives, use den, det, or de before the adjective, and use the definite adjective ending: usually -e."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "De rike betaler mer skatt."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The rich pay more tax."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Den syke fikk hjelp raskt."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The sick person got help quickly."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "note",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "This pattern often refers to groups of people: "
                },
                {
                  "kind": "foreign_term",
                  "value": "de unge",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ", "
                },
                {
                  "kind": "foreign_term",
                  "value": "de eldre",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ", "
                },
                {
                  "kind": "foreign_term",
                  "value": "de rike",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ", and "
                },
                {
                  "kind": "foreign_term",
                  "value": "de fattige",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": "."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "contrast",
      "title": "Things and Ideas: Det Viktigste and Noe Nytt",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Neuter means the "
            },
            {
              "kind": "foreign_term",
              "value": "et",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " grammatical gender. Indefinite means not specific. For ideas and things, two useful patterns are "
            },
            {
              "kind": "foreign_term",
              "value": "det",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus a definite adjective, and words like "
            },
            {
              "kind": "foreign_term",
              "value": "noe",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus a neuter adjective."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use det plus a definite adjective for a known thing or idea, and noe plus a neuter adjective for an unspecified thing or idea."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det viktigste er å komme i tide."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The most important thing is to arrive on time."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg vil prøve noe nytt i helgen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I want to try something new this weekend."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun sa noe hyggelig etter møtet."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She said something nice after the meeting."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "no"
          ],
          "headers": [
