                {
                  "kind": "foreign_term",
                  "value": "viktig",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ". Some adjectives already end in "
                },
                {
                  "kind": "foreign_term",
                  "value": "-ig",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " and do not add another visible "
                },
                {
                  "kind": "foreign_term",
                  "value": "-t",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " in neuter."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "recap",
      "title": "The Core Pattern",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "When Norwegian leaves out the noun, the small word and the adjective ending show what you mean: one known person, known people, a known thing or idea, or something unspecified."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
