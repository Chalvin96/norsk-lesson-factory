            [
              {
                "kind": "foreign_term",
                "value": "noe nytt",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " means something new."
              }
            ]
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Choose den, det, de, or noe first; then choose the adjective form that belongs to that pattern."
            }
          ]
        }
      ]
    },
