            [
              {
                "kind": "foreign_term",
                "value": "de unge",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " means the young people."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "det viktigste",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " means the most important thing."
