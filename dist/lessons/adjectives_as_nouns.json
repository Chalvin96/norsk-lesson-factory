    },
    {
      "kind": "section",
      "role": "contrast",
      "title": "Common Contrasts",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The ending changes with the pattern. For known people or known things, the adjective normally ends in "
            },
            {
              "kind": "foreign_term",
              "value": "-e",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". After "
            },
            {
              "kind": "foreign_term",
              "value": "noe",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", the adjective uses the neuter form, often "
            },
            {
              "kind": "foreign_term",
              "value": "-t",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Do not mix the patterns: de unge for known young people, but noe nytt for something new."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi må høre på de unge."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We must listen to the young people."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi må finne noe nytt."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We must find something new."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det beste er å spørre først."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The best thing is to ask first."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "warning",
          "blocks": [
            {
              "kind": "paragraph",
