    {
      "kind": "section",
      "role": "model",
      "title": "Frequency After the Verb",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A finite verb is the verb that shows tense. In a simple main clause, frequency adverbs usually come after the finite verb. This is the normal pattern with "
            },
            {
              "kind": "foreign_term",
              "value": "ofte",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "alltid",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and "
            },
            {
              "kind": "foreign_term",
              "value": "aldri",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Basic pattern: subject + finite verb + frequency adverb."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg drikker ofte kaffe."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I often drink coffee."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi spiser alltid frokost."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We always eat breakfast."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Han jobber aldri på søndag."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "He never works on Sunday."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "model",
      "title": "Time and Place at the End",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Time and place adverbs can often stand at the end of a simple sentence. This keeps the word order easy: subject, verb, then the extra information."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Basic pattern: subject + finite verb + rest of sentence + time or place adverb."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg bor her."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I live here."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Bussen kommer nå."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The bus is coming now."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "De sitter der."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "They are sitting there."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "contrast",
      "title": "When the Adverb Comes First",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "You can put a time or place adverb first when you want to start with that information. In Norwegian main clauses, the finite verb still comes in second position. This is called V2 word order: verb second."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "When a time or place adverb starts the sentence, use: adverb + finite verb + subject."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Nå kommer bussen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Now the bus is coming."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Snart spiser vi middag."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Soon we are eating dinner."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Her bor jeg."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Here I live."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "warning",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Use "
                },
                {
                  "kind": "foreign_term",
                  "value": "nå",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " for now. Do not use "
                },
                {
                  "kind": "foreign_term",
                  "value": "da",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " or "
                },
                {
                  "kind": "foreign_term",
                  "value": "når",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " as a replacement for "
                },
                {
                  "kind": "foreign_term",
                  "value": "nå",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": "; they have different jobs in time expressions and clauses."
                }
              ]
            }
          ]
        }
      ]
    },
