    {
      "kind": "section",
      "role": "model",
      "title": "Comparing two things with enn",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "When you compare two people or things, use the comparative form and "
            },
            {
              "kind": "foreign_term",
              "value": "enn",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". "
            },
            {
              "kind": "foreign_term",
              "value": "Enn",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " means than."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use this pattern: thing A + verb + comparative adjective + "
            },
            {
              "kind": "foreign_term",
              "value": "enn",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " + thing B."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Bilen er billigere enn toget."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The car is cheaper than the train."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Oslo er større enn Bergen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Oslo is bigger than Bergen."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Dette rommet er mindre enn kjøkkenet."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "This room is smaller than the kitchen."
            }
          ]
        }
      ]
    },
