        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A superlative is the form for the most. When the superlative describes a specific noun, use a definite superlative. Definite means the noun phrase points to a specific person or thing, often with the, this, or those in English."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "For regular definite superlatives, use "
            },
            {
              "kind": "foreign_term",
              "value": "den",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "det",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", or "
            },
            {
              "kind": "foreign_term",
              "value": "de",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " before the adjective, and add "
            },
            {
              "kind": "foreign_term",
              "value": "-este",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " to the adjective."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun har den peneste kjolen."
