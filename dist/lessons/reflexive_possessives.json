{
  "schema_version": "3.0",
  "key": "reflexive_possessives",
  "concept_slug": "reflexive_possessives",
  "grounding_mode": "fallback_no_wiki",
  "title": "Owning Your Own: sin, si, sitt, sine",
  "cefr_level": "A2",
  "goal": "Choose the correct possessive when the subject owns the noun.",
  "elements": [
    {
      "kind": "section",
      "role": "orient",
      "title": "The Owner Is the Key",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A possessive tells you who owns something. A reflexive possessive is a possessive that points back to the subject, the person or thing doing the verb in the sentence."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "In Norwegian, "
            },
            {
              "kind": "foreign_term",
              "value": "sin",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "si",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "sitt",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and "
            },
            {
              "kind": "foreign_term",
              "value": "sine",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " mean that the subject owns the noun. They do not mean his, her, or their by themselves; they mean the subject's own."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "sin",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "si",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "sitt",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", or "
            },
            {
              "kind": "foreign_term",
              "value": "sine",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when the owner is the subject of the sentence."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Lina leser boka si."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Lina is reading her own book."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jon finner nøkkelen sin."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Jon finds his own key."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "De besøker foreldrene sine."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "They visit their own parents."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "model",
      "title": "The Form Follows the Noun",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The form of the reflexive possessive agrees with the owned noun, not with the owner. Agreement means that the possessive changes to fit the noun's gender or number."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "no"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Owned noun type"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Form"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Example"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "Masculine noun"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "sin"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "bilen sin"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "Feminine noun"
                }
              ],
              [
                {
