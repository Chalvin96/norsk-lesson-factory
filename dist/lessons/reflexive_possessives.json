                }
              ]
            ]
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun selger bilen sin."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She is selling her own car."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Han tar på seg jakka si."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "He puts on his own jacket."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Kari maler huset sitt."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Kari is painting her own house."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Choose the form from the owned noun: "
            },
            {
              "kind": "foreign_term",
              "value": "sin",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " with many masculine nouns, "
            },
            {
              "kind": "foreign_term",
              "value": "si",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " with many feminine nouns, "
            },
            {
              "kind": "foreign_term",
              "value": "sitt",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " with neuter nouns, and "
            },
            {
              "kind": "foreign_term",
              "value": "sine",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " with plural nouns."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "contrast",
      "title": "Subject Owner or Someone Else",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Use ordinary possessives when the owner is not the subject. Ordinary possessives are forms like "
            },
            {
              "kind": "foreign_term",
              "value": "hans",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "hennes",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and "
            },
            {
              "kind": "foreign_term",
              "value": "deres",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "; they point to someone else in the situation, not back to the subject."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Per liker kona si."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Per likes his own wife."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Per liker kona hans."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Per likes his wife, here meaning another man's wife."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Maria hjelper broren sin."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Maria helps her own brother."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Maria hjelper broren hennes."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Maria helps her brother, here meaning another woman's brother."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Barna rydder rommet sitt."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The children clean their own room."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Barna rydder rommet deres."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The children clean their room, here meaning someone else's room or your/their room from context."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "tip",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Ask one question: Does the subject own this noun? If yes, choose a reflexive possessive. If no, use another possessive such as "
                },
                {
                  "kind": "foreign_term",
                  "value": "hans",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ", "
                },
                {
                  "kind": "foreign_term",
                  "value": "hennes",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ", or "
                },
                {
                  "kind": "foreign_term",
                  "value": "deres",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": "."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "contrast",
      "title": "Not as the Subject",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The reflexive possessives point back to the subject, so they need another subject to point back to. They cannot be used inside the subject itself."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "foreign_term",
              "value": "Sin",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "si",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "sitt",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and "
            },
            {
              "kind": "foreign_term",
              "value": "sine",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " cannot be used in subject position."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Faren hans bor i Bergen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "His father lives in Bergen."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Mora hennes jobber i dag."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Her mother works today."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vennene deres kommer klokka seks."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Their friends are coming at six o'clock."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "warning",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Do not start a sentence with a noun phrase like "
                },
                {
                  "kind": "foreign_term",
                  "value": "faren sin",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " when that phrase is the subject. Use "
                },
                {
                  "kind": "foreign_term",
                  "value": "hans",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ", "
                },
                {
                  "kind": "foreign_term",
                  "value": "hennes",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ", or "
                },
                {
                  "kind": "foreign_term",
                  "value": "deres",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " instead."
                }
              ]
            }
          ]
        }
      ]
    },
