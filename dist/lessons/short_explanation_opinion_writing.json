                "lang": "no"
              },
              {
                "kind": "text",
                "value": "."
              }
            ]
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg synes flere bør gå til butikken. For det første er det sunt, og for det andre er det bedre for miljøet. Derfor er det en god vane."
            }
          ],
          "en": [
            {
              "kind": "text",
