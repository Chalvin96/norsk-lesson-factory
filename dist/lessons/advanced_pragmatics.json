{
  "schema_version": "3.0",
  "key": "advanced_pragmatics",
  "concept_slug": "advanced_pragmatics",
  "grounding_mode": "fallback_no_wiki",
  "title": "Pragmatic Markers for Tone, Stance, and Implication",
  "cefr_level": "B2",
  "goal": "Use common Bokmål markers to soften, imply, evaluate, and shift topic naturally.",
  "elements": [
    {
      "kind": "section",
      "role": "orient",
      "title": "What Pragmatic Markers Do",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Pragmatic markers are small words or phrases that guide how the listener should understand your sentence. They do not usually change the factual content. Instead, they show whether something is expected, uncertain, polite, surprising, unfortunate, or a side comment."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "A pragmatic marker tells the listener how to interpret the message: as obvious, tentative, helpful, regrettable, surprising, or newly introduced."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Du vet jo hvor inngangen er."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "You know where the entrance is, don't you?"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det går vel bra."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "It will probably be all right, I suppose."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Notice that English often needs extra phrasing to express the same tone. Norwegian can carry much of that work with one short marker."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "model",
      "title": "Softening and Implication",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "foreign_term",
              "value": "jo",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "vel",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "nok",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and "
            },
            {
              "kind": "foreign_term",
              "value": "gjerne",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " are especially useful when the sentence is socially loaded. They can make a claim sound shared, tentative, probable, or willing."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "no",
            "en",
            "no"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Marker"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Typical effect"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Example"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "jo"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "marks something as already known, shared, or obvious"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Det har vi jo avtalt."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "vel"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "softens a guess, assumption, or mild challenge"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Du kommer vel på møtet?"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "nok"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "signals probability or a measured conclusion"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Det blir nok dyrere enn vi trodde."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "gjerne"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "adds willingness, politeness, or a positive offer"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Jeg hjelper gjerne til."
                }
              ]
            ]
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "jo",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when you treat information as shared, "
            },
            {
              "kind": "foreign_term",
              "value": "vel",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when you soften an assumption, "
            },
            {
              "kind": "foreign_term",
              "value": "nok",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when you infer what is probable, and "
            },
            {
              "kind": "foreign_term",
              "value": "gjerne",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when you express willing helpfulness."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Du har jo sendt rapporten allerede."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "You have already sent the report, as we both know."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "De svarer nok i løpet av dagen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "They will probably answer during the day."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "tip",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "A sentence adverb is a word that comments on the whole sentence, not just one verb. In a main clause, markers like "
                },
                {
                  "kind": "foreign_term",
                  "value": "jo",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ", "
                },
                {
                  "kind": "foreign_term",
                  "value": "vel",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ", and "
                },
                {
                  "kind": "foreign_term",
                  "value": "nok",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " often come after the finite verb."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "contrast",
      "title": "Stance and Evaluation",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Some markers evaluate the whole event. They tell the reader whether the situation is lucky, regrettable, strange, or unexpected. These markers are common in both speech and writing, but they must be placed clearly."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Evaluative sentence adverbs can stand near the start of the clause for emphasis or after the finite verb in a neutral main-clause pattern."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Heldigvis fant vi en løsning før fristen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Fortunately, we found a solution before the deadline."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi fant heldigvis en løsning før fristen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We fortunately found a solution before the deadline."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Dessverre ble møtet utsatt igjen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Unfortunately, the meeting was postponed again."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "An extraposed attitude marker is a comment phrase placed outside the core clause. It often comes first and comments on the full statement that follows."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Merkelig nok var kontoret åpent hele kvelden."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Strangely enough, the office was open all evening."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "warning",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Do not place an ordinary sentence adverb directly between the subject and finite verb in a plain main clause. Say "
                },
                {
                  "kind": "foreign_term",
                  "value": "Vi fant heldigvis en løsning",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ", not "
                },
                {
                  "kind": "foreign_term",
                  "value": "Vi heldigvis fant en løsning",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": "."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "contrast",
      "title": "Topic Shifts and Register",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Discourse markers organize the conversation itself. They can introduce a side note, summarize, correct the direction of talk, or make a reaction sound immediate. Their register matters: some are neutral in email, while others are more conversational."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "no",
            "en",
            "no"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Marker"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Use"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Natural context"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "forresten"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "adds a side note or shifts to a related point"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Forresten, har du sett den nye planen?"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "altså"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "clarifies, sums up, or expresses reaction; often conversational"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Det betyr altså at vi må starte på nytt."
                }
              ]
            ]
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "forresten",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for a side note, and use "
            },
            {
              "kind": "foreign_term",
              "value": "altså",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for clarification, conclusion, or a spoken-style reaction."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Forresten, jeg kan sende deg lenken etterpå."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "By the way, I can send you the link later."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Dette er altså grunnen til at fristen ble flyttet."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "So this is the reason the deadline was moved."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "note",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "In formal writing, keep discourse markers purposeful. "
                },
                {
                  "kind": "foreign_term",
                  "value": "Altså",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " can sound abrupt or spoken if it opens a formal email without a clear reason."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "recap",
      "title": "Choosing the Right Signal",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "When choosing a marker, ask what relationship you want between the sentence and the listener: shared knowledge, uncertainty, probability, willingness, evaluation, or topic management."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "foreign_term",
                "value": "jo",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": ": the point is treated as shared or obvious."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "vel",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": ": the claim is softened as an assumption."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "nok",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": ": the claim is probable or inferred."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "gjerne",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": ": the speaker is willing or politely positive."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "heldigvis",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "kind": "foreign_term",
                "value": "dessverre",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": ", and "
              },
              {
                "kind": "foreign_term",
                "value": "merkelig nok",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": ": the whole event is evaluated."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "forresten",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "kind": "foreign_term",
                "value": "altså",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": ": the conversation is steered or clarified."
              }
            ]
          ]
        }
      ]
    },
