    {
      "kind": "section",
      "role": "contrast",
      "title": "hverandre or seg",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A reflexive pronoun points the action back to the same person or people. In Bokmål, "
            },
            {
              "kind": "foreign_term",
              "value": "seg",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is a common reflexive pronoun. The contrast is about meaning: "
            },
            {
              "kind": "foreign_term",
              "value": "hverandre",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " means each other, while "
            },
            {
              "kind": "foreign_term",
              "value": "seg",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " means himself, herself, itself, or themselves, depending on the subject."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "De ser på hverandre."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "They look at each other."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "De ser på seg selv i speilet."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "They look at themselves in the mirror."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "tip",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Ask: does the action go between people, or back to each person? Between people points to "
                },
                {
                  "kind": "foreign_term",
                  "value": "hverandre",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ". Back to the same person points to "
                },
                {
                  "kind": "foreign_term",
                  "value": "seg",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": "."
                }
              ]
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Maria og Ali sender meldinger til hverandre."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Maria and Ali send messages to each other."
            }
          ]
        }
      ]
    },
