{
  "schema_version": "3.0",
  "key": "reciprocal_pronouns",
  "concept_slug": "reciprocal_pronouns",
  "grounding_mode": "fallback_no_wiki",
  "title": "Saying Each Other with hverandre",
  "cefr_level": "B1",
  "goal": "Use hverandre to describe actions shared between two or more people.",
  "elements": [
    {
      "kind": "section",
      "role": "orient",
      "title": "The Core Meaning",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A reciprocal pronoun shows that two or more people do an action toward each other. In Bokmål, the main reciprocal pronoun is "
            },
            {
              "kind": "foreign_term",
              "value": "hverandre",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". It normally points back to a plural subject, such as "
            },
            {
              "kind": "foreign_term",
              "value": "vi",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "dere",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "de",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", or two named people."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "hverandre",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when the meaning is each other or one another."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "De møter hverandre på kafeen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "They meet each other at the cafe."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi hjelper hverandre med leksene."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We help each other with the homework."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Lærerne kjenner hverandre godt."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The teachers know each other well."
            }
          ]
        }
      ]
    },
    {
      "kind": "exercise",
      "id": "ex_choose_meaning",
      "operation": "choose",
      "prompt": [
        {
          "kind": "text",
          "value": "Choose the sentence with reciprocal meaning."
        }
      ],
      "explanation": [
        {
          "kind": "text",
          "value": "Yes: "
        },
        {
          "kind": "foreign_term",
          "value": "hverandre",
          "lang": "no"
        },
        {
          "kind": "text",
          "value": " means that the action goes both ways between the people."
        }
      ],
      "payload": {
        "options": [
          {
            "option_id": "a",
            "text": "De kjenner hverandre.",
            "why": "Correct. The people know each other."
          },
          {
            "option_id": "b",
            "text": "De kjenner ham.",
            "why": "This means they know him, not each other."
          },
          {
            "option_id": "c",
            "text": "Han kjenner seg.",
            "why": "This points back to one person, not two people acting toward each other."
          }
        ],
        "answer_id": "a",
        "stem": [
          {
            "kind": "text",
            "value": "Which sentence means that the two people know each other?"
          }
        ]
      }
    },
    {
      "kind": "section",
      "role": "model",
      "title": "Where hverandre Goes",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "In a simple sentence, "
            },
            {
              "kind": "foreign_term",
              "value": "hverandre",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " usually comes after the verb. A verb is the verb in the sentence. When the verb normally needs a preposition, a small word such as with, to, or about, the preposition stays before "
            },
            {
              "kind": "foreign_term",
              "value": "hverandre",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "en"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Pattern"
