            ],
            [
              {
                "kind": "text",
                "value": "Bokmål example"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Meaning"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "verb plus hverandre"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "De møter hverandre i byen."
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "They meet each other in town."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "verb plus preposition plus hverandre"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "De snakker med hverandre hver dag."
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "They talk with each other every day."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "verb plus preposition plus hverandre"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Vi skriver til hverandre om helgen."
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "We write to each other on the weekend."
                }
              ]
            ]
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Keep the preposition that belongs with the verb: "
            },
            {
              "kind": "foreign_term",
              "value": "snakker med hverandre",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "skriver til hverandre",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "tenker på hverandre",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Barna leker med hverandre etter skolen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The children play with each other after school."
            }
          ]
        }
      ]
    },
