{
  "schema_version": "3.0",
  "key": "definite_articles",
  "concept_slug": "definite_articles",
  "grounding_mode": "fallback_no_wiki",
  "title": "Saying “the” with Norwegian Noun Endings",
  "cefr_level": "A1",
  "goal": "Use Norwegian definite noun endings for simple singular nouns and basic plural nouns.",
  "elements": [
    {
      "kind": "section",
      "role": "orient",
      "title": "The Goes on the End",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "In English, you usually put the before a noun. In Norwegian, the noun itself changes — you add an ending instead. That ending turns a general noun into a specific, known one, as in the car."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Norwegian usually says “the noun” by adding an ending to the noun: "
            },
            {
              "kind": "foreign_term",
              "value": "bil",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " becomes "
            },
            {
              "kind": "foreign_term",
              "value": "bilen",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Bilen er rød."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The car is red."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg ser huset."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I see the house."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "model",
      "title": "Singular Endings",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Singular means one item. Every Norwegian noun has a gender — masculine, feminine, or neuter — and that gender decides which definite ending it takes. Masculine nouns usually take "
            },
            {
              "kind": "foreign_term",
              "value": "-en",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", feminine nouns often take "
            },
            {
              "kind": "foreign_term",
              "value": "-a",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and neuter nouns take "
            },
            {
              "kind": "foreign_term",
              "value": "-et",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "no"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Noun phrase"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Plain form"
              }
            ],
            [
              {
                "kind": "text",
                "value": "With the"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "masculine"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "bil"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "bilen"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "feminine"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "dør"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "døra"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "neuter"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "hus"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "huset"
                }
              ]
            ]
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Døra er åpen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The door is open."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Huset er lite."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The house is small."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "note",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Many feminine nouns can also use the masculine pattern in Bokmål. You may see both "
                },
                {
                  "kind": "foreign_term",
                  "value": "døra",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " and "
                },
                {
                  "kind": "foreign_term",
                  "value": "døren",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ". For this lesson we'll stick with the feminine "
                },
                {
                  "kind": "foreign_term",
                  "value": "-a",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " ending whenever a noun is marked feminine, so the pattern stays clear."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "model",
      "title": "Basic Plural Definite",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "When a plural noun is definite, Norwegian commonly ends it with "
            },
            {
              "kind": "foreign_term",
              "value": "-ene",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " or "
            },
            {
              "kind": "foreign_term",
              "value": "-ne",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". These endings often correspond to English “the” plus a plural noun."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "-ene",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " with many plural nouns that end in a consonant: "
            },
            {
              "kind": "foreign_term",
              "value": "biler",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " becomes "
            },
            {
              "kind": "foreign_term",
              "value": "bilene",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". Use "
            },
            {
              "kind": "foreign_term",
              "value": "-ne",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when the plural form already ends in "
            },
            {
              "kind": "foreign_term",
              "value": "-e",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ": "
            },
            {
              "kind": "foreign_term",
              "value": "lærere",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " becomes "
            },
            {
              "kind": "foreign_term",
              "value": "lærerne",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Bilene er nye."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The cars are new."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Studentene er her."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The students are here."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Lærerne er her."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The teachers are here."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "recap",
      "title": "What to Check",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "When you want to say “the” with a Norwegian noun, first check whether the noun is singular or plural. Then choose the ending that matches the noun."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "text",
                "value": "Masculine singular: "
              },
              {
                "kind": "foreign_term",
                "value": "-en",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": ", as in "
              },
              {
                "kind": "foreign_term",
                "value": "bilen",
                "lang": "no"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Feminine singular: "
              },
              {
                "kind": "foreign_term",
                "value": "-a",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": ", as in "
              },
              {
                "kind": "foreign_term",
                "value": "døra",
                "lang": "no"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Neuter singular: "
              },
              {
                "kind": "foreign_term",
                "value": "-et",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": ", as in "
              },
              {
                "kind": "foreign_term",
                "value": "huset",
                "lang": "no"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Basic plural definite: "
              },
              {
                "kind": "foreign_term",
                "value": "-ene",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " after many consonant-ending plurals, as in "
              },
              {
                "kind": "foreign_term",
                "value": "bilene",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": ", and "
              },
              {
                "kind": "foreign_term",
                "value": "-ne",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " after plural forms ending in "
              },
              {
                "kind": "foreign_term",
                "value": "-e",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": ", as in "
              },
              {
                "kind": "foreign_term",
                "value": "lærerne",
                "lang": "no"
              }
            ]
          ]
        }
      ]
    },
