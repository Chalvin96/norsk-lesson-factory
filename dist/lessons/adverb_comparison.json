      "title": "Longer Adverbs",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Some adverbs are longer or are phrases. With these, Norwegian often uses "
            },
            {
              "kind": "foreign_term",
              "value": "mer",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for more and "
            },
            {
              "kind": "foreign_term",
              "value": "mest",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for most instead of adding an ending."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "mer",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus the adverb for more, and "
