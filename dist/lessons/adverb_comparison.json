              "kind": "text",
              "value": "The teacher explains most clearly."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "tip",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "For everyday short adverbs, a one word form is often best: "
                },
                {
                  "kind": "foreign_term",
                  "value": "fortere",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " sounds natural, while "
                },
                {
                  "kind": "foreign_term",
                  "value": "mer fort",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " does not."
                }
              ]
            }
          ]
        }
      ]
    },
