{
  "schema_version": "3.0",
  "key": "adverb_comparison",
  "concept_slug": "adverb_comparison",
  "grounding_mode": "fallback_no_wiki",
  "title": "Comparing How Actions Happen",
  "cefr_level": "A2",
  "goal": "Compare actions with Norwegian adverbs such as fortere, bedre, best, mer, mest, and verst.",
  "elements": [
    {
      "kind": "section",
      "role": "orient",
      "title": "Compare the Action",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "An adverb is a word that describes how an action happens. In Norwegian, you can compare actions too: one person can run faster, speak more clearly, or work best. This lesson is about comparing actions, not describing nouns."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use adverb comparison when the question is how the action happens: runs faster, speaks most clearly, works best."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Sara løper fortere enn meg."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Sara runs faster than me."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Han forklarer bedre i dag."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "He explains better today."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "note",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "The word "
                },
                {
                  "kind": "foreign_term",
                  "value": "enn",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " means than when you compare two actions."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "model",
      "title": "Short Adverbs",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Many short adverbs use a comparative form to mean more than another action, and a superlative form to mean the most. Comparative means the form for comparing two things. Superlative means the form for the highest degree in a group."
            }
          ]
        },
