{
  "schema_version": "3.0",
  "key": "formal_subordination",
  "concept_slug": "formal_subordination",
  "grounding_mode": "fallback_no_wiki",
  "title": "Dense Written Subordinate Clauses in Bokmål",
  "cefr_level": "B2",
  "goal": "Use subordinate clauses with correct word order, linking, and nesting in denser written Bokmål.",
  "elements": [
    {
      "kind": "section",
      "role": "orient",
      "title": "What Dense Subordination Does",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Denser written Bokmål often packs information into subordinate clauses: dependent clauses that cannot stand alone as complete sentences. The main job is not to sound old-fashioned; it is to make relations between ideas precise while keeping modern, natural word order."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "In a subordinate clause, the sentence adverb, such as "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "aldri",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", or "
            },
            {
              "kind": "foreign_term",
              "value": "ofte",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", normally comes before the finite verb."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Departementet bekrefter at saken ikke er avsluttet."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The ministry confirms that the case has not been closed."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Dersom avtalen ikke blir godkjent, må partene møtes på nytt."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "If the agreement is not approved, the parties must meet again."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "warning",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Do not move "
                },
                {
                  "kind": "foreign_term",
                  "value": "ikke",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " after the finite verb just because English does. In subordinate clauses, write "
                },
                {
                  "kind": "foreign_term",
                  "value": "at saken ikke er avsluttet",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ", not "
                },
                {
                  "kind": "foreign_term",
                  "value": "at saken er ikke avsluttet",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": "."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "model",
      "title": "Choosing the Linker",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The linker tells the reader how the clause relates to the rest of the sentence. Even in denser writing, the same familiar linkers do the job: "
            },
            {
              "kind": "foreign_term",
              "value": "at",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " reports content, "
            },
            {
              "kind": "foreign_term",
              "value": "dersom",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " gives a condition, "
            },
            {
              "kind": "foreign_term",
              "value": "selv om",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " gives a concession, and "
            },
            {
              "kind": "foreign_term",
              "value": "som",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " introduces a relative clause: a clause that describes a noun."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "no",
            "en",
            "no"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Linker"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Use"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Pattern"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "at"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "content after saying, thinking, showing, confirming"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "viser at tiltaket ikke virker"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "dersom"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "condition, often more formal than hvis"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "dersom fristen ikke forlenges"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "selv om"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "concession: something is true despite another fact"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "selv om tallene ikke er endelige"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "som"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "relative clause describing a noun"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "forslaget som ikke kommer til behandling"
                }
              ]
            ]
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Rapporten viser at ordningen ikke fungerer etter hensikten."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The report shows that the scheme does not work as intended."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Selv om gruppen ikke har levert en endelig rapport, er prosjektet avsluttet."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Although the group has not submitted a final report, the project is finished."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "contrast",
      "title": "Relative Clauses with Som",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A relative clause can identify or describe a noun in a compact way. In written Bokmål, "
            },
            {
              "kind": "foreign_term",
              "value": "som",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is the normal linker for people, things, and abstract nouns. The same subordinate word order applies inside the relative clause."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "After "
            },
            {
              "kind": "foreign_term",
              "value": "som",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", place "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " before the finite verb: "
            },
            {
              "kind": "foreign_term",
              "value": "som ikke kommer",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "som ikke gjelder",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "som ikke kan brukes",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Dokumenter som ikke kommer innen fristen, blir ikke vurdert."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Documents that do not arrive by the deadline will not be considered."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Et forslag som ikke kan begrunnes skriftlig, bør utsettes."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "A proposal that cannot be justified in writing should be postponed."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "note",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "The relative clause belongs tightly to the noun it describes. Keep it close to that noun so the reader can see exactly what "
                },
                {
                  "kind": "foreign_term",
                  "value": "som",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " refers to."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "model",
      "title": "Nested Clauses Without Losing the Main Line",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Dense written sentences may contain one subordinate clause inside another. Read them by finding the main clause first, then working outward to the clauses attached to it. A main clause can stand alone as a sentence and keeps normal main-clause word order."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Each subordinate clause keeps its own subordinate word order, even when it is nested inside another subordinate clause."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Skolen mener at oppgaver som ikke er fullstendige, ikke bør vurderes før innleveringsfristen har gått ut."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The school holds that assignments that are not complete should not be assessed after the submission deadline has passed."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Dersom en ansatt som ikke har fått opplæring, gjør en feil, må virksomheten dokumentere hvilke rutiner som gjaldt."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "If an employee who has not received training makes a mistake, the organization must document which procedures applied."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Notice the repeated pattern: "
            },
            {
              "kind": "foreign_term",
              "value": "som ikke har fått",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " and "
            },
            {
              "kind": "foreign_term",
              "value": "hvilke rutiner som gjaldt",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " are subordinate clauses, while "
            },
            {
              "kind": "foreign_term",
              "value": "må virksomheten dokumentere",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is the main-clause frame after the opening condition."
            }
          ]
        }
      ]
    },
    {
      "kind": "section",
      "role": "recap",
      "title": "Keep the Written Sentence Clear",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "When you write denser Bokmål, choose the linker first, then check the word order inside every subordinate clause. This gives you precise sentences without drifting into stiff or archaic style."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": true,
          "items": [
            [
              {
                "kind": "text",
                "value": "Use "
              },
              {
                "kind": "foreign_term",
                "value": "at",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " for reported or stated content."
              }
            ],
            [
              {
                "kind": "text",
                "value": "Use "
              },
              {
                "kind": "foreign_term",
                "value": "dersom",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " for formal conditions."
              }
            ],
            [
              {
                "kind": "text",
                "value": "Use "
              },
              {
                "kind": "foreign_term",
                "value": "selv om",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " for contrast despite a fact."
              }
            ],
            [
              {
                "kind": "text",
                "value": "Use "
              },
              {
                "kind": "foreign_term",
                "value": "som",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " to attach a relative clause to a noun."
              }
            ],
            [
              {
                "kind": "text",
                "value": "Put sentence adverbs such as "
              },
              {
                "kind": "foreign_term",
                "value": "ikke",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " before the finite verb inside the subordinate clause."
              }
            ]
          ]
        }
      ]
    },
