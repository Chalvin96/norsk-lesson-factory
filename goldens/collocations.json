{
  "key": "collocations",
  "concept_slug": "collocations",
  "grounding_mode": "fallback_no_wiki",
  "title": "Natural Collocations in Norwegian",
  "cefr_level": "B2",
  "goal": "Recognise and use common Norwegian verb+noun, adjective+noun, and preposition-bound word pairings; avoid direct L1 transfer where it sounds unnatural; and understand that some alternatives are possible but have different frequency, style or meaning.",
  "elements": [
    {
      "element_kind": "section",
      "id": "s1",
      "role": "orient",
      "objective_ids": [
        "o1"
      ],
      "title": "Words prefer company",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A collocation is a natural word pairing: words that speakers often choose together. Collocations are not always strict grammar rules. Often another phrase is understandable, but one combination sounds more idiomatic, precise or common."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun stilte et spørsmål og tok en beslutning etter møtet."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She asked a question and made a decision after the meeting."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Do not translate every verb directly from English. Norwegian often uses "
            },
            {
              "kind": "foreign_term",
              "value": "ta, gjøre, stille, ha, få, gi",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " and "
            },
            {
              "kind": "foreign_term",
              "value": "holde",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " differently from English make, do, ask, have, get, give and hold/keep."
            }
          ]
        }
      ]
    },
