            {
              "kind": "foreign_term",
              "value": "Ta en beslutning",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is common and neutral; "
            },
            {
              "kind": "foreign_term",
              "value": "fatte en beslutning",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is more formal; "
            },
            {
              "kind": "foreign_term",
              "value": "bestemme seg",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is often more personal and less bureaucratic. Good collocation learning means choosing the phrase that fits the sentence, not memorising one only correct answer."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Kommunen har fattet en beslutning, men jeg har ikke bestemt meg ennå."
