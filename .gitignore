*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv
node_modules/
# Local runtime may expose node_modules as a symlink.
node_modules

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment
.env
.env.local

# Temp artifacts
*.tmp
*.log
tmp/
generated/

# dist/ contains final lesson JSON payloads -- track them, ignore everything else
dist/*
!dist/catalog.json
!dist/manifest.json
!dist/lessons/
!dist/lessons/**
!dist/schema/
!dist/schema/**

# Raw and source corpora are local artifacts
content/raw/*
!content/raw/.gitkeep
content/source/*
!content/source/.gitkeep
content/processed/

# Generated internal lesson outputs
content/lessons/*.json

# Local pipeline artifacts: per-lesson stage outputs, routing/retrieval
# reports. Regenerable; kept out of the tree. .logs/ for run logs likewise.
content/artifacts/*
!content/artifacts/.gitkeep
.logs/

# Snapshot/benchmark directories for local before/after comparisons
.benchmarks/

# Generated local reports
reports/

# Local object store (regenerable cache; top-level only, not src/ or tests/ packages)
/store/

# Playwright MCP
.playwright-mcp/

# Generated curriculum audit artifact
content/curriculum/structure_audit.json

# Design docs / implementation plans (kept local, not published)
docs/superpowers/plans/
docs/superpowers/specs/
plans/

# Historical local planning artifacts; current behavior belongs in knowledge/.

# Internal working docs (process logs, WIP roadmaps, raw design Q&A) — kept local
docs/TODO.md
docs/PROGRESS.md
docs/ROADMAP.md
docs/SYSTEM_WALKTHROUGH_QA.md
docs/PIPELINE_DESIGN_QA.md
docs/ARCHITECTURE_ASSESSMENT.md
docs/REDESIGN_NOTES.md

# Pinned extractions: local determinism artifact (re-create with
# `build pin-extraction <slug>`), kept out of the tree.
data/extractions/

# Generated local dictionary/cache artifacts. The Ordbokene/norsk-lexicon release
# is a dependency for local gates, but is too large to keep in this repo.
data/cache.db
data/lexicon/

# Local Claude Code agent state
.claude/

# LangGraph local runtime state
.langgraph_api/

# Exported Promptfoo results (opt-in local artifacts, never committed)
evals/promptfoo/results/
