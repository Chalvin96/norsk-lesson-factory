# OpenRouter API configuration
OPENROUTER_API_KEY=your-api-key-here

# Global default model (used by wiki, audit, and general stages)
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Lesson generation model (defaults to google/gemini-2.5-flash if unset)
# OPENROUTER_LESSON_MODEL=google/gemini-2.5-flash

# LLM backend: "openrouter" (default), "opencode", "codex", or "pi"
# When using opencode/codex/pi, OPENROUTER_API_KEY is not required for those calls
LLM_BACKEND=codex
OPENCODE_MODEL=openai/gpt-5.4-mini
CODEX_MODEL=gpt-5.5

# Optional Pi coding agent backend. Do not use as Phase 1 default unless re-benchmarked.
PI_PROVIDER=openai-codex
PI_MODEL=gpt-5.5
PI_THINKING=off
PI_TIMEOUT_SECONDS=120
