# OpenCode runtime configuration. Select the model/provider in config.yaml
# under llm.tiers.*.model; authentication is owned by OpenCode.
OPENCODE_EXECUTION_MODE=parallel
# OPENCODE_TEMP_ROOT=/path/to/private/runtime-directory

# Audio publication to an S3-compatible object store.
# Endpoint and bucket are public deployment configuration; credentials are secret.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# S3_OBJECT_ACL=public-read

LESSON_AUDIO_SERVICE_ACCOUNT=
LESSON_AUDIO_PUBLIC_BASE_URL=https://media.umebocchi.my.id
