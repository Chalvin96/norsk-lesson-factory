      "title": "The Last Noun Controls the Ending",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The final noun is the main noun in the compound. It decides the gender, such as masculine, feminine, or neuter, and the inflection: the ending that shows definite or plural."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "In a compound noun, put definite and plural endings on the final noun."
            }
