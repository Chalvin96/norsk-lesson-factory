      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [],
      "title": "One Idea, One Written Word",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A compound noun is one noun made from two or more words. Norwegian usually writes these as one word, even where English often uses two words."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Write a Norwegian compound noun as one word: "
            },
            {
              "kind": "foreign_term",
              "value": "matbutikk",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", not "
            },
            {
              "kind": "foreign_term",
              "value": "mat butikk",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg går til en matbutikk."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I am going to a grocery store."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun jobber i en barnehage."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She works in a kindergarten."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi går på norskkurs på mandager."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We attend a Norwegian course on Mondays."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The first part narrows the meaning of the last part. A "
            },
            {
              "kind": "foreign_term",
              "value": "matbutikk",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is a kind of "
            },
            {
              "kind": "foreign_term",
              "value": "butikk",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". A "
            },
            {
              "kind": "foreign_term",
              "value": "norskkurs",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is a kind of "
            },
            {
              "kind": "foreign_term",
              "value": "kurs",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        }
      ]
    },
