{
  "key": "compound_nouns",
  "concept_slug": "compound_nouns",
  "grounding_mode": "fallback_no_wiki",
  "title": "Building Norwegian Compound Nouns as One Word",
  "cefr_level": "A2",
  "goal": "Write common Norwegian compound nouns as one word and inflect the final noun correctly.",
  "objectives": [
    {
      "id": "obj_one_word",
      "statement": "Recognize that Norwegian compound nouns are normally written as one word.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_final_noun",
      "statement": "Use the final noun to decide gender and endings in a compound noun.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_linking",
      "statement": "Recognize common linking elements in compounds without treating them as universal rules.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_produce",
      "statement": "Build and correct simple compound nouns in everyday sentences.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
