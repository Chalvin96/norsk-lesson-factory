      ],
      "title": "Linking Sounds",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Some compounds use a small linking element between the parts. A linking element is a sound or letter added to connect the two parts. The common one you will see often is "
            },
            {
              "kind": "foreign_term",
              "value": "s",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", but it is not added to every compound."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Learn common compounds as whole words; do not automatically add "
            },
            {
              "kind": "foreign_term",
              "value": "s",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " between the parts."
            }
          ]
        },
