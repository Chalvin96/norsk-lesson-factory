{
  "key": "modal_verbs_basic",
  "concept_slug": "modal_verbs_basic",
  "grounding_mode": "fallback_no_wiki",
  "title": "Using kan, vil, må, and skal",
  "cefr_level": "A1",
  "goal": "Build simple sentences with kan, vil, må, and skal plus a bare infinitive.",
  "objectives": [
    {
      "id": "obj_meaning",
      "statement": "Recognize the basic everyday meanings of kan, vil, må, and skal.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_pattern",
      "statement": "Use modal verb plus bare infinitive in simple main clauses.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_negation_question",
      "statement": "Place ikke and the subject correctly in simple modal sentences and questions.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [
        "obj_meaning"
      ],
      "title": "Four useful modal verbs",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian often uses modal verbs to add meanings like ability, wish, need, or plan. Four common forms are "
            },
            {
              "kind": "foreign_term",
              "value": "kan",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "vil",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "må",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and "
            },
            {
              "kind": "foreign_term",
              "value": "skal",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "foreign_term",
                "value": "kan",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " means can or be able to."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "vil",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " means want to or will, often about what someone wants."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "må",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " means must or have to."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "skal",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " often points to a plan, arrangement, or something someone is going to do."
              }
            ]
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg kan norsk."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I know Norwegian."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg vil ha kaffe."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I want coffee."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Du må gå nå."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "You have to go now."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi skal spise."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We are going to eat."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_001",
      "role": "model",
      "objective_ids": [
        "obj_pattern"
      ],
      "title": "Modal verb plus bare infinitive",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "When a modal verb helps another verb, the next verb is a bare infinitive: the plain form without "
            },
            {
              "kind": "foreign_term",
              "value": "å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use this pattern in a statement: subject plus modal verb plus bare infinitive."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg kan komme."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I can come."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun vil lese."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She wants to read."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi må vente."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We have to wait."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "De skal reise."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "They are going to travel."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "tip",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "The bare infinitive stays simple: "
                },
                {
                  "kind": "foreign_term",
                  "value": "komme",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ", "
                },
                {
                  "kind": "foreign_term",
                  "value": "lese",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ", "
                },
                {
                  "kind": "foreign_term",
                  "value": "vente",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ", "
                },
                {
                  "kind": "foreign_term",
                  "value": "reise",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": "."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_002",
      "role": "contrast",
      "objective_ids": [
        "obj_negation_question"
      ],
      "title": "Negatives and questions",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "In a negative statement, "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " normally comes right after the modal verb. The second verb still stays as a bare infinitive: the plain form without å."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Negative pattern: subject plus modal verb plus ikke plus bare infinitive."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg kan ikke komme."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I cannot come."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi må ikke vente."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We must not wait."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "In a yes or no question, the modal verb comes first, then the subject, then the bare infinitive."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Question pattern: modal verb plus subject plus bare infinitive."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Kan du komme?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Can you come?"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Skal vi spise?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Are we going to eat?"
            }
          ]
        }
      ]
    },
    {
