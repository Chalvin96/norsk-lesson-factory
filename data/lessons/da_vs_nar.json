      "role": "contrast",
      "objective_ids": [
        "obj_word_order"
      ],
      "title": "Word order with time clauses",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Both "
