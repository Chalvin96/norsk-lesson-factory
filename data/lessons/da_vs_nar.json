{
  "key": "da_vs_nar",
  "concept_slug": "da_vs_nar",
  "grounding_mode": "fallback_no_wiki",
  "title": "Da or når for when",
  "cefr_level": "A2",
  "goal": "Choose da for one specific past time and når for future or repeated time.",
  "objectives": [
    {
      "id": "obj_da_specific_past",
      "statement": "Use da for one specific time or period in the past.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_nar_future_habit",
      "statement": "Use når for future, habitual, and repeated time.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_word_order",
      "statement": "Place the finite verb correctly in sentences with da and når time clauses.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [
        "obj_da_specific_past",
        "obj_nar_future_habit"
      ],
      "title": "Two kinds of when",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "English uses one word, when, for several time meanings. Norwegian separates two common meanings: one specific time in the past, and a time that is future, usual, or repeated."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "da",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for one specific time or period in the past. Use "
            },
            {
              "kind": "foreign_term",
              "value": "når",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for future time, habitual time, or repeated time."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Da jeg kom hjem, laget jeg middag."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "When I came home, I made dinner."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Når jeg kommer hjem, lager jeg middag."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "When I come home, I make dinner."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_001",
      "role": "model",
      "objective_ids": [
        "obj_da_specific_past"
      ],
      "title": "Da points back",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "da",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when you mean one concrete past event or one past period you are looking back on. The time clause is the part of the sentence that gives the time, such as when I arrived."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Da vi bodde i Oslo, tok vi trikken hver dag."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "When we lived in Oslo, we took the tram every day."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Da hun var barn, spilte hun fotball."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "When she was a child, she played football."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "tip",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "A past period can still take "
                },
                {
                  "kind": "foreign_term",
                  "value": "da",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " if you present it as one remembered time: childhood, last summer, or the years you lived somewhere."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_002",
      "role": "contrast",
      "objective_ids": [
        "obj_nar_future_habit"
      ],
      "title": "Når looks forward or repeats",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "når",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when the time is in the future, or when something happens normally, often, or every time a condition is true."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Når bussen kommer, går vi på."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "When the bus comes, we get on."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Når jeg er trøtt, drikker jeg kaffe."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "When I am tired, I drink coffee."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg ringer deg når møtet er ferdig."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I will call you when the meeting is finished."
            }
          ]
        }
      ]
    },
    {
