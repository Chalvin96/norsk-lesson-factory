            ],
            [
              [
                {
                  "kind": "text",
                  "value": "future or repeated"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Når jeg kommer hjem, lager jeg mat."
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Jeg lager mat når jeg kommer hjem."
                }
              ]
            ]
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "With "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " inside the dependent clause, put "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " before the finite verb in that time clause."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Når jeg ikke jobber, går jeg en tur."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "When I am not working, I go for a walk."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Da jeg ikke hadde penger, tok jeg bussen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "When I did not have money, I took the bus."
            }
          ]
        }
      ]
    },
