              "kind": "foreign_term",
              "value": "når",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " introduce a time clause. If the time clause comes first, the main clause starts with the verb right after the comma."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "no"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Meaning"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Time clause first"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Main clause first"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "specific past"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Da jeg kom hjem, laget jeg mat."
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Jeg laget mat da jeg kom hjem."
                }
