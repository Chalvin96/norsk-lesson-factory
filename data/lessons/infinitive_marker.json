{
  "key": "infinitive_marker",
  "concept_slug": "infinitive_marker",
  "grounding_mode": "fallback_no_wiki",
  "title": "Using å Before the Infinitive",
  "cefr_level": "A1",
  "goal": "Use å before infinitives, but leave it out after modal verbs.",
  "objectives": [
    {
      "id": "obj_infinitive_marker_form",
      "statement": "Recognize å as the infinitive marker before the base verb form.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_infinitive_after_like",
      "statement": "Use å + infinitive after simple verbs such as liker.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_no_marker_after_modal",
      "statement": "Choose the bare infinitive after modal verbs such as kan and skal.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_purpose_for_aa",
      "statement": "Use for å + infinitive to express a simple purpose.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [
        "obj_infinitive_marker_form"
      ],
      "title": "What å Does",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "In Norwegian, many dictionary verb forms appear with "
            },
            {
              "kind": "foreign_term",
              "value": "å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " before it. The word "
            },
            {
              "kind": "foreign_term",
              "value": "å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is the small word before the base verb form. The grammar name is infinitive marker."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " before the base verb when another word is not already showing tense."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "å lese"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "to read"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "å spise"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "to eat"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "å gå"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "to go"
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_001",
      "role": "model",
      "objective_ids": [
        "obj_infinitive_after_like"
      ],
      "title": "After liker",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "After some common verbs, Norwegian uses "
            },
            {
              "kind": "foreign_term",
              "value": "å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " before the next verb. A useful first pattern is "
            },
            {
              "kind": "foreign_term",
              "value": "liker å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ": like to."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "liker å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " before an infinitive: "
            },
            {
              "kind": "foreign_term",
              "value": "Jeg liker å lese.",
              "lang": "no"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg liker å lese."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I like to read."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun liker å lage mat."
