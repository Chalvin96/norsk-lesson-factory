    {
      "element_kind": "section",
      "id": "imported_section_003",
      "role": "model",
      "objective_ids": [
        "obj_purpose_for_aa"
      ],
      "title": "Purpose with for å",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "To say why someone does something, Norwegian often uses "
            },
            {
              "kind": "foreign_term",
              "value": "for å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " before the infinitive. This matches English expressions like in order to or to."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "for å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus an infinitive to give a purpose."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg går hjem for å spise."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I am going home to eat."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Han lærer norsk for å snakke med venner."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "He is learning Norwegian to speak with friends."
            }
          ]
        }
      ]
    },
