            }
          ]
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "foreign_term",
                "value": "Jeg liker å lese.",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " means I like to read."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "Jeg kan lese.",
