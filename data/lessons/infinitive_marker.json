      "role": "contrast",
      "objective_ids": [
        "obj_no_marker_after_modal"
      ],
      "title": "After Modal Verbs",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Some small verbs, called modal verbs, are like can, shall, will, must, or want to. In Norwegian, common modal verbs include "
            },
            {
              "kind": "foreign_term",
              "value": "kan",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " and "
            },
            {
              "kind": "foreign_term",
              "value": "skal",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". After a modal verb, the next verb is a bare infinitive, the plain form without "
            },
            {
              "kind": "foreign_term",
              "value": "å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "After a modal verb, do not use "
            },
            {
              "kind": "foreign_term",
              "value": "å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ": "
            },
            {
              "kind": "foreign_term",
              "value": "kan lese",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "skal gå",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "no"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Pattern"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Use"
              }
