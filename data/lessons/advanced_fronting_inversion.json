{
  "key": "advanced_fronting_inversion",
  "concept_slug": "advanced_fronting_inversion",
  "grounding_mode": "fallback_no_wiki",
  "title": "Fronted Phrases and Verb-Second Inversion",
  "cefr_level": "B2",
  "goal": "Place the finite verb correctly after fronted phrases in main clauses, without carrying that inversion into subordinate clauses.",
  "objectives": [
    {
      "id": "obj_v2_fronting",
      "statement": "Recognize that a fronted non-subject phrase in a main clause triggers verb-second word order.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_negative_fronting",
      "statement": "Use inversion after fronted negative and restrictive expressions such as aldri, sjelden, ingen, heller ikke, and knapt.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_subordinate_boundary",
      "statement": "Keep subordinate clause word order after subordinators, even when the clause contains a negative or adverbial element.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [
        "obj_v2_fronting"
      ],
      "title": "What Moves, What Stays",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian main clauses often use verb-second word order. A main clause is a clause that can stand as a complete sentence, and the finite verb is the finite verb, such as "
            },
            {
              "kind": "foreign_term",
              "value": "kommer",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "kom",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", or "
            },
            {
              "kind": "foreign_term",
              "value": "har",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". When you put something other than the subject first, the finite verb still comes in second position."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "In a main clause, a fronted non-subject phrase takes position 1, the finite verb takes position 2, and the subject comes after the verb."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "I morgen kommer sjefen tidlig."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Tomorrow the boss is coming early."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "På skolen snakker barna norsk."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "At school the children speak Norwegian."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Boken la jeg på bordet."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I put the book on the table."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "no",
            "no"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Position"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Fronted phrase"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Finite verb"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Subject and rest"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "Time first"
                }
              ],
              [
                {
