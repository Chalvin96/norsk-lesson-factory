    },
    {
      "element_kind": "section",
      "id": "imported_section_002",
      "role": "contrast",
      "objective_ids": [
        "obj_uncertainty_inference"
      ],
      "title": "Opinion Frames and Informal Approximation",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "When you want to make the speaker visible, use an explicit opinion frame. These frames are useful in discussion, writing, and disagreement because they show that you are presenting a view rather than a bare fact."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg tror løsningen blir for dyr."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I think the solution will be too expensive."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg mener at forslaget bør endres."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I believe that the proposal should be changed."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Etter min mening er dette den beste løsningen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "In my opinion, this is the best solution."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "foreign_term",
              "value": "Jeg tror",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " often presents a belief, estimate, or uncertain conclusion. "
            },
            {
              "kind": "foreign_term",
              "value": "Jeg mener",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is stronger and often introduces a considered opinion. "
            },
            {
              "kind": "foreign_term",
              "value": "Etter min mening",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is more explicit and fits formal or careful argument."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "foreign_term",
              "value": "Liksom",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is different. In informal speech, it can soften or approximate what you say, a bit like kind of or like in English. It is common in conversation, but it usually sounds too casual in formal writing."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det ble liksom litt uklart mot slutten."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "It got kind of unclear toward the end."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "warning",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Avoid "
                },
                {
                  "kind": "foreign_term",
                  "value": "liksom",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " in applications, reports, academic writing, and formal emails unless you are quoting speech."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_003",
      "role": "model",
      "objective_ids": [
        "obj_uncertainty_inference"
      ],
      "title": "Natural Position in the Clause",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "In a main clause, a finite verb normally stays in second position. Many short stance markers can stand after the finite verb, especially when they comment on the whole statement."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det blir nok vanskelig."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "It will probably be difficult."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Du har vel tid i morgen?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "You have time tomorrow, I suppose?"
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "foreign_term",
              "value": "Kanskje",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is flexible. It can stand first, but then the finite verb still comes right after it in a main clause."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Kanskje kommer de senere."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Maybe they will come later."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "De kommer kanskje senere."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "They may come later."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "For clear, natural Norwegian, choose the marker that matches your stance and place it where it comments on the whole clause."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
