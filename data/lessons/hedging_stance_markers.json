            },
            {
              "kind": "text",
              "value": " for a shared assumption or soft check, "
            },
            {
              "kind": "foreign_term",
              "value": "visst",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for apparently or I hear, and "
            },
            {
              "kind": "foreign_term",
              "value": "sikkert",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for a confident probably."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Use opinion frames when the source is your own judgment. Keep "
            },
            {
              "kind": "foreign_term",
              "value": "liksom",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for informal speech and choose a cleaner formulation in formal writing."
            }
          ]
        }
      ]
    },
