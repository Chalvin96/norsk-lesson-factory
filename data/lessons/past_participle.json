{
  "key": "past_participle",
  "concept_slug": "past_participle",
  "grounding_mode": "fallback_no_wiki",
  "title": "Past participle forms in Norwegian",
  "cefr_level": "A2",
  "goal": "Recognize and use common Norwegian past participles, including adjective endings before nouns.",
  "objectives": [
    {
      "id": "obj_form_inventory",
      "statement": "Identify common weak and strong past participle forms.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_compound_uninflected",
      "statement": "Use the uninflected past participle after an auxiliary verb in a compound tense.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_adjective_agreement",
      "statement": "Choose the right participle form when it works as an adjective before a noun.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [
        "obj_form_inventory"
      ],
      "title": "What a past participle is",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian often uses a special verb form after har or er, and sometimes before a noun like an adjective. The grammar name is past participle. English has similar forms: washed, bought, lived, gone, and written."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "A past participle does not show the time by itself. Another verb, often har or er, does that job."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Koppen er vasket."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The cup is washed."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg har kjøpt en billett."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I have bought a ticket."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "In forms like har kjøpt, har shows the time. The participle keeps its basic participle form."
            }
          ]
        }
      ]
    },
