      "title": "After an auxiliary verb",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "When the participle comes after an auxiliary verb, the auxiliary verb shows the tense. The participle does not change for gender or number."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "After an auxiliary verb, use the uninflected past participle: "
            },
            {
              "kind": "foreign_term",
              "value": "har vasket",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "har kjøpt",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "har gått",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
