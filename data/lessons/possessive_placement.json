{
  "key": "possessive_placement",
  "concept_slug": "possessive_placement",
  "grounding_mode": "fallback_no_wiki",
  "title": "Where to Put Possessives in Norwegian",
  "cefr_level": "A2",
  "goal": "Place Norwegian possessives before or after nouns with the right meaning and noun form.",
  "objectives": [
    {
      "id": "obj_neutral_after",
      "statement": "Recognize and use the neutral pattern with a definite noun followed by a possessive.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_emphatic_before",
      "statement": "Recognize when a possessive before an indefinite noun sounds contrastive or emphatic.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_egen_sin",
      "statement": "Use egen with possessives to express own, and notice sin without learning the full reflexive system here.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_diagnose_order",
      "statement": "Diagnose and correct common possessive placement errors in short noun phrases.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [
        "obj_neutral_after"
      ],
      "title": "The Usual Norwegian Order",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A possessive is a word such as my, your, his, or our. In everyday Bokmål, the most neutral pattern is to put the noun first in its definite form, then the possessive after it."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Neutral pattern: definite noun plus possessive, as in "
            },
            {
              "kind": "foreign_term",
              "value": "bilen min",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Bilen min står utenfor."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "My car is outside."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Huset mitt er lite."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "My house is small."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Telefonen hennes ligger på bordet."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Her phone is on the table."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The definite form is the Norwegian definite form of the noun: "
            },
            {
              "kind": "foreign_term",
              "value": "bil",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " becomes "
            },
            {
              "kind": "foreign_term",
              "value": "bilen",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and "
            },
            {
              "kind": "foreign_term",
              "value": "hus",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " becomes "
            },
            {
              "kind": "foreign_term",
              "value": "huset",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        }
      ]
    },
    {
