    {
      "element_kind": "section",
      "id": "imported_section_002",
      "role": "contrast",
      "objective_ids": [
        "obj_emphatic_before"
      ],
      "title": "Before the Noun Adds Emphasis",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian can also put the possessive before the noun. Then the noun is normally indefinite, so it does not have the definite suffix. This order is more marked: it often contrasts one owner with another or gives extra emphasis."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Emphatic pattern: possessive plus indefinite noun, as in "
            },
            {
              "kind": "foreign_term",
              "value": "min bil",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " or "
            },
            {
              "kind": "foreign_term",
              "value": "mitt hus",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Min bil står utenfor, ikke din."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "My car is outside, not yours."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Mitt hus er hvitt, men huset ditt er rødt."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "My house is white, but your house is red."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "tip",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Use the after-noun pattern for plain ownership. Use the before-noun pattern when you want the owner to stand out."
                }
              ]
            }
          ]
        }
      ]
    },
