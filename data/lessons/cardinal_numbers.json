      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "After numbers higher than one, use a plural noun, a noun form for more than one. The number stays the same; the noun changes."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Number plus noun usually means: number first, then the counted noun."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg kjøper fire epler."
            }
