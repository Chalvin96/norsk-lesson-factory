            {
              "kind": "foreign_term",
              "value": "en",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " with many masculine and feminine nouns in everyday Bokmål, and "
            },
            {
              "kind": "foreign_term",
              "value": "ett",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " with neuter nouns."
