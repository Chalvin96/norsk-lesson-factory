          ],
          "en": [
            {
              "kind": "text",
              "value": "We need five tickets."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Han har seks barn."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "He has six children."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "note",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Some plural noun forms are irregular. The key rule: put the number before the noun, and use the plural noun form when counting more than one."
