{
  "key": "adjective_as_adverb",
  "concept_slug": "adjective_as_adverb",
  "grounding_mode": "fallback_no_wiki",
  "title": "Using Adjectives to Describe Actions",
  "cefr_level": "A2",
  "goal": "Choose and place common Norwegian adjective-adverbs after verbs.",
  "objectives": [
    {
      "id": "obj_recognize_adverb_role",
      "statement": "Recognize when a Norwegian adjective is being used as an adverb to describe a verb.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_choose_form",
      "statement": "Choose the neuter -t form or unchanged common form when an adjective describes an action.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_place_after_verb",
      "statement": "Build short sentences with the adjective-adverb in a natural position after the verb or verb phrase.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_diagnose_errors",
      "statement": "Find and fix simple errors where an English-style form or noun-describing form is used for an action.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [
        "obj_recognize_adverb_role"
      ],
      "title": "The Core Idea",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "An adjective is a word that describes a noun, such as a person or thing. An adverb describes a verb and tells you how an action happens. In Norwegian, many adjective forms can also work as adverbs."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "When a Norwegian adjective describes a verb, it often uses the neuter form, the form that commonly ends in "
            },
            {
              "kind": "foreign_term",
              "value": "-t",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "English often adds "
            },
            {
              "kind": "text",
              "value": "-ly"
            },
            {
              "kind": "text",
              "value": " to make an adverb, as in beautiful to beautifully. Norwegian usually does not add a separate adverb ending like that. Instead, the adjective form itself does the job."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun synger vakkert."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She sings beautifully."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Han skriver pent."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "He writes neatly."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_001",
      "role": "model",
      "objective_ids": [
        "obj_choose_form"
      ],
      "title": "The Form You Use",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "For many short, common adjectives, the action-describing form is the same as the neuter form. That often means adding "
            },
            {
              "kind": "foreign_term",
              "value": "-t",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " to the basic adjective."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun danser pent."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She dances nicely."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "De spiller vakkert."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "They play beautifully."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Some very common words do not add a new ending when they describe the action. You learn these as fixed useful forms."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "foreign_term",
                "value": "rolig",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " can mean calmly or quietly when it describes an action."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "fort",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " means fast or quickly."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "bra",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " means well when it describes an action."
              }
            ]
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Snakk rolig, takk."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Speak calmly, please."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Bussen kjører fort."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The bus drives fast."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Du snakker tydelig."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "You speak clearly."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_002",
      "role": "model",
      "objective_ids": [
        "obj_place_after_verb"
      ],
      "title": "Where It Goes",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The adjective-adverb usually comes after the verb it describes. If the sentence has an object, the person or thing affected by the action, the adjective-adverb often comes after that object."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun leser rolig."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She reads calmly."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Han lager maten fort."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "He makes the food quickly."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi skriver navnet pent."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We write the name neatly."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "tip",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Ask what the word describes. If it describes a thing, it is an adjective. If it describes how someone does something, it is working as an adverb."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_003",
      "role": "contrast",
      "objective_ids": [
        "obj_recognize_adverb_role"
      ],
      "title": "Thing or Action",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The same English idea can look different depending on whether you describe a noun or a verb. Here you focus only on the verb-describing use."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det er en pen bok."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "It is a nice book."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun skriver pent."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She writes nicely."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Do not add an English-style "
            },
            {
              "kind": "text",
              "value": "-ly"
            },
            {
              "kind": "text",
              "value": " ending in Norwegian. Say "
            },
            {
              "kind": "foreign_term",
              "value": "vakkert",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", not a made-up form based on beautifully."
            }
          ]
        }
      ]
    },
