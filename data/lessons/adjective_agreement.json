{
  "key": "adjective_agreement",
  "concept_slug": "adjective_agreement",
  "grounding_mode": "fallback_no_wiki",
  "title": "Making adjectives agree with the noun",
  "cefr_level": "A1",
  "goal": "Choose the correct basic adjective ending for common-gender, neuter, and plural nouns.",
  "objectives": [
    {
      "id": "obj_indefinite_forms",
      "statement": "Recognize and choose the basic indefinite adjective forms: base form, -t, and -e.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_predicative_agreement",
      "statement": "Use basic adjective agreement after er with singular and plural nouns.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_diagnose_agreement",
      "statement": "Find and fix simple adjective agreement errors in short noun phrases and sentences.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
