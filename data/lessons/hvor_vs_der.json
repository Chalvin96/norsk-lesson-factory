{
  "key": "hvor_vs_der",
  "concept_slug": "hvor_vs_der",
  "grounding_mode": "fallback_no_wiki",
  "title": "Hvor or der: asking where and saying there",
  "cefr_level": "A2",
  "goal": "Use hvor for where-questions and der for there-statements with correct word order.",
  "objectives": [
    {
      "id": "obj_hvor_questions",
      "statement": "Recognize and form location questions with hvor.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_der_statements",
      "statement": "Use der to point to or refer to a place in statements.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_contrast_hvor_der",
      "statement": "Choose between hvor and der based on question versus statement meaning.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_v2_after_hvor",
      "statement": "Place the finite verb directly after hvor in main-clause questions.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [
        "obj_contrast_hvor_der"
      ],
      "title": "The Core Contrast",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian separates asking about a place from pointing to a place. Use "
            },
            {
              "kind": "foreign_term",
              "value": "hvor",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when you ask where something is. Use "
            },
            {
              "kind": "foreign_term",
              "value": "der",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when you say there or that place."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "foreign_term",
              "value": "Hvor",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " asks for a location; "
            },
            {
              "kind": "foreign_term",
              "value": "der",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " gives, points to, or refers back to a location."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hvor er biblioteket?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Where is the library?"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Biblioteket er der."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The library is there."
            }
          ]
        }
      ]
    },
    {
