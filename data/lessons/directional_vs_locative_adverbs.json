    {
      "element_kind": "section",
      "id": "imported_section_002",
      "role": "contrast",
      "objective_ids": [
        "obj_static_direction"
      ],
      "title": "Let the Verb Help You",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A verb is the action or state word in the sentence. Many verbs can guide your choice. State verbs like be, sit, live, and stand often need location. Movement verbs like come, go, travel, run, and put often need direction."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Katten er inne."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The cat is inside."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Katten løper inn."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The cat runs in."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "De står ute."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "They are standing outside."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "De går ut."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "They go out."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "tip",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Ask yourself: place or path? If it answers where, choose location. If it answers where to, choose direction."
                }
              ]
            }
          ]
        }
      ]
    },
