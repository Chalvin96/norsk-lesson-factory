{
  "key": "directional_vs_locative_adverbs",
  "concept_slug": "directional_vs_locative_adverbs",
  "grounding_mode": "fallback_no_wiki",
  "title": "Here or to Here: Norwegian Place and Direction Words",
  "cefr_level": "A2",
  "goal": "Choose the right Norwegian adverb for location or movement.",
  "objectives": [
    {
      "id": "obj_static_direction",
      "statement": "Tell whether a sentence needs a static location adverb or a direction adverb.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_core_pairs",
      "statement": "Use the pairs her/hit, der/dit, hjemme/hjem, inne/inn, and ute/ut correctly.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_produce_sentences",
      "statement": "Build short sentences with movement verbs and location verbs using the correct adverb.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [
        "obj_static_direction"
      ],
      "title": "The Main Choice",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian often uses two different adverbs for English words like here, there, in, and out. An adverb is a word that tells where, when, how, or how much. The key question is simple: are you saying where something is, or where something is going?"
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use a static location adverb for where someone or something is; use a direction adverb for movement toward a place."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg er her."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I am here."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Kom hit."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Come here."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "In the first sentence, there is no movement toward the speaker. In the second sentence, someone is moving toward the speaker."
            }
          ]
        }
      ]
    },
