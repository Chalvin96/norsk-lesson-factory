{
  "key": "imperative",
  "concept_slug": "imperative",
  "grounding_mode": "fallback_no_wiki",
  "title": "Give Simple Instructions",
  "cefr_level": "A1",
  "goal": "Form and understand simple Norwegian imperatives from common verbs.",
  "objectives": [
    {
      "id": "obj_form_stem",
      "statement": "Form the imperative by using the verb stem for regular -e verbs.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_short_verbs",
      "statement": "Recognize short verbs whose infinitive and imperative look the same after å is removed.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_use_no_subject",
      "statement": "Use the imperative without a subject in short commands and requests.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_negative_polite",
      "statement": "Understand simple negative and polite imperatives with ikke and vær så snill.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [],
      "title": "What the imperative does",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The imperative is the command or request form of a verb. You use it when you tell someone to do something, invite them to act, or give a short instruction."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "In Norwegian, a simple imperative usually stands alone without a subject, the person doing the action."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vent!"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Wait!"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Stopp!"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Stop!"
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "English often also uses no subject in commands: “Wait!” not “You wait!” Norwegian works the same way in the basic pattern."
            }
          ]
        }
      ]
    },
