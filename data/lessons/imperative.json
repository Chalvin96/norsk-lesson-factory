      ],
      "title": "No and please",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "To tell someone not to do something, put "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " after the imperative. This gives you a clear negative instruction."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use imperative + "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for “do not” commands."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vent ikke her!"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Do not wait here!"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Gå ikke dit!"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Do not go there!"
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "For a polite request, you can add "
            },
            {
              "kind": "foreign_term",
              "value": "vær så snill",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ": “please.” It can come after the instruction."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vent, vær så snill."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Wait, please."
            }
          ]
        },
        {
          "kind": "example",
