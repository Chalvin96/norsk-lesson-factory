    {
      "element_kind": "section",
      "id": "s4",
      "role": "model",
      "objective_ids": [
        "o1"
      ],
      "title": "Modal verbs in the past",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The modal verbs you met earlier ("
            },
            {
              "kind": "foreign_term",
              "value": "skal, vil, kan, må, bør",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ") also have their own preteritum forms. You'll see them often in reported speech and stories about the past."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "no",
            "no",
            "no"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Infinitiv"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Presens"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Preteritum"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "å skulle"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "skal"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "skulle"
                }
              ]
            ],
            [
