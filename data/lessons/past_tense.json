                  "kind": "text",
                  "value": "bor"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "bodde"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "har bodd"
                }
              ]
            ]
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Which ending a verb takes is mostly signalled by how its stem ends. Use this as a guide:"
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "no",
            "en",
            "no"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Ending"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Typically when the stem…"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Examples"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "-et"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "ends in a consonant cluster (two consonants)"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "vaske → vasket, snakke → snakket, jobbe → jobbet"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "-te"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "ends in an unvoiced consonant (p, t, k, s)"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "spise → spiste, kjøpe → kjøpte, lese → leste"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "-de"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "ends in a voiced consonant (v, g) or a diphthong (ei, øy)"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "leve → levde, prøve → prøvde, eie → eide"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "-dde"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "is a short verb ending in a stressed vowel"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "bo → bodde, tro → trodde, nå → nådde"
                }
              ]
            ]
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "The ending never changes for person or number — "
            },
            {
              "kind": "foreign_term",
              "value": "jeg snakket",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "vi snakket",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "These stem patterns are reliable tendencies, not a guaranteed rule — a few verbs break them. When you are unsure, learn the verb together with its preteritum form, or check a dictionary."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi kjøpte et hus for to år siden."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We bought a house two years ago."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Da jeg var liten, bodde jeg i Bergen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "When I was little, I lived in Bergen."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "s3",
      "role": "model",
      "objective_ids": [
        "o1"
      ],
      "title": "Common irregular verbs",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Many very common verbs have irregular preteritum forms. Some are strong verbs: they change the stem vowel and take no -t/-d past-tense ending, for example gå → gikk and se → så. Others are irregular weak verbs with special forms, for example ha → hadde and gjøre → gjorde. These are worth memorising because you'll use them constantly."
            }
          ]
        },
