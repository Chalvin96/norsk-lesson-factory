    {
      "element_kind": "section",
      "id": "s8",
      "role": "recap",
      "objective_ids": [
        "o1"
      ],
      "title": "Register checklist",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Before you choose professional or conversational wording, ask: Who is the reader? What genre is this? How direct should I be? Are my connectors and colloquial markers suitable? Professional Norwegian does not mean archaic Norwegian; it means clear, respectful language that fits the situation."
            }
          ]
        }
      ]
    },
