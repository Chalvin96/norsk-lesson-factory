{
  "key": "formal_vs_informal_register",
  "concept_slug": "formal_vs_informal_register",
  "grounding_mode": "fallback_no_wiki",
  "title": "Professional and Conversational Tone in Norwegian",
  "cefr_level": "B2",
  "goal": "Adjust Norwegian language to audience, genre and purpose by choosing suitable greetings, directness, pronouns, sentence style and conversational markers.",
  "objectives": [
    {
      "id": "o1",
      "statement": "Choose wording that fits professional and conversational situations in Norwegian.",
      "bloom_targets": [
        "remember",
        "apply"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "s1",
      "role": "orient",
      "objective_ids": [
        "o1"
      ],
      "title": "Register is a choice, not a forbidden-word list",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Register means how your language fits a situation: friendly, neutral, professional or very formal. At B2, the useful question is not 'Is this word wrong?', but 'Does this fit the reader, genre and purpose?' A message to a friend, an email to a teacher and a note to a workplace can all be correct Norwegian, but they need different levels of distance, clarity and politeness."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Norwegian professional writing is often less ceremonious than English. The main goal is usually clear, respectful language, not old-fashioned formality."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hei, jeg viser til søknaden min og lurer på om det er mulig å få en oppdatering."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Hi, I am referring to my application and wonder whether it is possible to get an update."
            }
          ]
        }
      ]
    },
    {
