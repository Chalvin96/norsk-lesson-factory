{
  "key": "formal_vs_informal_register",
  "concept_slug": "formal_vs_informal_register",
  "grounding_mode": "fallback_no_wiki",
  "title": "Formal and Informal Register in Norwegian",
  "cefr_level": "B2",
  "goal": "Adjust Norwegian language to audience, genre and purpose by choosing suitable greetings, modality, directness, connectors, sentence style and colloquial markers.",
  "objectives": [
    {
      "id": "o1",
      "statement": "Learn formal_vs_informal_register",
      "bloom_targets": [
        "remember",
        "apply"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "s1",
      "role": "orient",
      "objective_ids": [
        "o1"
      ],
      "title": "Register is a choice, not a forbidden-word list",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Register means how formal, neutral or informal your language sounds in a situation. At B2, the useful question is not 'Is this word wrong?', but 'Does this fit the reader, genre and purpose?' A message to a friend, a note to a teacher and a complaint to a public office can all be correct Norwegian, but they need different levels of distance, precision and politeness."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Norwegian public and workplace writing is often less ceremonious than English, but formal contexts still prefer clear structure, moderate directness and fewer colloquial markers."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hei, jeg viser til søknaden min og lurer på om det er mulig å få en oppdatering."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Hi, I am referring to my application and wonder whether it is possible to get an update."
            }
          ]
        }
      ]
    },
    {
