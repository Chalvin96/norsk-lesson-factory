    {
      "element_kind": "section",
      "id": "s5",
      "role": "model",
      "objective_ids": [
        "o1"
      ],
      "title": "Passive forms can create distance",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Professional texts sometimes use passive forms to focus on the action instead of blaming a person directly. Norwegian has s-passive forms such as vurderes and rettes, and bli-passive forms such as blir vurdert and blir rettet. Use them when distance helps; too much passive style can make a text heavy."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "no",
            "no",
            "en"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "More direct"
              }
            ],
            [
              {
                "kind": "text",
                "value": "More distanced"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Comment"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "Dere vurderer planen på nytt."
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Planen vurderes på nytt."
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "S-passive focuses on the plan."
                }
              ]
            ],
            [
              [
                {
