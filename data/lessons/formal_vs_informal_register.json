      ],
      "title": "Directness, modality and distance",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Formal Norwegian often softens a request with modal verbs, conditional forms and impersonal phrasing. This does not mean every sentence must be passive or heavy; the goal is to sound respectful without being vague."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "no",
            "no",
            "en"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "More direct"
              }
            ],
