    {
      "element_kind": "section",
      "id": "s8",
      "role": "recap",
      "objective_ids": [
        "o1"
      ],
      "title": "Register checklist",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Before you choose a formal or informal wording, ask: Who is the reader? What genre is this? How direct should I be? Are my connectors and colloquial markers suitable? Formal Norwegian does not mean archaic Norwegian; it means controlled, clear language that fits the situation."
            }
          ]
        }
      ]
    },
