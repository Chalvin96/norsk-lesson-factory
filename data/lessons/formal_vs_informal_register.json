            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Individual word choices also shift tone. "
            },
            {
              "kind": "foreign_term",
              "value": "alle",
