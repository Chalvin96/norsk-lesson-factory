      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Formal texts often use connectors that make logic explicit: "
            },
            {
              "kind": "foreign_term",
              "value": "derfor, imidlertid, dermed, i tillegg, på bakgrunn av",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". They may also use more nouns: "
            },
            {
              "kind": "foreign_term",
              "value": "en vurdering av saken",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " instead of "
            },
            {
              "kind": "foreign_term",
              "value": "å se på saken",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". Too much nominal style can become heavy, so use it selectively."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "På bakgrunn av opplysningene ber jeg om en ny vurdering av saken."
            }
          ],
          "en": [
