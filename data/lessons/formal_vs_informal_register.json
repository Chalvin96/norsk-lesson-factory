    {
      "element_kind": "section",
      "id": "s3",
      "role": "model",
      "objective_ids": [
        "o1"
      ],
      "title": "Directness, modality and distance",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "When the situation needs a little distance, Norwegian often softens a request with modal verbs, conditional forms and impersonal phrasing. This does not mean every sentence must be passive or heavy; the goal is to sound respectful without being vague."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "no",
            "no",
            "en"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Too abrupt for the situation"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Better professional wording"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Comment"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "Send dokumentene i dag."
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Kan dere sende dokumentene i løpet av dagen?"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "A request sounds less abrupt."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "Jeg vil ha svar."
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Jeg ønsker svar på henvendelsen min."
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Ønsker is milder than vil ha."
                }
              ]
            ],
            [
              [
