      "title": "Quick recap",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Use spelling as a practical guide. First notice special vowel letters, then check whether the next consonant is single or double, then watch for silent letters and common letter groups."
            }
          ]
        },
        {
