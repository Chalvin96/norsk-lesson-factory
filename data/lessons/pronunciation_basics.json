          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "å"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Sounds close to the vowel in English saw for many learners. Keep the mouth open and rounded; do not read it as plain a."
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "å lese"
