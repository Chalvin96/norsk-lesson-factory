{
  "key": "pronunciation_basics",
  "concept_slug": "pronunciation_basics",
  "grounding_mode": "fallback_no_wiki",
  "title": "Norwegian spelling clues for sound",
  "cefr_level": "A1",
  "goal": "Use spelling clues to notice basic Norwegian vowels, length, and silent letters.",
  "objectives": [
    {
      "id": "obj_special_vowels",
      "statement": "Recognize the Norwegian letters å, ø, and y as separate vowel letters with separate sound clues.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_length",
      "statement": "Use single and double consonants as clues for long and short vowel sounds.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_silent_letters",
      "statement": "Recognize common silent-letter spellings in high-frequency words.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_sound_spellings",
      "statement": "Recognize high-value spelling groups such as kj and sj as sound clues without over-reading every letter.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [],
      "title": "Read spelling as a guide",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian spelling gives useful sound clues. Use letters and letter groups to make better guesses about pronunciation from text."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "A pronunciation clue is a spelling pattern that helps you predict how a word is said."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The main clues here are special vowel letters, vowel length, silent letters, and common letter groups. Some spellings have more detail later, especially "
            },
            {
              "kind": "foreign_term",
              "value": "kj",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " and "
            },
            {
              "kind": "foreign_term",
              "value": "sj",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". Here, focus on noticing that they work as groups."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det er hyggelig."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "It is nice."
            }
          ]
        }
      ]
    },
    {
