      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A vowel is a speech sound written with letters like a, e, i, o, u, y, æ, ø, or å. Norwegian spelling often shows vowel length with the consonant after the vowel."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "A single consonant after a vowel often points to a long vowel; a double consonant often points to a short vowel."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "This contrast can change meaning. The pair "
