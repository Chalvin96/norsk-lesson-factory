            {
              "kind": "foreign_term",
              "value": "tak/takk",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is a useful spelling clue: one k points to a longer vowel, while kk points to a shorter vowel."
            }
          ]
        },
        {
