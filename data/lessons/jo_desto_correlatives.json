        {
          "kind": "list",
          "ordered": true,
          "items": [
            [
              {
                "kind": "text",
                "value": "Start the first half with "
              },
              {
                "kind": "foreign_term",
                "value": "jo",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " plus a comparative."
              }
            ],
            [
              {
                "kind": "text",
                "value": "Start the second half with "
              },
              {
                "kind": "foreign_term",
                "value": "desto",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " or "
              },
              {
                "kind": "foreign_term",
                "value": "jo",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " plus a comparative."
              }
            ],
            [
              {
                "kind": "text",
                "value": "In the second half, put the finite verb before the subject when the comparative phrase comes first."
              }
            ],
            [
              {
                "kind": "text",
                "value": "Avoid English-like forms such as "
              },
              {
                "kind": "foreign_term",
                "value": "den mer",
