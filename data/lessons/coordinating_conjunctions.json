{
  "key": "coordinating_conjunctions",
  "concept_slug": "coordinating_conjunctions",
  "grounding_mode": "fallback_no_wiki",
  "title": "Join Simple Ideas with og, men, eller, for, and så",
  "cefr_level": "A1",
  "goal": "Use five common Norwegian joining words to connect words and simple clauses.",
  "objectives": [
    {
      "id": "obj_meaning",
      "statement": "Recognize the meanings and basic uses of og, men, eller, for, and så.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_like_elements",
      "statement": "Use coordinating conjunctions to join like elements such as nouns, adjectives, verbs, and short phrases.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_main_clauses",
      "statement": "Use coordinating conjunctions to join two simple main clauses without changing the basic word order on each side.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
