      ],
      "title": "Five Small Joining Words",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A coordinating conjunction is a joining word. It links equal parts: word with word, phrase with phrase, or full sentence with full sentence."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian uses five very common coordinating conjunctions in simple sentences: "
            },
            {
              "kind": "foreign_term",
              "value": "og",
              "lang": "no"
            },
            {
              "kind": "text",
