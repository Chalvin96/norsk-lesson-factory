    {
      "element_kind": "section",
      "id": "imported_section_001",
      "role": "model",
      "objective_ids": [
        "obj_like_elements"
      ],
      "title": "Join Matching Parts",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Use a coordinating conjunction between parts that do the same kind of work in the sentence. You can join two nouns, two adjectives, two verbs, or two short phrases."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "When you join like elements, put the conjunction between them: first part plus joining word plus second part."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg spiser brød og ost."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I eat bread and cheese."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vil du ha te eller kaffe?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Do you want tea or coffee?"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Han er trøtt, men glad."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "He is tired but happy."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_002",
      "role": "model",
      "objective_ids": [
        "obj_main_clauses"
      ],
      "title": "Join Two Simple Sentences",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A coordinating conjunction can also join two main clauses. Each side keeps its own simple sentence pattern."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "In a simple joined sentence, write main clause plus conjunction plus main clause."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg lager middag, og du dekker bordet."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I am making dinner, and you are setting the table."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun kommer ikke, for hun er syk."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She is not coming because she is sick."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det regner, så vi blir hjemme."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "It is raining, so we are staying home."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "note",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "The comma is common before a coordinating conjunction when it joins two complete main clauses. Do not use a comma just because two single words are joined."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_003",
      "role": "contrast",
      "objective_ids": [
        "obj_meaning"
      ],
      "title": "Choose by Meaning",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The form you choose depends on the relationship between the two parts. Look for addition, contrast, choice, reason, or result."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "foreign_term",
                "value": "og",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " adds: one thing plus another."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "men",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " contrasts: one idea pushes against the other."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "eller",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " offers a choice."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "for",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " gives the reason."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "så",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " gives the result."
              }
            ]
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg vil gå, men jeg er trøtt."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I want to go, but I am tired."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg er trøtt, så jeg går hjem."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I am tired, so I am going home."
            }
          ]
        }
      ]
    },
