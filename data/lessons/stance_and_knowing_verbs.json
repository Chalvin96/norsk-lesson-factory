              }
            ],
            [
              {
                "kind": "text",
                "value": "Norwegian choice"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Use it for"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "I think, I find"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "synes"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "personal feeling or impression"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "I think, I believe"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "tror"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "belief when you are not certain"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "I think, I mean"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "mener"
                }
              ],
              [
                {
