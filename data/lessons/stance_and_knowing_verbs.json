    {
      "element_kind": "section",
      "id": "imported_section_001",
      "role": "contrast",
      "objective_ids": [
        "obj_stance"
      ],
      "title": "Three Ways to Say Think",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "For opinions, Norwegian separates your immediate impression from your belief about reality and from your argued position. This is the main split behind "
            },
            {
              "kind": "foreign_term",
              "value": "synes",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "tror",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and "
            },
            {
              "kind": "foreign_term",
              "value": "mener",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "synes",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for a subjective reaction: how something seems, feels, tastes, or appears to you."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg synes filmen er spennende."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I think the film is exciting."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Synes du kaffen er for sterk?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Do you think the coffee is too strong?"
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "tror",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when you believe something but are not presenting it as certain knowledge."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg tror toget kommer klokka åtte."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I think the train arrives at eight."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Han tror det blir regn i morgen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "He thinks it will rain tomorrow."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "mener",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for a considered opinion, often something you can explain, defend, or argue."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun mener at skolen bør starte senere."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She thinks that school should start later."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hva mener du om forslaget?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "What do you think about the proposal?"
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_002",
      "role": "contrast",
      "objective_ids": [
        "obj_know"
      ],
      "title": "Three Ways to Say Know",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The English verb "
            },
            {
              "kind": "foreign_term",
              "value": "know",
              "lang": "en"
            },
            {
              "kind": "text",
              "value": " maps to three common Norwegian verbs. The choice depends on what kind of knowledge you mean: a fact, familiarity, or ability."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "vite",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for factual knowledge: information, answers, times, reasons, and whether something is true."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg vil vite svaret."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I want to know the answer."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vet du hvor banken ligger?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Do you know where the bank is?"
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "kjenne",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for familiarity with people, places, works, or things you have experienced."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg kjenner læreren godt."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I know the teacher well."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Kjenner du denne byen?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Do you know this city?"
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "kunne",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for ability, languages, and knowing how to do something. The infinitive is the base form of a verb; after "
            },
            {
              "kind": "foreign_term",
              "value": "kunne",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", Norwegian normally uses the bare infinitive without "
            },
            {
              "kind": "foreign_term",
              "value": "å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg kan norsk."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I know Norwegian."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Kan du svømme?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Do you know how to swim?"
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_003",
      "role": "recap",
      "objective_ids": [
        "obj_stance",
        "obj_know",
        "obj_diagnose"
      ],
      "title": "Quick Choice Test",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "When you are unsure, ask what the English verb is doing. If "
            },
            {
              "kind": "foreign_term",
              "value": "think",
              "lang": "en"
            },
            {
              "kind": "text",
              "value": " means personal reaction, choose "
            },
            {
              "kind": "foreign_term",
              "value": "synes",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". If it means uncertain belief, choose "
            },
            {
              "kind": "foreign_term",
              "value": "tror",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". If it means a considered position, choose "
            },
            {
              "kind": "foreign_term",
              "value": "mener",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "For "
            },
            {
              "kind": "foreign_term",
              "value": "know",
              "lang": "en"
            },
            {
              "kind": "text",
              "value": ", choose "
            },
            {
              "kind": "foreign_term",
              "value": "vite",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for facts, "
            },
            {
              "kind": "foreign_term",
              "value": "kjenne",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for familiarity, and "
            },
            {
              "kind": "foreign_term",
              "value": "kunne",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for ability or languages."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "tip",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "A good self-check is to replace English "
                },
                {
                  "kind": "foreign_term",
                  "value": "know",
                  "lang": "en"
                },
                {
                  "kind": "text",
                  "value": " with a fuller phrase: know that, know someone, or know how."
                }
              ]
            }
          ]
        }
      ]
    },
