{
  "key": "stance_and_knowing_verbs",
  "concept_slug": "stance_and_knowing_verbs",
  "grounding_mode": "fallback_no_wiki",
  "title": "Opinion, Belief, and the Three Norwegian Meanings of Know",
  "cefr_level": "B1",
  "goal": "Choose the right verb for opinions, beliefs, facts, familiarity, and skills.",
  "objectives": [
    {
      "id": "obj_stance",
      "statement": "Distinguish synes, tror, and mener for subjective reactions, uncertain beliefs, and considered opinions.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_know",
      "statement": "Distinguish vite, kjenne, and kunne for facts, familiarity, and skills or languages.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_diagnose",
      "statement": "Diagnose common English-to-Norwegian know and think traps in short sentences.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [
        "obj_stance",
        "obj_know"
      ],
      "title": "One English Verb, Several Norwegian Choices",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "English uses "
            },
            {
              "kind": "foreign_term",
              "value": "think",
              "lang": "en"
            },
            {
              "kind": "text",
              "value": " and "
            },
            {
              "kind": "foreign_term",
              "value": "know",
              "lang": "en"
            },
            {
              "kind": "text",
              "value": " very broadly. Norwegian asks you to choose more precisely: are you giving a personal reaction, making an uncertain guess, stating a considered view, knowing a fact, being familiar with someone, or knowing how to do something?"
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use the Norwegian verb that matches the type of stance or knowledge, not the English verb you would use in translation."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "en"
          ],
          "headers": [
            [
              {
                "kind": "text",
