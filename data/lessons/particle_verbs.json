{
  "key": "particle_verbs",
  "concept_slug": "particle_verbs",
  "grounding_mode": "fallback_no_wiki",
  "title": "Particle Verbs as Meaning Units",
  "cefr_level": "B1",
  "goal": "Understand common Norwegian particle verbs and place the particle naturally with noun and pronoun objects.",
  "objectives": [
    {
      "id": "obj_meaning_units",
      "statement": "Recognize that a verb plus particle can make one meaning unit.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_core_particles",
      "statement": "Understand common particle verbs such as movement, switching, and bringing actions.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_object_placement",
      "statement": "Choose natural particle placement with noun objects and pronoun objects.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_diagnose",
      "statement": "Find and fix unnatural particle placement in short sentences.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [],
      "title": "One Verb, One Small Word, One Meaning",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A particle verb is a verb plus a short word, called a particle, that together form one meaning unit. The particle often looks like a preposition, but here it belongs closely with the verb."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Learn many particle verbs as whole expressions, because the particle can change the meaning of the verb."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Kan jeg komme inn?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "May I come in?"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi går ut etter møtet."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We go out after the meeting."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "note",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "This is different from fixed preposition expressions. In a particle verb, the small word works with the verb to create an action meaning, not just to connect the verb to a following phrase."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_001",
      "role": "model",
      "objective_ids": [
        "obj_meaning_units"
      ],
