      "objective_ids": [
        "obj_time"
      ],
      "title": "Time: om, for, siden, i",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "For time, the same Norwegian word can have more than one job. Use "
            },
            {
              "kind": "foreign_term",
              "value": "om",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for some repeated parts of the day, such as "
            },
            {
              "kind": "foreign_term",
              "value": "om morgenen",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and also for a future time measured from now, such as in two days. For past time measured from now, Norwegian uses the frame "
            },
            {
              "kind": "foreign_term",
              "value": "for ... siden",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". For duration, how long something lasts, use "
            },
            {
              "kind": "foreign_term",
              "value": "i",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
