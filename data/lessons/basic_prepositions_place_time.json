{
  "key": "basic_prepositions_place_time",
  "concept_slug": "basic_prepositions_place_time",
  "grounding_mode": "fallback_no_wiki",
  "title": "Basic Prepositions for Place and Time",
  "cefr_level": "A1",
  "goal": "Choose basic Norwegian prepositions for simple places, movement, visits, future time, past time, and duration.",
  "objectives": [
    {
      "id": "obj_place",
      "statement": "Use basic place prepositions for being in a country or room, being at a school or activity place, going to a place, and being with a professional or host.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_time",
      "statement": "Use basic time prepositions for parts of the day, future time, past time, and duration.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_contrast",
      "statement": "Recognize that Norwegian prepositions do not map one-to-one to English and choose by meaning, not by direct translation.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [
        "obj_contrast"
      ],
      "title": "Prepositions Show Relationships",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A preposition is a small word that shows a relationship. It can show place, movement, time, or who someone is with. English uses words like in, on, at, to, and for. Norwegian has small words too, but they do not match English one by one."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Choose the Norwegian preposition from the meaning of the whole phrase, not from the English preposition alone."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg bor i Norge."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I live in Norway."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun er på skolen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She is at school."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "warning",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "The English word at can become several Norwegian words. For places, you will often choose between "
                },
                {
                  "kind": "foreign_term",
                  "value": "i",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ", "
                },
                {
                  "kind": "foreign_term",
                  "value": "på",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ", "
                },
                {
                  "kind": "foreign_term",
                  "value": "til",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ", and "
                },
                {
                  "kind": "foreign_term",
                  "value": "hos",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": "."
                }
              ]
            }
          ]
        }
      ]
    },
    {
