              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for being inside a country, city, room, or area. Use "
            },
            {
              "kind": "foreign_term",
              "value": "på",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for many institutions, events, islands, and activity places. Use "
            },
            {
              "kind": "foreign_term",
              "value": "til",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for movement toward a place. Use "
            },
            {
              "kind": "foreign_term",
              "value": "hos",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when you are at someone's place, with a host, or with a professional."
