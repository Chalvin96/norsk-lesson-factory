                  "kind": "foreign_term",
                  "value": "ikke",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " belongs near the finite verb. Small pronouns can slip before it; longer noun phrases usually stay after it."
                }
              ]
            }
          ]
        }
