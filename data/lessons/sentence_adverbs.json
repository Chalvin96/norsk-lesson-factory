      "title": "Main Clauses",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A finite verb is the verb that shows tense. A main clause is a clause that can stand as a complete sentence. In a normal main clause, the sentence adverb comes after the finite verb."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "In a main clause, put the sentence adverb after the finite verb: subject + finite verb + sentence adverb."
            }
          ]
        },
