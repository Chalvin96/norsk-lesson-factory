      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [
        "obj_position_main"
      ],
      "title": "What Sentence Adverbs Do",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A sentence adverb is a small word that comments on the whole situation: whether it happens, how often it happens, or how certain it is. In Norwegian, these words are very position-sensitive, so you need both the word and its place."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Common sentence adverbs include "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "alltid",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "aldri",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "ofte",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and "
            },
            {
              "kind": "foreign_term",
              "value": "kanskje",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg drikker ikke kaffe."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I do not drink coffee."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun kommer alltid tidlig."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She always comes early."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi spiser ofte fisk."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We often eat fish."
            }
          ]
        }
      ]
    },
