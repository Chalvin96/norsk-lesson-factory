{
  "key": "sentence_adverbs",
  "concept_slug": "sentence_adverbs",
  "grounding_mode": "fallback_no_wiki",
  "title": "Place Ikke, Alltid, Aldri, Ofte, and Kanskje",
  "cefr_level": "A2",
  "goal": "Place common sentence adverbs correctly in main and subordinate clauses.",
  "objectives": [
    {
      "id": "obj_position_main",
      "statement": "Recognize and place common sentence adverbs after the finite verb in main clauses.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_position_subordinate",
      "statement": "Recognize and place common sentence adverbs before the finite verb in subordinate clauses.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_compound_and_weight",
      "statement": "Use sentence adverbs with compound tenses and notice light word placement around ikke.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
