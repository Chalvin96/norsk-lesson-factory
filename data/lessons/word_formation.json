{
  "key": "word_formation",
  "concept_slug": "word_formation",
  "grounding_mode": "fallback_no_wiki",
  "title": "Build Norwegian Word Families",
  "cefr_level": "B1",
  "goal": "Recognize and form common Norwegian nouns with suffixes, prefixes, and simple compounds.",
  "objectives": [
    {
      "id": "obj_suffixes",
      "statement": "Identify common noun-forming suffixes and what kind of meaning they add.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_agent_action",
      "statement": "Build common nouns for people and actions from familiar verbs.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_prefix_compound",
      "statement": "Recognize frequent prefixes and simple compound nouns in everyday words.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_diagnose",
      "statement": "Choose and correct word forms in short Norwegian sentences.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [],
      "title": "Words Come in Families",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian often builds new words from a stem, the core part of a word that carries the main meaning. A suffix is a word ending that changes the word type or meaning, and a prefix is a word beginning that adds meaning before the stem."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Look for the stem first, then read the prefix or suffix as an extra meaning signal."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi trenger mer samarbeid på jobben."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We need more cooperation at work."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Utvikling tar tid."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Development takes time."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "note",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Some word families are transparent, but not every word can be built mechanically. Focus on frequent patterns you can use and recognize in everyday Bokmål."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_001",
      "role": "model",
      "objective_ids": [
        "obj_suffixes"
      ],
      "title": "Common Noun Suffixes",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Several common suffixes make nouns. A noun is a word for a person, thing, idea, or activity. These endings help you guess whether a word names an abstract idea, an event, an activity, or a person."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "en",
            "no",
            "no"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Suffix"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Usual job"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Ord"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Eksempel"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
