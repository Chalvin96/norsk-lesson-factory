    {
      "element_kind": "section",
      "id": "imported_section_002",
      "role": "model",
      "objective_ids": [
        "obj_suffixes"
      ],
      "title": "People and Actions",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "To name a person by what they do, Norwegian often uses the suffix "
            },
            {
              "kind": "foreign_term",
              "value": "er",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". To name an action or process, Norwegian often uses "
            },
            {
              "kind": "foreign_term",
              "value": "ing",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " or "
            },
            {
              "kind": "foreign_term",
              "value": "ning",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". Watch the meaning: a person word and an activity word are not interchangeable."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "er",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for many people or roles, and use "
            },
            {
              "kind": "foreign_term",
              "value": "ing",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " or "
            },
            {
              "kind": "foreign_term",
              "value": "ning",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for many activities, processes, or results."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "En lærer planlegger undervisning."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "A teacher plans teaching."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi trenger mer trening før testen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We need more training before the test."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "warning",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Do not choose a suffix only because English has a similar ending. Norwegian uses fixed word forms: "
                },
                {
                  "kind": "foreign_term",
                  "value": "utvikling",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " is the normal noun, while a guessed form like "
                },
                {
                  "kind": "foreign_term",
                  "value": "utvikelse",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " is not the everyday Bokmål word."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_003",
      "role": "contrast",
      "objective_ids": [
        "obj_suffixes"
      ],
      "title": "Prefixes and Simple Compounds",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A prefix can point direction, reversal, repetition, or degree. A basic compound noun is a noun made by joining two words into one written word. Both patterns help you understand longer words without translating every part separately."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "foreign_term",
                "value": "u",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " can mean not or un, as in "
              },
              {
                "kind": "foreign_term",
                "value": "uklar",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "mis",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " often signals wrong or bad, as in "
              },
              {
                "kind": "foreign_term",
                "value": "misforstå",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "gjen",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " often means again or back, as in "
              },
              {
                "kind": "foreign_term",
                "value": "gjenbruke",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "sam",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " often means together, as in "
              },
              {
                "kind": "foreign_term",
                "value": "samarbeid",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": "."
              }
            ]
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det var en misforståelse i møtet."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "There was a misunderstanding in the meeting."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Språkkurs er et sammensatt ord."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Language course is a compound word."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Most Norwegian compound nouns are written as one word, not as two separate words."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_004",
      "role": "recap",
      "objective_ids": [],
      "title": "What to Notice",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "When you meet a new Norwegian word, break it into useful pieces. The stem gives the central meaning, suffixes often show noun type, prefixes add a meaning before the stem, and compounds combine words into one written noun."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": true,
          "items": [
            [
              {
                "kind": "text",
                "value": "Ask whether the word names a quality, person, action, process, or result."
              }
            ],
            [
              {
                "kind": "text",
                "value": "Check whether the word has a familiar prefix such as "
              },
              {
                "kind": "foreign_term",
                "value": "u",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "kind": "foreign_term",
                "value": "mis",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "kind": "foreign_term",
                "value": "gjen",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": ", or "
              },
              {
                "kind": "foreign_term",
                "value": "sam",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            [
              {
                "kind": "text",
                "value": "For compounds, expect one written word in Bokmål."
              }
            ]
          ]
        }
      ]
    },
