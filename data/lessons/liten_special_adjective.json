    {
      "element_kind": "section",
      "id": "imported_section_001",
      "role": "model",
      "objective_ids": [
        "obj_indefinite_singular"
      ],
      "title": "Indefinite singular: liten, lita, lite",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Indefinite phrases describe any example of a thing, not one already identified — a small cup, a small book, a small room (as opposed to 'the small cup'). In singular, for one thing, the form of "
            },
            {
              "kind": "foreign_term",
              "value": "liten",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " follows the noun gender, the noun phrase shown by "
            },
            {
              "kind": "foreign_term",
              "value": "en",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "ei",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", or "
            },
            {
              "kind": "foreign_term",
              "value": "et",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "liten",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " with "
            },
            {
              "kind": "foreign_term",
              "value": "en",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " nouns, "
            },
            {
              "kind": "foreign_term",
              "value": "lita",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " with "
            },
            {
              "kind": "foreign_term",
              "value": "ei",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " nouns, and "
            },
            {
              "kind": "foreign_term",
              "value": "lite",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " with "
            },
            {
              "kind": "foreign_term",
              "value": "et",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " nouns."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg har en liten kopp."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I have a small cup."
