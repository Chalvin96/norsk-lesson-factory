                {
                  "kind": "foreign_term",
                  "value": "det lille huset",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ", not "
                },
                {
                  "kind": "foreign_term",
                  "value": "det lite huset",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": "."
