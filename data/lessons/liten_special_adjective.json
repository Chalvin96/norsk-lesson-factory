            {
              "kind": "foreign_term",
              "value": "lille",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". This form is the same for common-gender, feminine, and neuter singular nouns."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "lille",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " before a definite singular noun."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Den lille koppen er min."
            }
          ],
          "en": [
            {
