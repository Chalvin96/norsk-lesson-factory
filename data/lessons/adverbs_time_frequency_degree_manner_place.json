    {
      "element_kind": "section",
      "id": "imported_section_011",
      "role": "recap",
      "objective_ids": [
        "obj_identify_adverb_types",
        "obj_place_frequency",
        "obj_use_degree_manner",
        "obj_place_time_place"
      ],
      "title": "Quick Recap",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian adverbs carry small but important information about time, frequency, degree, manner, and place. Their position depends on what kind of adverb they are and what part of the sentence you want to highlight."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "text",
                "value": "Frequency adverbs usually come after the finite verb: "
              },
              {
                "kind": "foreign_term",
                "value": "Jeg trener ofte.",
                "lang": "no"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Degree adverbs come before the word they strengthen: "
              },
              {
                "kind": "foreign_term",
                "value": "veldig bra",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            [
              {
                "kind": "text",
                "value": "Manner adverbs describe how something happens: "
              },
              {
                "kind": "foreign_term",
                "value": "Han snakker forsiktig.",
                "lang": "no"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Time and place adverbs can come at the end or at the front; if they come first, the finite verb comes second."
              }
            ]
          ]
        },
        {
          "kind": "example",
