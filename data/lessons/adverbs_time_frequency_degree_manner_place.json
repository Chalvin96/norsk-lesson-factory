{
  "key": "adverbs_time_frequency_degree_manner_place",
  "concept_slug": "adverbs_time_frequency_degree_manner_place",
  "grounding_mode": "fallback_no_wiki",
  "title": "Time, Frequency, Degree, Manner, and Place Adverbs",
  "cefr_level": "A2",
  "goal": "Use common Norwegian adverbs and place them correctly in simple main clauses.",
  "objectives": [
    {
      "id": "obj_identify_adverb_types",
      "statement": "Recognize common adverbs of time, frequency, degree, manner, and place.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_place_frequency",
      "statement": "Place common frequency adverbs after the finite verb in simple main clauses.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_use_degree_manner",
      "statement": "Use degree adverbs before adjectives or adverbs, and manner adverbs to describe how something happens.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_place_time_place",
      "statement": "Put time and place adverbs at the end or front of a main clause, with the finite verb second when fronted.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [
        "obj_identify_adverb_types"
      ],
      "title": "What Adverbs Do",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "An adverb is a word that tells you more about a verb, an adjective, another adverb, or a whole sentence. In Norwegian, many everyday adverbs answer questions like when, how often, how much, how, and where."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "en"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Type"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Common forms"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Job"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "Time"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "nå, snart"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "says when something happens"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "Frequency"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "ofte, alltid, aldri"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "says how often something happens"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "Degree"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "veldig, ganske, litt"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "says how much or how strongly"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "Manner"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "bra, forsiktig"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "says how something is done"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "Place"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "her, der, hit, dit"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "says where, or toward which place"
                }
              ]
            ]
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg er her nå."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I am here now."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun kommer snart."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She is coming soon."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use adverbs to add time, frequency, degree, manner, or place information to a clause."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_001",
      "role": "model",
      "objective_ids": [
        "obj_place_frequency"
      ],
      "title": "Frequency After the Verb",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A finite verb is the verb that shows tense, such as "
            },
            {
              "kind": "foreign_term",
              "value": "drikker",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " or "
            },
            {
              "kind": "foreign_term",
              "value": "kommer",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". In a simple Norwegian main clause, frequency adverbs such as "
            },
            {
              "kind": "foreign_term",
              "value": "ofte",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "alltid",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and "
            },
            {
              "kind": "foreign_term",
              "value": "aldri",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " usually come right after that verb."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg drikker ofte kaffe."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I often drink coffee."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Han kommer alltid klokka åtte."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "He always comes at eight o'clock."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi spiser aldri kjøtt."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We never eat meat."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "In a simple main clause, put common frequency adverbs after the finite verb: subject plus finite verb plus frequency adverb."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_002",
      "role": "model",
      "objective_ids": [
        "obj_use_degree_manner"
      ],
      "title": "Degree and Manner",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Degree adverbs tell how much. They usually stand right before the adjective or adverb they strengthen. Manner adverbs tell how something happens, and they often come after the verb or after the object."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun er veldig trøtt."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She is very tired."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det går ganske bra."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "It is going quite well."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Barnet går litt sakte."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The child walks a little slowly."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Han kjører forsiktig."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "He drives carefully."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Put degree adverbs before the word they modify; put manner adverbs where they describe the action clearly, often after the verb or object."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_003",
      "role": "contrast",
      "objective_ids": [
        "obj_place_time_place"
      ],
      "title": "Time and Place at the End or Front",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Time and place adverbs often come near the end of the clause. You can also put one at the front for emphasis or flow. Norwegian then keeps the finite verb in second position."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg jobber hjemme i dag."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I am working at home today."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "I dag jobber jeg hjemme."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Today I am working at home."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "De bor der."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "They live there."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Kan du komme hit?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Can you come here?"
            }
          ]
        },
        {
          "kind": "callout",
          "level": "note",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "foreign_term",
                  "value": "Her",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " and "
                },
                {
                  "kind": "foreign_term",
                  "value": "der",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " point to place. "
                },
                {
                  "kind": "foreign_term",
                  "value": "Hit",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " and "
                },
                {
                  "kind": "foreign_term",
                  "value": "dit",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " are useful with movement toward a place."
                }
              ]
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "When a time or place adverb starts a main clause, the finite verb comes second: adverb plus finite verb plus subject."
            }
          ]
        }
      ]
    },
