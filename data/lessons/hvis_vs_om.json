{
  "key": "hvis_vs_om",
  "concept_slug": "hvis_vs_om",
  "grounding_mode": "fallback_no_wiki",
  "title": "When English if becomes hvis or om",
  "cefr_level": "B1",
  "goal": "Choose hvis for conditions and om for embedded yes/no questions.",
  "objectives": [
    {
      "id": "obj_condition_hvis",
      "statement": "Use hvis to introduce real conditions in Norwegian.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_question_om",
      "statement": "Use om to introduce embedded yes/no questions after verbs such as spør, vite, and lure på.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_meaning_contrast",
      "statement": "Decide whether English if means a condition or an embedded question, then choose hvis or om.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_optional_om",
      "statement": "Recognize limited conditional uses of om and keep hvis as the normal learner choice for conditions.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [],
      "title": "One English word, two Norwegian jobs",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "English uses if for two different jobs. Norwegian normally separates them. Use "
            },
            {
              "kind": "foreign_term",
              "value": "hvis",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when you mean a condition, and use "
            },
            {
              "kind": "foreign_term",
              "value": "om",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when you mean whether inside another sentence."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "hvis",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for a condition: one thing happens only in that situation."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hvis det regner, tar vi bussen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "If it rains, we will take the bus."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "om",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for an embedded yes/no question: whether."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg vet ikke om det regner."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I do not know if it is raining."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "tip",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "A quick test: if you can replace English if with whether, Norwegian usually wants "
                },
                {
                  "kind": "foreign_term",
                  "value": "om",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": "."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_001",
      "role": "model",
      "objective_ids": [
        "obj_condition_hvis"
      ],
      "title": "Hvis for conditions",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "foreign_term",
              "value": "Hvis",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " introduces a subordinate clause, a clause introduced by a word like "
            },
            {
              "kind": "foreign_term",
              "value": "hvis",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " or "
            },
            {
              "kind": "foreign_term",
              "value": "om",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". In a condition, it says what must be true before the main action can happen."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg ringer deg hvis jeg blir forsinket."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I will call you if I am delayed."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hvis du har tid, kan vi spise sammen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "If you have time, we can eat together."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "When the "
            },
            {
              "kind": "foreign_term",
              "value": "hvis",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " clause comes first, the next clause uses V2 word order: the finite verb comes second. This is the same pattern you used with conditional clauses."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hvis du kommer tidlig, lager jeg kaffe."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "If you come early, I will make coffee."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "en"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Pattern"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Norwegian"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Use"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "Condition after main clause"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Jeg blir hjemme hvis jeg er syk."
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "No special inversion after the main clause."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "Condition first"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Hvis jeg er syk, blir jeg hjemme."
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "The finite verb in the main clause comes right after the condition."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "Emphatic frame"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "hvis ... så"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Possible, especially for emphasis, but not required."
                }
              ]
            ]
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_002",
      "role": "contrast",
      "objective_ids": [
        "obj_condition_hvis"
      ],
      "title": "Om for embedded yes or no questions",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "foreign_term",
              "value": "Om",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " introduces a question inside a larger sentence. The outside sentence might say that someone asks, knows, checks, wonders, or is unsure."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun spør om du kommer i kveld."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She asks if you are coming tonight."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Kan du sjekke om butikken er åpen?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Can you check if the shop is open?"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg lurer på om han har sendt meldingen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I wonder if he has sent the message."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "After verbs like "
            },
            {
              "kind": "foreign_term",
              "value": "spør om",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "vet om",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "sjekker om",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and "
            },
            {
              "kind": "foreign_term",
              "value": "lurer på om",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", use "
            },
            {
              "kind": "foreign_term",
              "value": "om",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for English if or whether."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "warning",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Do not use "
                },
                {
                  "kind": "foreign_term",
                  "value": "hvis",
                  "lang": "no"
                },
                {
                  "kind": "text",
