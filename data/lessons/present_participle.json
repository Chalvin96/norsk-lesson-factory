{
  "key": "present_participle",
  "concept_slug": "present_participle",
  "grounding_mode": "fallback_no_wiki",
  "title": "Using Norwegian -ende Forms Without Overusing English -ing",
  "cefr_level": "B2",
  "goal": "Recognize and use Norwegian present participles as invariable adjective-like and adverb-like forms, and replace mechanical English -ing translations with more natural Norwegian structures.",
  "objectives": [
    {
      "id": "obj_form",
      "statement": "Identify how Norwegian present participles are formed and remember that they do not change for gender, number, or definiteness.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_use",
      "statement": "Use present participles to describe a person, thing, position, or manner when Norwegian allows an adjective-like or adverb-like -ende form.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_limits",
      "statement": "Choose infinitives, finite clauses, or other Norwegian structures instead of translating every English -ing form with -ende.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_phrases",
      "statement": "Recognize fixed and semi-fixed patterns such as bli stående and sittende with a result or lasting position meaning.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
