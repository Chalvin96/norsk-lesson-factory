{
  "key": "object_pronoun_position",
  "concept_slug": "object_pronoun_position",
  "grounding_mode": "fallback_no_wiki",
  "title": "Put Object Pronouns in the Right Place",
  "cefr_level": "A2",
  "goal": "Choose and place Norwegian object pronouns correctly in simple sentences.",
  "objectives": [
    {
      "id": "obj_subject_object_forms",
      "statement": "Distinguish subject pronouns from object pronouns in common Bokmål forms.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_after_finite_verb",
      "statement": "Place object pronouns after the finite verb in simple main clauses.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_with_negation",
      "statement": "Place short object pronouns before ikke in simple main clauses, and after the infinitive when another verb comes first.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [],
      "title": "Subject Form or Object Form",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A subject pronoun is the person doing the action. An object pronoun is the person receiving the action. English changes some forms too: I becomes me, he becomes him. Norwegian does the same."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "no"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Meaning"
              }
            ],
            [
              {
                "kind": "text",
                "value": "subjekt"
              }
            ],
            [
              {
                "kind": "text",
                "value": "objekt"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "I / me"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "jeg"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "meg"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "you"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "du"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "deg"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "he / him"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "han"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "ham"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "she / her"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "hun"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "henne"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "we / us"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "vi"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "oss"
                }
              ]
            ]
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use the subject form for the doer, and the object form after the verb when that person receives the action."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg ser deg."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I see you."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun hjelper meg."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She helps me."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_001",
      "role": "model",
      "objective_ids": [
        "obj_subject_object_forms"
      ],
      "title": "After the Tense Verb",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "In a simple main clause, the verb normally comes in second position. The object pronoun usually comes right after that verb when there is no negation."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "no",
            "no",
            "no"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "subjekt"
              }
            ],
            [
              {
                "kind": "text",
                "value": "verb"
              }
            ],
            [
              {
                "kind": "text",
                "value": "objektpronomen"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "Jeg"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "ringer"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "henne"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "Vi"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "møter"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "ham"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "De"
