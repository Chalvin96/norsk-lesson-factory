              [
                {
                  "kind": "text",
                  "value": "oss"
                }
              ]
            ]
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg ringer henne i kveld."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I am calling her tonight."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi møter ham på stasjonen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We are meeting him at the station."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Pattern: subject plus finite verb plus object pronoun."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_002",
      "role": "contrast",
      "objective_ids": [
        "obj_subject_object_forms"
      ],
      "title": "With Ikke",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "When a short object pronoun and "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " are both in a simple main clause, the pronoun usually comes before "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". This word order is common and natural in everyday Bokmål."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg kjenner ham ikke."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I do not know him."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun ser oss ikke."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She does not see us."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "In simple main clauses, put the object pronoun before "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ": "
            },
            {
              "kind": "foreign_term",
              "value": "Jeg ser deg ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "With a modal verb and an infinitive, the infinitive is the base form of the verb, often after "
            },
            {
              "kind": "foreign_term",
              "value": "å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " in dictionary form. The object pronoun normally follows the infinitive."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg kan ikke hjelpe deg."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I cannot help you."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi vil invitere henne."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We want to invite her."
            }
          ]
        }
      ]
    },
