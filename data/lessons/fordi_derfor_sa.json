{
  "key": "fordi_derfor_sa",
  "concept_slug": "fordi_derfor_sa",
  "grounding_mode": "fallback_no_wiki",
  "title": "Cause and Result with fordi, derfor, and så",
  "cefr_level": "B1",
  "goal": "Choose fordi, derfor, or så and keep the verb in the right position.",
  "objectives": [
    {
      "id": "obj_fordi_subordinate",
      "statement": "Use fordi to give a reason in a subordinate clause and place ikke before the finite verb inside that clause.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_derfor_result",
      "statement": "Use derfor to introduce a result in a main clause with the finite verb immediately after derfor.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_sa_result",
      "statement": "Use så to link a cause to a result as a main-clause connector, usually with subject before the finite verb after så.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_contrast_connectors",
      "statement": "Distinguish cause wording from result wording and diagnose word-order errors with fordi, derfor, and så.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [],
      "title": "Cause First or Result First",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian uses different words and clause patterns depending on whether you are giving the reason or pointing to the result. The choice changes the word order, so it is not just a vocabulary choice."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "foreign_term",
              "value": "fordi",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " means because and introduces the reason. "
            },
            {
              "kind": "foreign_term",
              "value": "derfor",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " means therefore or that is why and introduces the result. "
            },
            {
              "kind": "foreign_term",
              "value": "så",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " means so and links a reason to a result."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg ble hjemme fordi jeg var syk."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I stayed home because I was sick."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg var syk. Derfor ble jeg hjemme."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I was sick. Therefore, I stayed home."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg var syk, så jeg ble hjemme."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I was sick, so I stayed home."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_001",
      "role": "model",
      "objective_ids": [
        "obj_fordi_subordinate"
      ],
      "title": "Fordi Gives the Reason",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "foreign_term",
              "value": "Fordi",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " starts a subordinate clause, a clause that depends on another clause. In Norwegian subordinate clauses, sentence adverbs such as "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " often come before the finite verb."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "With "
            },
            {
              "kind": "foreign_term",
              "value": "fordi",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", use subordinate-clause word order: subject plus sentence adverb plus finite verb."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun kom ikke fordi hun ikke hadde tid."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She did not come because she did not have time."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi tok bussen fordi toget ikke gikk."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We took the bus because the train was not running."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A "
            },
            {
              "kind": "foreign_term",
              "value": "fordi",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " clause can also stand first. Then the whole reason clause fills the first position, so the finite verb in the main clause comes next."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Fordi toget ikke gikk, tok vi bussen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Because the train was not running, we took the bus."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_002",
      "role": "contrast",
      "objective_ids": [
        "obj_fordi_subordinate"
      ],
      "title": "Derfor Points to the Result",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "foreign_term",
              "value": "Derfor",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " belongs to a main clause, an independent clause that can stand by itself. When "
            },
            {
              "kind": "foreign_term",
              "value": "derfor",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " starts the clause, it takes the first position, and the finite verb must come immediately after it."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use this pattern: "
            },
            {
              "kind": "foreign_term",
              "value": "Derfor",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus finite verb plus subject."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Bussen var forsinket. Derfor kom jeg for sent."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The bus was delayed. Therefore, I arrived late."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun hadde ikke nøkkel. Derfor ventet hun ute."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She did not have a key. That is why she waited outside."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "warning",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Do not use subordinate-clause word order after "
                },
                {
                  "kind": "foreign_term",
                  "value": "derfor",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ". Say "
                },
                {
                  "kind": "foreign_term",
                  "value": "Derfor ventet hun",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ", not "
                },
                {
                  "kind": "foreign_term",
                  "value": "Derfor hun ventet",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": "."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_003",
      "role": "contrast",
      "objective_ids": [
        "obj_fordi_subordinate"
      ],
      "title": "Så Links to the Result",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "foreign_term",
              "value": "Så",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " can link a reason to its result, much like English so. In this use, it connects to a main clause, so the normal main-clause order remains: subject before the finite verb when the subject starts the result clause."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Common result pattern: reason clause, comma, "
            },
            {
              "kind": "foreign_term",
              "value": "så",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus subject plus finite verb."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det regnet, så vi ble inne."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "It was raining, so we stayed inside."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg fant ikke telefonen, så jeg ringte deg fra kontoret."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I could not find my phone, so I called you from the office."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The useful contrast is this: "
            },
            {
              "kind": "foreign_term",
              "value": "derfor",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " usually triggers verb-before-subject when it starts the result clause, while result "
            },
            {
              "kind": "foreign_term",
              "value": "så",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " usually keeps subject-before-verb after the comma."
            }
          ]
        },
        {
