              "lang": "no"
            },
            {
              "kind": "text",
              "value": " or "
            },
            {
              "kind": "foreign_term",
              "value": "så",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " and keep main-clause word order."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "foreign_term",
