{
  "key": "passive_bli_and_s",
  "concept_slug": "passive_bli_and_s",
  "grounding_mode": "fallback_no_wiki",
  "title": "Passive with bli and -s",
  "cefr_level": "B1",
  "goal": "Choose and form natural Bokmål passives with bli or -s.",
  "objectives": [
    {
      "id": "obj_bli_passive",
      "statement": "Form event passives with bli plus past participle in present, simple past, and present perfect.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_agent_av",
      "statement": "Recognize and place optional passive agents with av.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_s_passive",
      "statement": "Use s-passive mainly in infinitive and present forms, especially after modal verbs.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_contrast_naturalness",
      "statement": "Choose between bli-passive, s-passive, and active wording in natural Bokmål.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [],
      "title": "What The Passive Does",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A passive form is a verb form where the subject receives the action instead of doing it. English often uses be plus a past participle, as in the book is read. Bokmål has two common passive patterns: "
            },
            {
              "kind": "foreign_term",
              "value": "bli",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus a past participle, and the "
            },
            {
              "kind": "foreign_term",
              "value": "-s",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " passive."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "bli",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus a past participle for passive events and processes: something happens to the subject."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Rapporten blir skrevet i dag."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The report is being written today."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Brevet ble sendt i går."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The letter was sent yesterday."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Problemet har blitt løst."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The problem has been solved."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A past participle is the verb form used after have or be in English, such as written or sent. In Norwegian, it is the form after "
            },
            {
              "kind": "foreign_term",
              "value": "blir",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "ble",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", or "
            },
            {
              "kind": "foreign_term",
              "value": "har blitt",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " in this passive pattern."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_001",
      "role": "model",
      "objective_ids": [
        "obj_bli_passive"
      ],
      "title": "Bli Carries The Time",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "In the "
            },
            {
              "kind": "foreign_term",
              "value": "bli",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " passive, "
            },
            {
              "kind": "foreign_term",
              "value": "blir",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " shows present time and "
            },
            {
              "kind": "foreign_term",
              "value": "ble",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " shows past time. The participle normally stays after it."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "foreign_term",
                "value": "blir",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " plus past participle: present passive"
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "ble",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " plus past participle: simple past passive"
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "har blitt",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " plus past participle: present perfect passive"
              }
            ]
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Møtet blir flyttet til fredag."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The meeting is moved to Friday."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Møtet ble flyttet til fredag."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The meeting was moved to Friday."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Møtet har blitt flyttet til fredag."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The meeting has been moved to Friday."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "tip",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Norwegian often uses an active sentence when the doer is important or obvious. Passive is useful when the result, object, or procedure matters more than who did it."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_002",
      "role": "model",
      "objective_ids": [
        "obj_bli_passive"
      ],
      "title": "Adding The Doer With Av",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The person or thing that performs the action in a passive sentence is the agent. In Bokmål, an optional passive agent is introduced with "
            },
            {
              "kind": "foreign_term",
              "value": "av",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", like by in English."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Put the "
            },
            {
              "kind": "foreign_term",
              "value": "av",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " phrase after the passive verb phrase when you need to say who did the action."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Boka blir lest av mange studenter."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The book is read by many students."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Søknaden ble godkjent av kommunen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The application was approved by the municipality."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Leave the "
            },
            {
              "kind": "foreign_term",
              "value": "av",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " phrase out when the doer is unknown, unimportant, or clear from context."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Døra ble låst klokka ni."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The door was locked at nine o'clock."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_003",
      "role": "contrast",
      "objective_ids": [
        "obj_bli_passive"
      ],
      "title": "The s-passive",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The "
            },
            {
              "kind": "foreign_term",
              "value": "-s",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " passive adds "
            },
            {
              "kind": "foreign_term",
              "value": "-s",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " to the verb. It is especially common in instructions, signs, formal information, and after modal verbs. A modal verb is a word such as can, must, or should."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "-s",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " passive mainly with infinitive forms, the base form often used after "
            },
            {
              "kind": "foreign_term",
              "value": "å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " or a modal verb, and with present forms in general statements."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Boka leses av mange studenter."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The book is read by many students."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Svarene sendes på e-post."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The answers are sent by email."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Rommet kan brukes etter klokka tre."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The room can be used after three o'clock."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Skjemaet må fylles ut før møtet."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The form must be filled out before the meeting."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "warning",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Avoid making simple past or present perfect passives with "
                },
                {
                  "kind": "foreign_term",
                  "value": "-s",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " in ordinary Bokmål. Use "
                },
                {
                  "kind": "foreign_term",
                  "value": "ble",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " or "
                },
                {
                  "kind": "foreign_term",
                  "value": "har blitt",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " instead."
                }
              ]
            },
            {
              "kind": "example",
              "no": [
                {
                  "kind": "text",
                  "value": "Brevet ble sendt i går."
                }
              ],
              "en": [
                {
                  "kind": "text",
                  "value": "The letter was sent yesterday."
                }
              ]
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Some Norwegian verbs end in "
            },
            {
              "kind": "foreign_term",
              "value": "-s",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " without being passive. Here, only treat "
            },
            {
              "kind": "foreign_term",
              "value": "-s",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " as passive when something is being done to the subject."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_004",
      "role": "recap",
      "objective_ids": [],
      "title": "Quick Choice Guide",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "When you need a passive in Bokmål, first ask whether you are describing an event or giving a general rule, instruction, or possibility."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "text",
                "value": "For an event or process: use "
              },
              {
                "kind": "foreign_term",
                "value": "blir",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "kind": "foreign_term",
                "value": "ble",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": ", or "
              },
              {
                "kind": "foreign_term",
                "value": "har blitt",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " plus a past participle."
              }
            ],
            [
              {
                "kind": "text",
                "value": "For signs, instructions, formal information, and modal phrases: "
              },
              {
                "kind": "foreign_term",
                "value": "-s",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " passive is often natural."
              }
            ],
            [
              {
                "kind": "text",
                "value": "For the doer in a passive sentence: add "
              },
              {
                "kind": "foreign_term",
                "value": "av",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " plus the agent."
              }
            ],
            [
              {
                "kind": "text",
                "value": "When the doer matters more than the receiver, choose an active sentence instead."
              }
            ]
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Kurset blir arrangert av universitetet."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The course is arranged by the university."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Dette programmet kan brukes på mobilen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "This program can be used on the mobile phone."
            }
          ]
        }
      ]
    },
