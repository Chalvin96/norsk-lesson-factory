{
  "key": "double_definiteness",
  "concept_slug": "double_definiteness",
  "grounding_mode": "fallback_no_wiki",
  "title": "Double definiteness with adjectives",
  "cefr_level": "A2",
  "goal": "Use den, det, or de with a definite noun and an -e adjective.",
  "objectives": [
    {
      "id": "obj_recognize_double_definiteness",
      "statement": "Recognize the parts of a definite noun phrase with an adjective.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_choose_gender_number_marker",
      "statement": "Choose den, det, or de to match the noun phrase.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_produce_double_definiteness",
      "statement": "Build and correct noun phrases with double definiteness.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [
        "obj_recognize_double_definiteness"
      ],
      "title": "Two definite signals",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A noun phrase is a group built around a noun, such as English “the big car.” A definite noun phrase points to a known or specific thing, like “the car,” not just “a car.” In Norwegian, when a definite noun phrase has an adjective, you normally mark definiteness twice."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use a front marker plus a definite noun ending: "
            },
            {
              "kind": "foreign_term",
              "value": "den store bilen",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "det nye huset",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "de røde bøkene",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The adjective describes the noun, such as “big” or “new.” In this pattern, the adjective usually takes the definite form ending "
            },
            {
              "kind": "foreign_term",
              "value": "-e",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". The noun also has its definite ending, such as "
            },
            {
              "kind": "foreign_term",
              "value": "-en",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "-et",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", or a plural ending like "
            },
            {
              "kind": "foreign_term",
              "value": "-ene",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg liker den store bilen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I like the big car."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi kjøper det nye huset."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We are buying the new house."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun leser de røde bøkene."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She is reading the red books."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_001",
      "role": "model",
      "objective_ids": [
        "obj_choose_gender_number_marker"
      ],
      "title": "Choose den, det, or de",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian nouns have gender, a noun class that affects nearby words. Use "
            },
            {
              "kind": "foreign_term",
              "value": "den",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " with masculine and feminine singular nouns, "
            },
            {
              "kind": "foreign_term",
              "value": "det",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " with neuter singular nouns, and "
            },
            {
              "kind": "foreign_term",
              "value": "de",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " with plural nouns."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "The common pattern is: "
            },
            {
              "kind": "foreign_term",
              "value": "den",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "det",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", or "
            },
            {
              "kind": "foreign_term",
              "value": "de",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus adjective ending "
            },
            {
              "kind": "foreign_term",
              "value": "-e",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus definite noun."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Den gamle læreren bor her."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The old teacher lives here."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det lille rommet er varmt."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The small room is warm."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "De norske vennene kommer i kveld."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The Norwegian friends are coming tonight."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_002",
      "role": "contrast",
      "objective_ids": [
        "obj_recognize_double_definiteness"
      ],
      "title": "With and without an adjective",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "If there is no adjective, the definite noun ending can stand alone. Add "
            },
            {
              "kind": "foreign_term",
              "value": "den",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "det",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", or "
            },
            {
              "kind": "foreign_term",
              "value": "de",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when you point out “that” or “those,” or when an adjective sits before the noun."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Bilen står utenfor."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The car is outside."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Den bilen står utenfor."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "That car is outside."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Den gamle bilen står utenfor."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The old car is outside."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "note",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "English usually marks definiteness once with “the.” Norwegian often marks it both at the front and on the noun when an adjective is included."
                }
              ]
            }
          ]
        }
      ]
    },
    {
