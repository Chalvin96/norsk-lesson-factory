{
  "key": "indefinite_articles",
  "concept_slug": "indefinite_articles",
  "grounding_mode": "fallback_no_wiki",
  "title": "Saying a, an, and no article",
  "cefr_level": "A1",
  "goal": "Choose en, ei, et, or no article in simple singular noun phrases.",
  "objectives": [
    {
      "id": "obj_article_forms",
      "statement": "Recognize that Norwegian uses en, ei, and et before singular indefinite nouns.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_gender_choice",
      "statement": "Choose en, ei, or et from the noun's gender in simple noun phrases.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_identity_no_article",
      "statement": "Use no article in common identity expressions with jobs and roles.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [],
      "title": "What an indefinite article does",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "An indefinite article is a small word like a or an in English. In Norwegian, it stands before one singular noun when you mean one thing or person, but not a specific one."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "For one non-specific singular noun, put "
            },
            {
              "kind": "foreign_term",
              "value": "en",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "ei",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", or "
            },
            {
              "kind": "foreign_term",
              "value": "et",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " before the noun."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg har en bil."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I have a car."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun ser ei jente."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She sees a girl."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi har et hus."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We have a house."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_001",
      "role": "model",
      "objective_ids": [
        "obj_article_forms"
      ],
      "title": "The three forms",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian nouns belong to genders: masculine, feminine, or neuter. The gender belongs to the noun, so learn the article together with the noun."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "no"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Noun phrase"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Article"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Example"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "masculine"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "en"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "en bil"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "feminine"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "ei"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "ei jente"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "neuter"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "et"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "et hus"
                }
              ]
            ]
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Many feminine nouns can also use "
            },
            {
              "kind": "foreign_term",
              "value": "en",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " in Bokmål. You will still see and hear "
            },
            {
              "kind": "foreign_term",
              "value": "ei",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", so it is useful to recognize it."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det er ei bok."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "It is a book."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det er en bok."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "It is a book."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_002",
      "role": "contrast",
      "objective_ids": [
        "obj_article_forms"
      ],
      "title": "Jobs and roles often use no article",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "In many common identity expressions, especially jobs and roles after a verb like am, is, or are, Norwegian normally uses no article. This is different from English."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use no "
            },
            {
              "kind": "foreign_term",
              "value": "en",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "ei",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", or "
            },
            {
              "kind": "foreign_term",
              "value": "et",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " in a neutral sentence like I am a student."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg er student."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I am a student."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Han er lærer."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "He is a teacher."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "note",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "This no-article pattern is common with jobs, roles, nationalities, and religions when you state what someone is."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_003",
      "role": "recap",
      "objective_ids": [],
      "title": "Quick recap",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "For one unspecified thing or person, Norwegian usually needs an article before the noun. For a simple job or role identity, Norwegian often uses no article."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "foreign_term",
                "value": "en bil",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " means a car."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "ei jente",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " means a girl."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "et hus",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " means a house."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "Jeg er student",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " means I am a student, with no Norwegian article."
              }
            ]
          ]
        }
      ]
    },
