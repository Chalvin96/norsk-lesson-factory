{
  "key": "future_expressions",
  "concept_slug": "future_expressions",
  "grounding_mode": "fallback_no_wiki",
  "title": "Talking About the Future in Norwegian",
  "cefr_level": "A2",
  "goal": "Choose and form common Norwegian future expressions with skal, vil, kommer til å, and present tense.",
  "objectives": [
    {
      "id": "obj_future_forms",
      "statement": "Recognize the main Norwegian ways to refer to future time.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_future_meaning",
      "statement": "Choose between planned future, likely future, wanted future, and scheduled future meanings.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_future_word_order",
      "statement": "Build future sentences with correct verb form and word order.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_future_diagnose",
      "statement": "Find and fix common mistakes in Norwegian future expressions.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [
        "obj_future_forms"
      ],
      "title": "Four Ways To Point Forward",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian often talks about the future with a modal verb or future expression before another verb. Three common choices are "
            },
            {
              "kind": "foreign_term",
              "value": "skal",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "vil",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and "
            },
            {
              "kind": "foreign_term",
              "value": "kommer til å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian can also use present tense, the verb form used for now, together with a future-time expression such as tomorrow, tonight, or next week. The time word does the future work."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "To talk about the future, Norwegian commonly uses "
            },
            {
              "kind": "foreign_term",
              "value": "skal",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus infinitive, "
            },
            {
              "kind": "foreign_term",
              "value": "vil",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus infinitive, "
            },
            {
              "kind": "foreign_term",
              "value": "kommer til å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus infinitive, or present tense with a clear future-time expression."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg skal ringe deg i morgen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I am going to call you tomorrow."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det kommer til å regne i kveld."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "It is going to rain tonight."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg vil gjerne hjelpe deg."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I would like to help you."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi møtes på fredag."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We are meeting on Friday."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_001",
      "role": "contrast",
      "objective_ids": [
        "obj_future_meaning"
      ],
      "title": "What Each Choice Suggests",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The forms overlap, but they give different signals. Use "
            },
            {
              "kind": "foreign_term",
              "value": "skal",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when the future action is planned, decided, promised, or expected by arrangement."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg skal ta toget klokka åtte."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I am going to take the train at eight."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "kommer til å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when you predict that something will happen, often because you can see a reason now."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun kommer til å bli glad."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She is going to be happy."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "vil",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for wanting, willingness, promises, or a future statement that sounds more like intention or prediction. In everyday speech, "
            },
            {
              "kind": "foreign_term",
              "value": "vil",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " often means want to."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "De vil besøke oss til sommeren."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "They want to visit us this summer."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Use present tense when the sentence has a clear future-time expression and the event is scheduled or arranged."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Bussen går om ti minutter."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The bus leaves in ten minutes."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "en"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Meaning"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Common form"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Typical use"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "Plan or decision"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "skal reise"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "I have decided or arranged it"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "Likely future"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "kommer til å regne"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "I predict it from signs now"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "Want or willingness"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "vil hjelpe"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "I want to or am willing to"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "Schedule"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "møtet begynner i morgen"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "The time word points forward"
                }
              ]
            ]
          ]
        }
      ]
    },
    {
      "element_kind": "section",
