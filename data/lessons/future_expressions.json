      "role": "model",
      "objective_ids": [
        "obj_future_word_order"
      ],
      "title": "Verb Form And Word Order",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "After "
            },
            {
              "kind": "foreign_term",
              "value": "skal",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " and "
            },
            {
              "kind": "foreign_term",
              "value": "vil",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", use the infinitive, the base form of a verb, without "
            },
            {
              "kind": "foreign_term",
              "value": "å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". After "
            },
            {
              "kind": "foreign_term",
              "value": "kommer til å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", keep "
            },
            {
              "kind": "foreign_term",
              "value": "å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " before the infinitive."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "foreign_term",
              "value": "skal",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus verb has no "
            },
            {
              "kind": "foreign_term",
              "value": "å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ": "
            },
            {
              "kind": "foreign_term",
              "value": "skal spise",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". "
            },
            {
              "kind": "foreign_term",
              "value": "vil",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus verb has no "
            },
            {
              "kind": "foreign_term",
              "value": "å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ": "
            },
            {
              "kind": "foreign_term",
              "value": "vil spise",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". "
            },
            {
              "kind": "foreign_term",
              "value": "kommer til å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " keeps "
            },
            {
              "kind": "foreign_term",
              "value": "å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ": "
            },
            {
              "kind": "foreign_term",
              "value": "kommer til å spise",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi skal spise middag hjemme."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We are going to eat dinner at home."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Han vil lære norsk."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "He wants to learn Norwegian."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det kommer til å bli kaldt."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "It is going to get cold."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "In a main clause, the finite verb, the verb that shows tense, usually comes in second position. In "
            },
            {
              "kind": "foreign_term",
              "value": "Jeg skal lese",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "skal",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is the finite verb. If the sentence starts with a time expression, the subject comes after the finite verb."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "I morgen skal jeg lese."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Tomorrow I am going to read."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Negation means making a sentence negative with a word like not. In these future expressions, "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " usually comes after the finite verb."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg skal ikke jobbe på lørdag."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I am not going to work on Saturday."
            }
          ]
        }
      ]
