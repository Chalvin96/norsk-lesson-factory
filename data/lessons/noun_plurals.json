{
  "key": "noun_plurals",
  "concept_slug": "noun_plurals",
  "grounding_mode": "fallback_no_wiki",
  "title": "Saying More Than One Noun",
  "cefr_level": "A1",
  "goal": "Form and recognize common Norwegian noun plurals in indefinite and definite forms.",
  "objectives": [
    {
      "id": "obj_regular_indefinite_plural",
      "statement": "Recognize and form regular indefinite plural nouns with r or er.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_neuter_zero_plural",
      "statement": "Recognize short neuter nouns that do not change in the indefinite plural.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_definite_plural",
      "statement": "Use common definite plural endings to mean the plural nouns.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_irregular_plurals",
      "statement": "Recognize common irregular plural nouns used in everyday Norwegian.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [
        "obj_regular_indefinite_plural",
        "obj_definite_plural"
      ],
      "title": "What Plural Means",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A plural means more than one. In Norwegian, many nouns change their ending when you move from one thing to several things."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "An indefinite noun has no the meaning, as in a car or cars. A definite noun has the meaning, as in the cars. Norwegian often shows both ideas with endings."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "For many Norwegian nouns, the indefinite plural ends in "
            },
            {
              "kind": "foreign_term",
              "value": "r",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " or "
            },
            {
              "kind": "foreign_term",
              "value": "er",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg ser biler."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I see cars."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun leser aviser."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She reads newspapers."
            }
          ]
        }
      ]
    },
