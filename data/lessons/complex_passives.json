        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "text",
                "value": "For a present event, use "
              },
              {
                "kind": "foreign_term",
                "value": "blir",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " plus the past participle."
              }
            ],
            [
              {
                "kind": "text",
                "value": "For a simple past event, use "
              },
              {
                "kind": "foreign_term",
                "value": "ble",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " plus the past participle."
              }
            ],
            [
              {
                "kind": "text",
                "value": "For a present perfect result, use "
              },
              {
                "kind": "foreign_term",
                "value": "har blitt",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " plus the past participle."
              }
            ],
            [
              {
                "kind": "text",
                "value": "For rules, procedures, and modal constructions, the s-passive is often natural."
