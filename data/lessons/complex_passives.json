{
  "key": "complex_passives",
  "concept_slug": "complex_passives",
  "grounding_mode": "fallback_no_wiki",
  "title": "Choosing Between Bli-Passive and S-Passive",
  "cefr_level": "B2",
  "goal": "Use modern Bokmål passive forms in present, modal, past, and perfect contexts.",
  "objectives": [
    {
      "id": "obj_bli_passive_time",
      "statement": "Recognize and form bli-passives for present, simple past, and present perfect events.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_s_passive_use",
      "statement": "Use s-passive naturally in present, infinitive, and modal constructions.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_contrast_choice",
      "statement": "Choose between bli-passive and s-passive according to tense, style, and meaning.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_agent_and_avoidance",
      "statement": "Add an av-agent only when useful and avoid outdated simple past s-passives.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [
        "obj_bli_passive_time",
        "obj_s_passive_use"
      ],
      "title": "What the passive is doing",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Passive voice means that the subject receives the action instead of doing it. In Bokmål, you mainly choose between a bli-passive, built with "
            },
            {
              "kind": "foreign_term",
              "value": "bli",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus a past participle, and an s-passive, where the verb ends in "
            },
            {
              "kind": "foreign_term",
              "value": "-s",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use bli-passive when you want to place the passive action in a clear time: present, simple past, or present perfect."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Brevet blir sendt i dag."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The letter is being sent today."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Brevet ble sendt i går."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The letter was sent yesterday."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Brevet har blitt sendt."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The letter has been sent."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The past participle is the verb form used after "
            },
            {
              "kind": "foreign_term",
              "value": "har",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " in perfect constructions, such as "
            },
            {
              "kind": "foreign_term",
              "value": "sendt",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". In the bli-passive, this participle stays the same while "
            },
            {
              "kind": "foreign_term",
              "value": "bli",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " carries the tense."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_001",
      "role": "model",
      "objective_ids": [
        "obj_bli_passive_time"
      ],
      "title": "The bli-passive across time",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A finite verb is the verb that shows tense in a clause. In the bli-passive, "
            },
            {
              "kind": "foreign_term",
              "value": "bli",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is the finite verb when the clause is present or simple past."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "no"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Time meaning"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Pattern"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Example"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "present"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "blir + past participle"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Rapporten blir sendt fredag."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "simple past"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "ble + past participle"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Rapporten ble sendt fredag."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "present perfect"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "har blitt + past participle"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Rapporten har blitt sendt."
                }
              ]
            ]
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "For completed passive actions in the past, prefer "
            },
            {
              "kind": "foreign_term",
              "value": "ble",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " or "
            },
            {
              "kind": "foreign_term",
              "value": "har blitt",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", not a simple past s-passive."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Søknaden ble godkjent etter to uker."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The application was approved after two weeks."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_002",
      "role": "model",
      "objective_ids": [
        "obj_s_passive_use"
      ],
      "title": "Where the s-passive fits",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The s-passive is common in neutral instructions, formal descriptions, rules, and scheduled processes. It often sounds less event-focused than the bli-passive."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use present s-passive for general procedures, and use infinitive s-passive after another verb when the passive action is required or planned."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "An infinitive is the base form of a verb, often the form after "
            },
            {
              "kind": "foreign_term",
              "value": "å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". A modal verb is a helper such as "
            },
            {
              "kind": "foreign_term",
              "value": "må",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "kan",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", or "
            },
            {
              "kind": "foreign_term",
              "value": "skal",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". After a modal, the passive verb normally appears as an infinitive s-passive."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Søknader sendes elektronisk."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Applications are submitted electronically."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Skjemaet må sendes før fristen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The form must be sent before the deadline."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Saken skal behandles på neste møte."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The case will be handled at the next meeting."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "tip",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "In signs, forms, policies, and administrative language, the s-passive is often the most natural choice."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_003",
      "role": "contrast",
      "objective_ids": [
        "obj_agent_and_avoidance"
      ],
      "title": "Choosing form and mentioning the doer",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "An agent is the person or thing that performs the action in a passive clause. In Norwegian, an "
            },
            {
              "kind": "foreign_term",
              "value": "av",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "-agent is added only when the doer matters to the message."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Forslaget ble kritisert av flere deltakere."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The proposal was criticized by several participants."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Passet utstedes av politiet."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The passport is issued by the police."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "av",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus an agent when the source of the action is informative; leave it out when it is obvious, unknown, or irrelevant."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "warning",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Avoid old-fashioned simple past s-passives such as "
                },
                {
                  "kind": "foreign_term",
                  "value": "sendtes",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " in modern Bokmål. Use "
                },
                {
                  "kind": "foreign_term",
                  "value": "ble sendt",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " for a normal simple past passive."
                }
              ]
            }
          ]
        }
      ]
    },
