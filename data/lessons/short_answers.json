              [
                {
                  "kind": "text",
                  "value": "Use er after a question with er."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "Bor du her?"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Ja, det gjør jeg."
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Use gjør after a simple action verb."
                }
