{
  "key": "short_answers",
  "concept_slug": "short_answers",
  "grounding_mode": "fallback_no_wiki",
  "title": "Short Answers with ja, nei, and jo",
  "cefr_level": "A1",
  "goal": "Answer yes/no questions with ja, nei, jo, and simple det answers.",
  "objectives": [
    {
      "id": "obj_answer_words",
      "statement": "Choose ja, nei, or jo to answer positive and negative yes/no questions.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_det_answers",
      "statement": "Build basic short answers with det plus verb plus subject.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_match_verb",
      "statement": "Match the short-answer verb to the verb type in the question.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [
        "obj_answer_words"
      ],
      "title": "The Three Answer Words",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian often answers a yes/no question with a short word first. Use "
            },
            {
              "kind": "foreign_term",
              "value": "ja",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for yes and "
            },
            {
              "kind": "foreign_term",
              "value": "nei",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for no."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "foreign_term",
              "value": "Ja",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " means yes. "
            },
            {
              "kind": "foreign_term",
              "value": "Nei",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " means no."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Snakker du norsk? Ja."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Do you speak Norwegian? Yes."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Bor du i Oslo? Nei."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Do you live in Oslo? No."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A negative question already contains a negative meaning, like "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". When you want to answer yes to that kind of question, Norwegian uses "
            },
            {
              "kind": "foreign_term",
              "value": "jo",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", not "
            },
            {
              "kind": "foreign_term",
              "value": "ja",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "jo",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " to say yes to a negative question."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Kommer du ikke? Jo."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Are you not coming? Yes, I am."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_001",
      "role": "model",
      "objective_ids": [
        "obj_det_answers"
      ],
      "title": "Add a Short Sentence",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "After the answer word, Norwegian can add a short sentence with "
            },
            {
              "kind": "foreign_term",
              "value": "det",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". The pattern is "
            },
            {
              "kind": "foreign_term",
              "value": "det",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus a finite verb plus the subject."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Basic positive short answer pattern: "
            },
            {
              "kind": "foreign_term",
              "value": "ja",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "det",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus verb plus subject."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jobber du her? Ja, det gjør jeg."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Do you work here? Yes, I do."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Er du student? Ja, det er jeg."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Are you a student? Yes, I am."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The word order stays the same in these short answers: "
            },
            {
              "kind": "foreign_term",
              "value": "det",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " first, then the verb, then the subject."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Liker hun kaffe? Ja, det gjør hun."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Does she like coffee? Yes, she does."
            }
          ]
        }
      ]
    },
