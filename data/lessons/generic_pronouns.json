    {
      "element_kind": "section",
      "id": "imported_section_002",
      "role": "contrast",
      "objective_ids": [
        "obj_man_en_roles"
      ],
      "title": "du and folk",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Register means the style level that fits a situation. Generic "
            },
            {
              "kind": "foreign_term",
              "value": "du",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is common in speech, advice, instructions, and informal writing. It can sound direct and natural, but in formal writing it may feel too conversational."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Du bør ikke oppgi passordet ditt til andre."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "You should not give your password to others."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "foreign_term",
              "value": "folk",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is a colloquial noun-like word for people. Colloquial means suitable for everyday conversation rather than polished formal prose. It is useful when you mean people as a group, especially with attitudes, habits, or what people say and do."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Folk glemmer ofte hvor lang tid slike prosesser tar."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "People often forget how long such processes take."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg skjønner ikke hvorfor folk klager på små detaljer."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I do not understand why people complain about small details."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Choose "
            },
            {
              "kind": "foreign_term",
              "value": "man",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " or "
            },
            {
              "kind": "foreign_term",
              "value": "en",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for neutral general statements, generic "
            },
            {
              "kind": "foreign_term",
              "value": "du",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for direct conversational guidance, and "
            },
            {
              "kind": "foreign_term",
              "value": "folk",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for a colloquial people-as-a-group meaning."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_003",
      "role": "model",
      "objective_ids": [
