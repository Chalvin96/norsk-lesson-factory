{
  "key": "generic_pronouns",
  "concept_slug": "generic_pronouns",
  "grounding_mode": "fallback_no_wiki",
  "title": "Saying “People in General”: man, en, du, and folk",
  "cefr_level": "B2",
  "goal": "Choose the right Norwegian generic pronoun for grammar, tone, and sentence role.",
  "objectives": [
    {
      "id": "obj_man_en_roles",
      "statement": "Use man as a subject-only generic pronoun and en or ens where object or possessive forms are needed.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_register",
      "statement": "Distinguish the tone of generic du and colloquial folk from more neutral generic choices.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_produce",
      "statement": "Build natural Bokmål sentences with consistent generic pronoun choice.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_generic_meaning",
      "statement": "Recognize when a pronoun refers to people in general rather than a specific person.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [],
      "title": "The Core Idea",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A generic pronoun means a pronoun that refers to people in general, not to one named person. English often uses you, one, people, or they for this. Norwegian has several choices, and the best choice depends on grammar and tone."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "man",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "en",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", generic "
            },
            {
              "kind": "foreign_term",
              "value": "du",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", or "
            },
            {
              "kind": "foreign_term",
              "value": "folk",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when the sentence is about people generally rather than one particular person."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Man bør lese vilkårene før man signerer."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "People should read the terms before signing."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Du merker fort om teksten er skrevet for hånd."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "You can quickly tell whether the text was written by hand."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "note",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "These forms are about reference and tone, not uncertainty or personal opinion. Keep them separate from stance markers such as probably, apparently, or I think."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_001",
      "role": "contrast",
      "objective_ids": [
        "obj_man_en_roles"
      ],
      "title": "man and en",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The subject is the sentence role that the finite verb is placed after in ordinary main clauses. "
            },
            {
              "kind": "foreign_term",
              "value": "man",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " works only as this generic subject. It is neutral and common in explanations, rules, and formal or semi-formal writing."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The object is the receiver or affected part of the action. "
            },
            {
              "kind": "foreign_term",
              "value": "en",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " can be a generic subject or object. "
            },
            {
              "kind": "foreign_term",
              "value": "ens",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is the possessive form for belonging to one or to a person in general."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "en"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Role"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Form"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Use"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "generic subject"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "man"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "neutral, especially written or explanatory"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "generic subject or object"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "en"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "flexible, often a little more personal"
