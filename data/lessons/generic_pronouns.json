        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Man kan søke digitalt hele året."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "People can apply digitally all year."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det påvirker en mer enn man tror."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "It affects one more than one thinks."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det kan endre ens syn på saken."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "It can change one's view of the matter."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "warning",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Do not use "
                },
                {
                  "kind": "foreign_term",
                  "value": "man",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " as an object. Say "
                },
                {
                  "kind": "foreign_term",
                  "value": "Det påvirker en",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ", not "
                },
                {
                  "kind": "foreign_term",
                  "value": "Det påvirker man",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": "."
                }
              ]
            }
          ]
        }
      ]
