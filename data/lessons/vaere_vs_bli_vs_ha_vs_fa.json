            {
              "kind": "foreign_term",
              "value": "være",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". For a change into that state, use "
            },
            {
              "kind": "foreign_term",
              "value": "bli",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
