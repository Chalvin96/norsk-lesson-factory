  "grounding_mode": "fallback_no_wiki",
  "title": "Be, Become, Have, and Get in Norwegian",
  "cefr_level": "B1",
  "goal": "Choose correctly between være, bli, ha, and få in everyday sentences.",
  "objectives": [
    {
      "id": "obj_state_change",
      "statement": "Distinguish state with være from change with bli.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_possession_receiving",
      "statement": "Distinguish possession with ha from receiving or getting with få.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_auxiliary_like",
      "statement": "Recognize common helping-verb uses of bli, ha, and få.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_production",
      "statement": "Build and correct sentences using the four verbs in context.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [
        "obj_state_change",
        "obj_possession_receiving"
      ],
      "title": "The Four Jobs",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "English uses be, become, have, and get in overlapping ways. Norwegian usually asks you to choose the job more clearly: state, change, possession, or receiving."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "foreign_term",
              "value": "være",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " means be as a state, "
            },
            {
              "kind": "foreign_term",
              "value": "bli",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " means become or stay as a change or result, "
            },
            {
              "kind": "foreign_term",
              "value": "ha",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " means have as possession, and "
            },
            {
              "kind": "foreign_term",
              "value": "få",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " means get, receive, or be allowed to."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "en"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Meaning"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Verb"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Use"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "be"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "være"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "state or identity"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "become, stay, get"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "bli"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "change or resulting state"
                }
