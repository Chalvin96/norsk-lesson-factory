          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "foreign_term",
              "value": "Har",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " can help form the present perfect, a tense for a past action with present relevance. "
            },
            {
              "kind": "foreign_term",
              "value": "Bli",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " can mark a passive meaning, where the subject receives the action. "
            },
            {
              "kind": "foreign_term",
              "value": "Få",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " can mean manage to get something done or get the chance to do it."
            }
          ]
        },
