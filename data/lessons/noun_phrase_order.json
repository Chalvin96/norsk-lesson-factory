    {
      "element_kind": "section",
      "id": "imported_section_002",
      "role": "contrast",
      "objective_ids": [
        "obj_possessive_first"
      ],
      "title": "When the Owner Word Comes First",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A possessive is a word like my, your, or their. When a possessive comes before the noun phrase, it uses the same first slot as a demonstrative: possessive, adjective, noun."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "With a front possessive such as "
            },
            {
              "kind": "foreign_term",
              "value": "min",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", put the possessive before the adjective, and use the plain indefinite noun form after it."
            }
          ]
        },
        {
