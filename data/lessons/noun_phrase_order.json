      "title": "The Basic Slot Order",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A noun phrase is a noun plus words that point to it, describe it, or show who owns it. In Bokmål, those words usually sit in a clear order, so you can build the phrase from left to right."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Basic noun phrase order: demonstrative or possessive first, adjective next, noun last."
            }
          ]
