{
  "key": "noun_phrase_order",
  "concept_slug": "noun_phrase_order",
  "grounding_mode": "fallback_no_wiki",
  "title": "Putting Words in Order Inside Norwegian Noun Phrases",
  "cefr_level": "A2",
  "goal": "Build Bokmål noun phrases with demonstratives, possessives, adjectives, and definiteness in the right order.",
  "objectives": [
    {
      "id": "obj_demonstratives",
      "statement": "Use den, det, and de before adjectives and definite nouns.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_possessive_first",
      "statement": "Build noun phrases with a front possessive such as min before an adjective and noun.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_diagnose_order",
      "statement": "Find and fix common order and agreement errors inside noun phrases.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_order_map",
      "statement": "Recognize the main word order inside a Bokmål noun phrase.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
