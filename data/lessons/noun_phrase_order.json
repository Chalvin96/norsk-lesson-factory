              "kind": "text",
              "value": "I like the old house."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "De små barna leker inne."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The small children are playing inside."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "note",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "This pattern is often called double definiteness because both the pointing word and the noun show definiteness. Here, focus on the order: demonstrative, adjective, definite noun."
                }
              ]
            }
          ]
        }
      ]
