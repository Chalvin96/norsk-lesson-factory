    {
      "element_kind": "section",
      "id": "imported_section_001",
      "role": "model",
      "objective_ids": [
        "obj_demonstratives"
      ],
      "title": "Den, Det, De",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A demonstrative is a pointing word like this, that, these, or those. Bokmål uses "
            },
            {
              "kind": "foreign_term",
              "value": "den",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " with masculine and feminine singular nouns, "
            },
            {
              "kind": "foreign_term",
              "value": "det",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " with neuter singular nouns, and "
            },
            {
              "kind": "foreign_term",
              "value": "de",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " with plural nouns."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "With "
            },
            {
              "kind": "foreign_term",
              "value": "den",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "det",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", or "
            },
            {
              "kind": "foreign_term",
              "value": "de",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus an adjective, the adjective normally takes "
            },
            {
              "kind": "foreign_term",
              "value": "-e",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and the noun is definite, so it has the definite suffix."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "no"
          ],
          "headers": [
            [
              {
