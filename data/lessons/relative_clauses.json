    {
      "element_kind": "section",
      "id": "imported_section_009",
      "role": "model",
      "objective_ids": [
        "obj_som_core"
      ],
      "title": "Prepositions at the end",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "When the relative clause includes a preposition, a small word such as with, to, or about, Norwegian often leaves that preposition at the end of the relative clause. This is natural and common."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use the pattern "
            },
            {
              "kind": "foreign_term",
              "value": "som ... med",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when the clause means that someone does something with the noun."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Dette er kollegaen som jeg jobber med."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "This is the colleague I work with."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Har du sett filmen som de snakket om?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Have you seen the film they talked about?"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun fant nøkkelen som hun lette etter."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She found the key she was looking for."
            }
          ]
        }
      ]
    },
