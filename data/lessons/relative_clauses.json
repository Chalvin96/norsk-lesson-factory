{
  "key": "relative_clauses",
  "concept_slug": "relative_clauses",
  "grounding_mode": "fallback_no_wiki",
  "title": "Building sentences with som",
  "cefr_level": "B1",
  "goal": "Use som to add clear relative clauses about people and things.",
  "objectives": [
    {
      "id": "obj_som_core",
      "statement": "Recognize and use som to connect a noun with extra information about it.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_subject_object",
      "statement": "Distinguish subject and object relative clauses and keep som when it is the subject.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_word_order",
      "statement": "Place sentence adverbs correctly inside relative clauses.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_prepositions",
      "statement": "Use natural Norwegian preposition placement in relative clauses.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [],
      "title": "What som does",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A relative clause is a part of a sentence that gives more information about a noun, such as which person, which book, or which place you mean. In Norwegian, the relative word is usually "
            },
            {
              "kind": "foreign_term",
              "value": "som",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". It works for both people and things."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "som",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " after the noun you want to describe."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg kjenner en lærer som bor i Bergen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I know a teacher who lives in Bergen."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun leser en bok som handler om språk."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She is reading a book that is about language."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "English may use who, which, or that. Norwegian normally uses the same word, "
            },
            {
              "kind": "foreign_term",
              "value": "som",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", for all of them."
            }
          ]
        }
      ]
    },
