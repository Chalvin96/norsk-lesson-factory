      "title": "Word order with ikke",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A relative clause is a subordinate clause, a clause that depends on another part of the sentence. In subordinate clauses, a sentence adverb, such as "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", normally comes before the finite verb."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Say "
            },
            {
              "kind": "foreign_term",
              "value": "som ikke er",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", not "
            },
            {
              "kind": "foreign_term",
              "value": "som er ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg vil ha en jobb som ikke er for stressende."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I want a job that is not too stressful."
            }
          ]
        },
        {
          "kind": "example",
