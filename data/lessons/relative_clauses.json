      "title": "Core pattern",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Use relative clauses when you want to identify or describe a noun more precisely. Start with the noun, add "
            },
            {
              "kind": "foreign_term",
              "value": "som",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and then build a normal subordinate clause after it."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "foreign_term",
                "value": "som",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " works for people and things."
              }
            ],
            [
              {
                "kind": "text",
                "value": "Keep "
              },
              {
                "kind": "foreign_term",
                "value": "som",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " when it is the subject of the relative clause."
              }
            ],
            [
              {
                "kind": "text",
                "value": "Put "
              },
              {
                "kind": "foreign_term",
                "value": "ikke",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " before the finite verb: "
              },
              {
                "kind": "foreign_term",
                "value": "som ikke kommer",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            [
              {
                "kind": "text",
                "value": "Leave common prepositions at the end when that is the natural pattern: "
              },
              {
                "kind": "foreign_term",
                "value": "som jeg jobber med",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": "."
              }
            ]
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg liker mennesker som sier det rett ut."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I like people who say it directly."
            }
          ]
        }
      ]
    },
