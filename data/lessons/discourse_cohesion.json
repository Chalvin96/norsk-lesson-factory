{
  "key": "discourse_cohesion",
  "concept_slug": "discourse_cohesion",
  "grounding_mode": "fallback_no_wiki",
  "title": "Linking Ideas Clearly with Norwegian Connectors",
  "cefr_level": "B2",
  "goal": "Use common connectors with correct word order to link cause, contrast, addition, and concession.",
  "objectives": [
    {
      "id": "obj_cause_addition_contrast",
      "statement": "Choose connectors that express cause, addition, contrast, and concession in natural Bokmål.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_word_order",
      "statement": "Apply main-clause V2 and subordinate-clause word order after key discourse connectors.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_coherent_text",
      "statement": "Build short, coherent Norwegian sentences that connect ideas without changing their meaning.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [
        "obj_cause_addition_contrast"
      ],
      "title": "What Cohesion Does",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A connector is a linking word or phrase that tells the reader how one idea relates to the next. In Norwegian, cohesion is not only about choosing the right connector; it is also about putting the verb in the right position."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use connectors to signal the logical relationship: cause, result, addition, contrast, or concession."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det regnet hele dagen, derfor ble vi hjemme."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "It rained all day, so we stayed home."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi ble hjemme fordi det regnet hele dagen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We stayed home because it rained all day."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The two sentences above describe the same relationship, but they organize it differently. "
            },
            {
              "kind": "foreign_term",
              "value": "derfor",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " points forward to a result. "
            },
            {
              "kind": "foreign_term",
              "value": "fordi",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " introduces the reason."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_001",
      "role": "model",
      "objective_ids": [
        "obj_cause_addition_contrast"
      ],
      "title": "Core Connector Meanings",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "These connectors let you guide the reader through the argument. Choose them by meaning first, then check the word order."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "foreign_term",
                "value": "derfor",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " means therefore or so, and introduces a result."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "fordi",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " means because, and introduces a reason."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "dessuten",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " means besides or furthermore, and adds supporting information."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "derimot",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " means on the other hand or however, and contrasts two points."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "likevel",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " means nevertheless or still, and gives an unexpected result."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "selv om",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " means even though, and introduces a fact that does not stop the main point from being true."
              }
            ]
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Kurset er krevende. Dessuten tar det mye tid."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The course is demanding. Furthermore, it takes a lot of time."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Noen vil vente. Andre vil derimot begynne med en gang."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Some want to wait. Others, however, want to start right away."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Planen var dyr. Vi gjennomførte den likevel."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The plan was expensive. We carried it out nevertheless."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Selv om planen var dyr, gjennomførte vi den."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Even though the plan was expensive, we carried it out."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_002",
      "role": "contrast",
      "objective_ids": [
        "obj_word_order"
      ],
      "title": "Word Order After Connectors",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian has different word order after different connector types. In a main clause, the verb usually comes in second position. In a subordinate clause after subordinating conjunctions such as "
            },
            {
              "kind": "foreign_term",
              "value": "fordi",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " and "
            },
            {
              "kind": "foreign_term",
              "value": "selv om",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", the subject stays before the verb."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "foreign_term",
              "value": "derfor",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "likevel",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "dessuten",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and "
            },
            {
              "kind": "foreign_term",
              "value": "derimot",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " can begin a main clause, so the finite verb normally comes immediately after them."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Møtet ble avlyst. Derfor dro vi hjem."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The meeting was cancelled. Therefore, we went home."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun var sliten. Likevel fortsatte hun å jobbe."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She was tired. Nevertheless, she continued working."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Prisen er høy. Derimot er kvaliteten svært god."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The price is high. On the other hand, the quality is very good."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "foreign_term",
              "value": "fordi",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " and "
            },
            {
              "kind": "foreign_term",
              "value": "selv om",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " introduce subordinate clauses, so the subject normally comes before the finite verb inside that clause."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi utsatte reisen fordi været var dårlig."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We postponed the trip because the weather was bad."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Selv om været var dårlig, dro vi likevel."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Even though the weather was bad, we still went."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "warning",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Do not use English word order after a fronted main-clause connector. Write "
                },
                {
                  "kind": "foreign_term",
                  "value": "Derfor dro vi",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ", not "
                },
                {
                  "kind": "foreign_term",
                  "value": "Derfor vi dro",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": "."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_003",
      "role": "recap",
      "objective_ids": [
        "obj_cause_addition_contrast",
        "obj_word_order",
        "obj_coherent_text"
      ],
      "title": "Working Checklist",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "When a sentence sounds uneven, check both the logic and the grammar. The connector should match the relationship, and the clause after it should have the right word order."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": true,
          "items": [
            [
              {
                "kind": "text",
                "value": "Ask what the second idea does: explains, adds, contrasts, or concedes."
              }
            ],
            [
              {
                "kind": "text",
                "value": "Choose the connector that matches that relationship."
              }
            ],
            [
              {
                "kind": "text",
                "value": "If the connector begins a main clause, place the finite verb second."
              }
            ],
            [
              {
                "kind": "text",
                "value": "If the connector introduces a subordinate clause, keep the subject before the finite verb inside that clause."
              }
            ]
          ]
        }
      ]
    },
