    {
      "element_kind": "exercise",
      "id": "ex_choose_concession",
      "operation": "choose",
      "objective_id": "obj_coherent_text",
      "bloom_level": "understand",
      "prompt": [
        {
          "kind": "text",
          "value": "Choose the most natural cohesive sentence."
        }
      ],
      "explanation": [
        {
          "kind": "text",
          "value": "The correct sentence uses "
