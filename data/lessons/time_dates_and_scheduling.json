      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_clock_parts",
      "statement": "Recognize halv, kvart over, and kvart på as parts of the hour.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_dates",
      "statement": "Read and write simple Norwegian dates in day-month order.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_schedule",
      "statement": "Use simple day and time expressions to make short plans.",
      "bloom_targets": [
        "understand"
      ]
