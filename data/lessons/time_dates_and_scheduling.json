  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [
        "obj_clock_basic",
        "obj_schedule"
      ],
      "title": "Time Words For Plans",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian uses short, direct time expressions for everyday plans. The key word for clock time is "
            },
            {
              "kind": "foreign_term",
              "value": "klokka",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", which can mean the clock, the time, or o’clock depending on the sentence."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "klokka",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " before ordinary clock times; do not add a translated preposition for English at."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hva er klokka?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "What time is it?"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Klokka er sju."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "It is seven o’clock."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi møtes klokka åtte."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We are meeting at eight o’clock."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "For simple scheduling, you can combine a day word with a clock time. Day words and month names are normally lowercase in Norwegian."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg jobber i morgen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I work tomorrow."
            }
          ]
        }
      ]
    },
