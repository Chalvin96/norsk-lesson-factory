{
  "key": "punctuation_and_commas",
  "concept_slug": "punctuation_and_commas",
  "grounding_mode": "fallback_no_wiki",
  "title": "Periods, Questions, Exclamations, and Commas",
  "cefr_level": "A2",
  "goal": "Use Norwegian end punctuation and the most common comma patterns in short sentences.",
  "objectives": [
    {
      "id": "obj_end_marks",
      "statement": "Choose the correct end punctuation for statements, questions, and strong reactions.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_commas_clauses",
      "statement": "Place commas with subordinate clauses and connected main clauses in common short sentences.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_commas_lists_address",
      "statement": "Use commas in simple lists and direct address.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [
        "obj_end_marks"
      ],
      "title": "End Punctuation",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian uses the same basic end punctuation as English. A period ends a normal statement, a question mark ends a direct question, and an exclamation mark marks a strong feeling or command. In everyday writing, one exclamation mark is enough."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": ".",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for a statement, "
            },
            {
              "kind": "foreign_term",
              "value": "?",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for a direct question, and "
            },
            {
              "kind": "foreign_term",
              "value": "!",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for a strong reaction or command."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg bor i Bergen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I live in Bergen."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Bor du i Bergen?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Do you live in Bergen?"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Kom hit!"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Come here!"
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A direct question has question word order or a question word. An indirect question is reported inside a statement, so it normally ends with a period."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Når kommer bussen?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "When does the bus arrive?"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg vet ikke når bussen kommer."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I do not know when the bus arrives."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_001",
      "role": "model",
      "objective_ids": [
        "obj_commas_clauses"
      ],
      "title": "Commas With Clauses",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A clause is a part of a sentence with its own verb. A main clause can stand alone as a sentence. A subordinate clause is a clause introduced by words such as "
            },
            {
              "kind": "foreign_term",
              "value": "fordi",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "hvis",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "at",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", or "
            },
            {
              "kind": "foreign_term",
              "value": "som",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " and depends on another clause."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "When a subordinate clause comes first, put a comma before the main clause."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hvis det regner, tar jeg bussen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "If it rains, I take the bus."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Fordi jeg er trøtt, går jeg hjem."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Because I am tired, I am going home."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "When the main clause comes first and the subordinate clause follows naturally, Norwegian usually does not use a comma."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg tar bussen hvis det regner."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I take the bus if it rains."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Put a comma between two main clauses joined by "
            },
            {
              "kind": "foreign_term",
              "value": "og",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "men",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "for",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", or "
            },
            {
              "kind": "foreign_term",
              "value": "så",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when both sides have their own subject and finite verb. A finite verb is the verb that shows tense, such as "
            },
            {
              "kind": "foreign_term",
              "value": "kommer",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " or "
            },
            {
              "kind": "foreign_term",
              "value": "spiste",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg lager middag, og Maria vasker opp."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I make dinner, and Maria washes up."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg lager middag og vasker opp."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I make dinner and wash up."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "tip",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Punctuation does not change the word order rules you already use. If a sentence begins with "
                },
                {
                  "kind": "foreign_term",
                  "value": "Hvis det regner",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ", the comma only marks the clause boundary."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_002",
      "role": "contrast",
      "objective_ids": [
        "obj_commas_lists_address"
      ],
      "title": "Lists and Direct Address",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Commas also help the reader separate small pieces inside a sentence. The two most useful patterns are simple lists and direct address, where you name the person you are speaking to."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use commas between items in a list, but normally not before "
            },
            {
              "kind": "foreign_term",
              "value": "og",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " before the last item."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg kjøper brød, melk og ost."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I am buying bread, milk, and cheese."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi trenger kopper, tallerkener, kniver og gafler."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We need cups, plates, knives, and forks."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use a comma before or after a name when you speak directly to someone."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Kan du hjelpe meg, Ali?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Can you help me, Ali?"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Maria, hvor er nøkkelen?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Maria, where is the key?"
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_003",
      "role": "recap",
      "objective_ids": [
        "obj_end_marks",
        "obj_commas_clauses",
        "obj_commas_lists_address"
      ],
      "title": "Quick Check",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The main punctuation choice is first about sentence type: statement, direct question, or strong command. Commas then show useful boundaries inside the sentence."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "text",
                "value": "End a normal statement with "
              },
              {
                "kind": "foreign_term",
                "value": ".",
                "lang": "no"
              }
            ],
            [
              {
                "kind": "text",
                "value": "End a direct question with "
              },
              {
                "kind": "foreign_term",
                "value": "?",
                "lang": "no"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Use "
              },
              {
                "kind": "foreign_term",
                "value": "!",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " sparingly for strong feeling or commands."
              }
            ],
            [
              {
                "kind": "text",
                "value": "Use a comma after a first-position subordinate clause."
              }
            ],
            [
              {
                "kind": "text",
                "value": "Use commas in simple lists and with direct address."
              }
            ]
          ]
        }
      ]
    },
