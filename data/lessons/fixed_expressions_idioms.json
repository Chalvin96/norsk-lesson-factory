{
  "key": "fixed_expressions_idioms",
  "concept_slug": "fixed_expressions_idioms",
  "grounding_mode": "fallback_no_wiki",
  "title": "Fixed Expressions and Idioms in Bokmål",
  "cefr_level": "B2",
  "goal": "Recognize and use common fixed Norwegian expressions without changing their frozen forms.",
  "objectives": [
    {
      "id": "obj_fixed_meaning",
      "statement": "Recognize fixed expressions as whole units whose meaning is not always built word by word.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_fixed_patterns",
      "statement": "Choose the correct adjective-preposition and verb-preposition pattern in common expressions.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_fixed_forms",
      "statement": "Preserve articleless, fossilized, and idiomatic pronoun forms in fixed phrases.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [
        "obj_fixed_meaning"
      ],
      "title": "Learn the expression as a unit",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A fixed expression is a group of words that normally stays in one learned shape. In Norwegian, many useful expressions have a fixed preposition, fixed article pattern, or fixed pronoun. Translate the whole expression, not each word separately."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Treat a fixed expression as one vocabulary item: keep its normal words, order, and preposition unless you have a clear model for changing it."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Du må være klar over at fristen er i morgen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "You must be aware that the deadline is tomorrow."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det sier seg selv at vi må svare raskt."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "It goes without saying that we must answer quickly."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "warning",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Do not freely replace the preposition in an idiom. For example, "
                },
                {
                  "kind": "foreign_term",
                  "value": "være klar over",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " uses "
                },
                {
                  "kind": "foreign_term",
                  "value": "over",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ", even when English uses a different pattern."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_001",
      "role": "model",
      "objective_ids": [
        "obj_fixed_patterns"
      ],
      "title": "Adjective plus preposition patterns",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Some common Norwegian expressions are built with an adjective, plus a fixed preposition, a small relationship word such as "
            },
            {
              "kind": "foreign_term",
              "value": "i",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "av",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", or "
            },
            {
              "kind": "foreign_term",
              "value": "til",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". The adjective may change for agreement in ordinary grammar, but the expression's preposition does not change."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "no",
            "en",
            "en"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Expression"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Usual meaning"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Pattern to keep"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "være klar over"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "be aware of"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "keep over"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "være glad i"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "like, be fond of"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "keep i"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "bli lei av"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "get tired of"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "keep av"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "være vant til"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "be used to"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "keep til"
                }
              ]
            ]
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun er glad i sterke oster."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She likes strong cheeses."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg blir lei av møter uten agenda."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I get tired of meetings without an agenda."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "De er vant til kalde vintre."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "They are used to cold winters."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_002",
      "role": "contrast",
      "objective_ids": [
        "obj_fixed_forms"
      ],
      "title": "Articleless and fossilized phrases",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Several fixed prepositional phrases have no article, even when English uses one. A prepositional phrase is a preposition plus the words that follow it. Some forms also preserve older-looking endings, so the modern singular noun may not look exactly as you expect."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "In articleless fixed phrases, do not add "
            },
            {
              "kind": "foreign_term",
              "value": "en",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "ei",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "et",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", or a definite ending unless the fixed expression itself contains it."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi gikk til fots fra stasjonen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We walked on foot from the station."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Glasset gikk i stykker da det falt."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The glass broke when it fell."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det er på tide å bestille billetter."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "It is time to book tickets."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "tip",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "You can often understand these phrases from context, but you produce them best by memorizing the exact short expression."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_003",
      "role": "model",
      "objective_ids": [
        "obj_fixed_forms"
      ],
      "title": "Fixed pronoun and reflexive forms",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Some idioms contain a pronoun, a small word that points to a person or thing, or a reflexive pronoun, a pronoun that points back to the subject. In these expressions, the pronoun is part of the idiom."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Keep idiomatic pronoun forms fixed when the whole expression is fixed: "
            },
            {
              "kind": "foreign_term",
              "value": "det sier seg selv",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " keeps both "
            },
            {
              "kind": "foreign_term",
              "value": "det",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " and "
            },
            {
              "kind": "foreign_term",
              "value": "seg selv",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det sier seg selv at vilkårene må være tydelige."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "It goes without saying that the terms must be clear."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun tok seg av saken med en gang."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She took care of the matter right away."
            }
          ]
        }
      ]
    },
