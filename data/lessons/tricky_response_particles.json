              "value": "Do you like coffee? Yes, I like coffee."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Liker du ikke kaffe? Jo, jeg liker kaffe."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Don't you like coffee? Yes, I do like coffee."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Liker du kaffe? Nei, jeg liker ikke kaffe."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Do you like coffee? No, I don't like coffee."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_002",
      "role": "contrast",
      "objective_ids": [
        "obj_ogsa_heller"
      ],
      "title": "Også and Heller",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "For additions, English uses too in positive sentences and either in negative sentences. Norwegian has the same kind of split: "
            },
            {
              "kind": "foreign_term",
              "value": "også",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " belongs with positive additions, and "
            },
            {
              "kind": "foreign_term",
              "value": "heller",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " belongs with negative additions."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "også",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when the sentence is affirmative. Use "
            },
            {
              "kind": "foreign_term",
              "value": "heller",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when the sentence is negative with "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg kommer også."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I am coming too."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg kommer heller ikke."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I am not coming either."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun snakker norsk også."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She speaks Norwegian too."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun snakker heller ikke norsk."
            }
          ],
          "en": [
