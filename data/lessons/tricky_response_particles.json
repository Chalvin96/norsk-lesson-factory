                  "kind": "foreign_term",
                  "value": "Jeg også",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " means me too, and "
                },
                {
                  "kind": "foreign_term",
                  "value": "Ikke jeg heller",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " means me neither."
                }
              ]
            }
          ]
        }
      ]
    },
