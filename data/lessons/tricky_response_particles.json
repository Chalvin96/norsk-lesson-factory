{
  "key": "tricky_response_particles",
  "concept_slug": "tricky_response_particles",
  "grounding_mode": "fallback_no_wiki",
  "title": "Answering Yes, No, Too, and Either",
  "cefr_level": "A2",
  "goal": "Choose the right Norwegian answer word for positive, negative, and additive replies.",
  "objectives": [
    {
      "id": "obj_ja_jo_nei",
      "statement": "Distinguish ja, jo, and nei in short answers.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_ogsa_heller",
      "statement": "Use også in affirmative additions and heller in negative additions.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_position",
      "statement": "Place også and heller naturally with ikke in short Norwegian sentences.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [
        "obj_ja_jo_nei",
        "obj_ogsa_heller"
      ],
      "title": "Small Words, Big Meaning",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian uses short answer words such as yes and no more precisely than English. The important point is not only whether your answer is positive or negative, but also what kind of question you are answering."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "ja",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " to say yes to a positive question, "
            },
            {
              "kind": "foreign_term",
              "value": "jo",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " to say yes against a negative question or assumption, and "
            },
            {
              "kind": "foreign_term",
              "value": "nei",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " to answer no."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Kommer du i dag? Ja."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Are you coming today? Yes."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Kommer du ikke i dag? Jo."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Aren't you coming today? Yes, I am."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Kommer du i dag? Nei."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Are you coming today? No."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_001",
      "role": "contrast",
      "objective_ids": [
        "obj_ja_jo_nei"
      ],
      "title": "Ja, Jo, Nei",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A positive question expects a direct yes or no. A negative question contains "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and a positive answer to that kind of question uses "
            },
            {
              "kind": "foreign_term",
              "value": "jo",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". Think of "
            },
            {
              "kind": "foreign_term",
              "value": "jo",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " as yes, actually."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "en"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Situation"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Answer"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Meaning"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "Positive question"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "ja"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Yes"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "Negative question, positive answer"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "jo"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Yes, actually"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "Any question, negative answer"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "nei"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "No"
                }
              ]
            ]
          ]
        },
        {
          "kind": "example",
