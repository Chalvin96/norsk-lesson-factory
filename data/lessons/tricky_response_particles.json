      "title": "Position With Ikke",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "In simple main clauses, place "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " after the finite verb. For negative additions, "
            },
            {
              "kind": "foreign_term",
              "value": "heller ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is often the most natural written pattern."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "A common pattern is subject plus verb plus "
            },
            {
              "kind": "foreign_term",
              "value": "heller ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus object or extra information."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi har heller ikke tid."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We don't have time either."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "De bor heller ikke her."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "They don't live here either."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "tip",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
