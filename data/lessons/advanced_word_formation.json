    {
      "element_kind": "section",
      "id": "imported_section_001",
      "role": "model",
      "objective_ids": [
        "obj_compound_structure"
      ],
      "title": "Linking Elements",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A linking element is a small sound or letter, often "
            },
            {
              "kind": "foreign_term",
              "value": "s",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " or "
            },
            {
              "kind": "foreign_term",
              "value": "e",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", placed between compound parts. It does not usually carry a separate meaning, but it often marks a form that sounds and looks natural in Bokmål."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "In established compounds, keep the conventional linking element; do not add or remove "
            },
            {
              "kind": "foreign_term",
              "value": "s",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " only because English has a separate word."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "God kunnskap om arbeidsliv er viktig for rådgivere."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Good knowledge of working life is important for advisers."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Forskningsspørsmålet må være tydelig."
            }
          ],
          "en": [
            {
              "kind": "foreign_term",
              "value": "Forskningsspørsmål",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " uses linking "
            },
            {
              "kind": "foreign_term",
              "value": "s",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " after "
            },
            {
              "kind": "foreign_term",
              "value": "forskning",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Barnehageansatte trenger tydelige rutiner."
            }
          ],
          "en": [
            {
              "kind": "foreign_term",
              "value": "Barnehageansatte",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " has "
            },
            {
              "kind": "foreign_term",
              "value": "barnehage",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " before the head word "
            },
            {
              "kind": "foreign_term",
              "value": "ansatte",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "tip",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "When you meet a long word, check a dictionary for the whole compound if the linking element is uncertain. The pattern is learnable, but many compounds are conventional."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_002",
