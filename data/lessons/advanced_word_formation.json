              "value": "Use a three-step check for advanced Bokmål word formation: locate the head word, identify any linking element, and notice prefixes or suffixes that turn an action, quality, or relation into a noun."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": true,
          "items": [
            [
              {
                "kind": "text",
                "value": "Find the final head word and ask what kind of thing the whole word names."
              }
            ],
            [
              {
                "kind": "text",
                "value": "Check whether a conventional linking element such as "
              },
              {
                "kind": "foreign_term",
                "value": "s",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " or "
              },
              {
                "kind": "foreign_term",
                "value": "e",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " belongs between the parts."
              }
            ],
            [
              {
                "kind": "text",
                "value": "Recognize suffixes such as "
              },
              {
                "kind": "foreign_term",
                "value": "-ing",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "kind": "foreign_term",
                "value": "-else",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "kind": "foreign_term",
                "value": "-skap",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "kind": "foreign_term",
                "value": "-het",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " as clues to abstract nouns."
              }
            ],
            [
              {
                "kind": "text",
                "value": "Treat less transparent words as established vocabulary, even when their parts are visible."
              }
            ]
          ]
        }
