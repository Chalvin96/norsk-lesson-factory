      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [],
      "title": "Start from the Head Word",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Bokmål often builds precise words by joining smaller words into one compound, a single written word made from two or more parts. In a compound, the last part is usually the head word: the part that decides the basic category and core meaning."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Read long Bokmål compounds from right to left first: find the final head word, then let the earlier parts narrow its meaning."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Arbeidsliv endrer seg raskt i mange bransjer."
            }
          ],
          "en": [
            {
              "kind": "foreign_term",
              "value": "Arbeidsliv",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " means working life: "
            },
            {
              "kind": "foreign_term",
              "value": "liv",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is the head word, and "
            },
            {
              "kind": "foreign_term",
              "value": "arbeid",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " narrows which kind of life."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Studenten valgte samfunnsvitenskap fordi hun var interessert i politikk."
            }
          ],
          "en": [
            {
              "kind": "foreign_term",
              "value": "Samfunnsvitenskap",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " means social science: "
            },
            {
              "kind": "foreign_term",
              "value": "vitenskap",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is the head word."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Many advanced words are built in layers. You do not need to memorize every long word as a whole if you can separate the layers and identify the head word."
            }
          ]
        },
