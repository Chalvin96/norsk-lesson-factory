    {
      "element_kind": "section",
      "id": "imported_section_003",
      "role": "contrast",
      "objective_ids": [
        "obj_compound_structure"
      ],
      "title": "Less Transparent Forms",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Some advanced words are only partly transparent. You can still analyze them, but the modern meaning is not always the sum of the visible parts."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use word formation to guide meaning, then confirm the established meaning of less transparent words from context or a dictionary."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "En god problemstilling gjør teksten mer presis."
            }
          ],
          "en": [
            {
              "kind": "foreign_term",
              "value": "Problemstilling",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is not just a problem plus a position; in academic writing it means a research question or formulation of the issue."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Saksbehandleren vurderte lovgrunnlaget nøye."
            }
          ],
          "en": [
            {
              "kind": "foreign_term",
              "value": "Lovgrunnlag",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " means legal basis; the head word "
            },
            {
              "kind": "foreign_term",
              "value": "grunnlag",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " controls the core meaning."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "warning",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Do not split a standard compound into separate words in ordinary Bokmål writing. Write "
                },
                {
                  "kind": "foreign_term",
                  "value": "samfunnsvitenskap",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ", not "
