      "title": "Derivation for Abstract Ideas",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Derivation means making a new word by adding a prefix, a word part at the beginning, or a suffix, a word part at the end. The stem is the core part that carries the main meaning."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Common Bokmål suffixes such as "
            },
            {
              "kind": "foreign_term",
              "value": "-ing",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "-else",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "-skap",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " and "
            },
            {
              "kind": "foreign_term",
              "value": "-het",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " often form abstract nouns, nouns for ideas, actions, qualities, or states."
            }
          ]
        },
        {
