  "title": "Build and Read Advanced Bokmål Words",
  "cefr_level": "B2",
  "goal": "Analyze and form complex Bokmål compounds and derived nouns accurately.",
  "objectives": [
    {
      "id": "obj_compound_structure",
      "statement": "Identify the main word and meaning direction in complex Bokmål compounds.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_linking_elements",
      "statement": "Recognize and choose common linking elements in longer compounds.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_derivation",
      "statement": "Use common prefixes and suffixes to form abstract nouns and participant nouns.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_diagnose_production",
      "statement": "Diagnose and repair word-formation errors in formal Bokmål.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
