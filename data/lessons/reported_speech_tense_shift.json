{
  "key": "reported_speech_tense_shift",
  "concept_slug": "reported_speech_tense_shift",
  "grounding_mode": "fallback_no_wiki",
  "title": "Reported Speech: Tense, Word Order, and Time Shifts",
  "cefr_level": "B2",
  "goal": "Report statements, questions, and commands with natural tense, pronoun, and time-place shifts.",
  "objectives": [
    {
      "id": "obj_indirect_statements",
      "statement": "Convert direct statements into indirect speech with at and correct subordinate word order.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_tense_shift",
      "statement": "Choose natural tense shifts after past reporting verbs, including hadde and skulle.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_deictic_shift",
      "statement": "Shift pronouns, time words, and place words according to the reporting situation.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_questions_commands",
      "statement": "Report yes-no questions, information questions, and commands using om, question words, and å-clauses.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [
        "obj_indirect_statements",
        "obj_tense_shift",
        "obj_deictic_shift"
      ],
      "title": "What Changes in Reported Speech",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Indirect speech reports what someone said without quoting the exact words. It usually changes more than the reporting verb. You often adjust the person, the time, the place, and sometimes the tense."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "sa at",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for reported statements, and put the reported message in a subordinate clause introduced by a subordinating conjunction such as "
            },
            {
              "kind": "foreign_term",
              "value": "at",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " or "
            },
            {
              "kind": "foreign_term",
              "value": "om",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun sa: «Jeg kommer ikke i morgen.»"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She said, “I am not coming tomorrow.”"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun sa at hun ikke kom dagen etter."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She said that she was not coming the next day."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "In the indirect version, "
            },
            {
              "kind": "foreign_term",
              "value": "jeg",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " becomes "
            },
            {
              "kind": "foreign_term",
              "value": "hun",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "i morgen",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " becomes "
            },
            {
              "kind": "foreign_term",
              "value": "dagen etter",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and the verb often moves back in time because the reporting verb is in the past."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_001",
      "role": "model",
      "objective_ids": [
        "obj_indirect_statements"
      ],
      "title": "Subordinate Word Order",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Reported speech after "
            },
            {
              "kind": "foreign_term",
              "value": "at",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " uses subordinate word order. A sentence adverb comments on the whole clause. Examples include "
            },
            {
              "kind": "foreign_term",
              "value": "ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " or "
            },
            {
              "kind": "foreign_term",
              "value": "alltid",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", comes before the finite verb."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "In an "
            },
            {
              "kind": "foreign_term",
              "value": "at",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " clause, use subject plus sentence adverb plus finite verb: "
            },
            {
              "kind": "foreign_term",
              "value": "hun ikke kom",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", not "
            },
            {
              "kind": "foreign_term",
              "value": "hun kom ikke",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Lars sa at han ikke hadde tid."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Lars said that he did not have time."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "De forklarte at møtet ikke begynte før klokka ti."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "They explained that the meeting did not start until ten o’clock."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "warning",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Main clauses can have verb-second order after fronted phrases, but reported "
                },
                {
                  "kind": "foreign_term",
                  "value": "at",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " and "
                },
                {
                  "kind": "foreign_term",
                  "value": "om",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " clauses keep subordinate word order."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_002",
      "role": "contrast",
      "objective_ids": [
        "obj_tense_shift"
      ],
      "title": "Tense, Time, and Place Shifts",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "When the reporting verb is in the past, Norwegian often shifts the reported tense back. This is natural when the original statement is no longer tied to the speaker’s present moment."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "no"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Meaning"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Direct speech"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Indirect speech after a past reporting verb"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "present becomes simple past"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Jeg bor her."
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Hun sa at hun bodde der."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "present perfect becomes past perfect"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Jeg har gjort det."
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Han sa at han hadde gjort det."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "future with skal becomes skulle"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Vi skal dra i morgen."
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "De sa at de skulle dra dagen etter."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "now becomes then when the time has moved"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Jeg er opptatt nå."
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Hun sa at hun var opptatt da."
                }
              ]
            ]
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The simple past, called "
            },
            {
              "kind": "foreign_term",
              "value": "preteritum",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " in Norwegian grammar, often reports an original present. The past perfect, called "
            },
            {
              "kind": "foreign_term",
              "value": "pluskvamperfektum",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", often reports an original present perfect or simple past when you need to show that something happened before the reporting moment."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Maja sa at hun hadde sendt dokumentene."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Maja said that she had sent the documents."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "De sa at de skulle møtes der."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "They said that they were going to meet there."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "tip",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Do not shift mechanically if the original fact is still presented as generally true. "
                },
                {
                  "kind": "foreign_term",
                  "value": "Læreren sa at Oslo er hovedstaden",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " can be natural because the fact is still true."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_003",
      "role": "model",
      "objective_ids": [
        "obj_questions_commands"
      ],
      "title": "Reporting Questions and Commands",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Questions and commands also become subordinate structures. A yes-no question becomes an "
            },
            {
              "kind": "foreign_term",
              "value": "om",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " clause. An information question keeps the question word. A command becomes an infinitive: the base form with "
            },
            {
              "kind": "foreign_term",
              "value": "å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "spurte om",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for yes-no questions, a question word for information questions, and "
            },
            {
              "kind": "foreign_term",
              "value": "ba ... om å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " or "
            },
            {
              "kind": "foreign_term",
              "value": "sa at ... skulle",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " for commands, depending on meaning."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Han spurte: «Kommer du i dag?»"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "He asked, “Are you coming today?”"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Han spurte om jeg kom den dagen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "He asked whether I was coming that day."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Sjefen spurte hvor rapporten var."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The boss asked where the report was."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun ba meg om å sende svaret dagen etter."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She asked me to send the answer the next day."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_004",
      "role": "recap",
      "objective_ids": [
        "obj_indirect_statements",
        "obj_tense_shift",
