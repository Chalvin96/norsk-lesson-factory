      "title": "Core Pattern",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "For accurate reported speech, first choose the reporting frame, then build a subordinate clause, then check tense, pronouns, time, and place."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": true,
          "items": [
            [
              {
                "kind": "text",
                "value": "Statement: "
              },
              {
                "kind": "foreign_term",
                "value": "Hun sa at ...",
                "lang": "no"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Yes-no question: "
              },
              {
                "kind": "foreign_term",
                "value": "Hun spurte om ...",
                "lang": "no"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Information question: keep the question word, as in "
              },
              {
                "kind": "foreign_term",
                "value": "hvor",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " or "
              },
              {
                "kind": "foreign_term",
                "value": "hvorfor",
                "lang": "no"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Command: use an "
              },
              {
                "kind": "foreign_term",
                "value": "å",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " phrase or a "
              },
              {
                "kind": "foreign_term",
                "value": "skulle",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " clause"
              }
            ]
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "After "
            },
            {
              "kind": "foreign_term",
              "value": "at",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " or "
            },
            {
              "kind": "foreign_term",
              "value": "om",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", keep subordinate word order and shift words like "
            },
            {
              "kind": "foreign_term",
              "value": "her",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "nå",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and "
            },
            {
              "kind": "foreign_term",
              "value": "i morgen",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when the reporting situation has changed."
            }
          ]
        }
      ]
    },
