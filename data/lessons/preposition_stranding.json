      ],
      "title": "Relative Clauses With Som",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A relative clause is a small sentence-like group that describes a noun. In Norwegian it often starts with "
            },
            {
              "kind": "foreign_term",
              "value": "som",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". When the described noun is connected to a preposition inside the relative clause, the preposition usually stays inside the clause, often at the end."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "In relative clauses with "
            },
            {
              "kind": "foreign_term",
              "value": "som",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", leave the preposition after the verb, adjective, or noun expression it belongs to."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Det er en venn som jeg ofte reiser med."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "That is a friend who I often travel with."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Her er boka som jeg fortalte deg om."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Here is the book that I told you about."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun fant en jobb som hun er kvalifisert for."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She found a job that she is qualified for."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "tip",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "For relative clauses, remember the patterns "
                },
                {
                  "kind": "foreign_term",
                  "value": "som ... for",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " and "
                },
                {
                  "kind": "foreign_term",
                  "value": "som ... om",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ". The preposition still belongs to the expression near the end."
                }
              ]
            }
          ]
        }
      ]
