{
  "key": "preposition_stranding",
  "concept_slug": "preposition_stranding",
  "grounding_mode": "fallback_no_wiki",
  "title": "Leaving the Preposition at the End",
  "cefr_level": "B1",
  "goal": "Ask questions and make relative clauses with the preposition in natural Bokmål position.",
  "objectives": [
    {
      "id": "obj_notice_stranding",
      "statement": "Recognize that Norwegian often leaves the preposition after the verb phrase in questions and relative clauses.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_questions",
      "statement": "Choose natural word order for questions such as hvem ... med and hva ... på.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_relative_clauses",
      "statement": "Use stranded prepositions in relative clauses with som and det.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_avoid_pied_piping",
      "statement": "Identify and fix forced English-style preposition placement in ordinary Bokmål sentences.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [
        "obj_notice_stranding"
      ],
      "title": "The Basic Pattern",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A preposition is a small relationship word such as "
            },
            {
              "kind": "foreign_term",
              "value": "på",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "om",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "for",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", or "
            },
            {
              "kind": "foreign_term",
              "value": "med",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". In natural Bokmål, when that preposition belongs with a question word or a relative clause, it often stays later in the sentence, usually after the verb or adjective it belongs to."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "In everyday Bokmål, put the question word or relative word first, and leave the preposition where the phrase naturally ends."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hvem snakket du med?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Who did you talk with?"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hva tenker du på?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "What are you thinking about?"
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "English can sometimes move the preposition to the front, as in "
            },
            {
              "kind": "foreign_term",
              "value": "with whom",
              "lang": "en"
            },
            {
              "kind": "text",
              "value": ". Norwegian can do this in formal writing, but in ordinary speech and most learner writing, the stranded pattern is the natural choice."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "note",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Use these anchor patterns as a memory handle: "
                },
                {
                  "kind": "foreign_term",
                  "value": "hvem ... med",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " and "
                },
                {
                  "kind": "foreign_term",
                  "value": "hva ... på",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": "."
                }
              ]
            }
          ]
        }
      ]
    },
