    {
      "element_kind": "exercise",
      "id": "ex_categorize_short",
      "operation": "categorize",
      "objective_id": "obj_short_replies",
      "bloom_level": "understand",
      "prompt": [
        {
          "kind": "text",
          "value": "Sort the replies by what they do."
        }
      ],
