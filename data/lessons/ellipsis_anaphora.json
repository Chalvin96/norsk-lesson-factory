{
  "key": "ellipsis_anaphora",
  "concept_slug": "ellipsis_anaphora",
  "grounding_mode": "fallback_no_wiki",
  "title": "Leaving Words Out and Pointing Back",
  "cefr_level": "B2",
  "goal": "Use omission, det, gjøre det, gjerne, samme her, and slik to avoid unnecessary repetition in Bokmål.",
  "objectives": [
    {
      "id": "obj_ellipsis",
      "statement": "Recognize when Norwegian leaves repeated words out because the context already supplies them.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_det_gjore",
      "statement": "Use det and gjøre det to point back to a previous idea, action, or whole clause.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_short_replies",
      "statement": "Produce natural short replies with gjerne, samme her, and det gjør jeg.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_slik",
      "statement": "Use slik to refer back to a way, manner, pattern, or formulation.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [
        "obj_ellipsis",
        "obj_det_gjore"
      ],
      "title": "What Gets Left Out",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian often avoids repeating information when the listener can recover it from the previous sentence. Ellipsis means leaving out words that context already supplies. Anaphoric reference means using a word such as "
            },
            {
              "kind": "foreign_term",
              "value": "det",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " to point back to something already mentioned."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use ellipsis only when the missing words are clear from the immediate context; use anaphoric forms when one short word can point back to a whole idea."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vil du ha kaffe? Gjerne."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Would you like coffee? Sure."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg er litt trøtt i dag. Samme her."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I am a little tired today. Same here."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "In the first example, "
            },
            {
              "kind": "foreign_term",
              "value": "gjerne",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " stands in for a fuller answer such as "
            },
            {
              "kind": "foreign_term",
              "value": "Jeg vil gjerne ha kaffe",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". In the second, "
            },
            {
              "kind": "foreign_term",
              "value": "samme her",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " points back to the whole situation just described."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_001",
      "role": "model",
      "objective_ids": [
        "obj_det_gjore"
      ],
      "title": "Det and Gjøre Det",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "foreign_term",
              "value": "Det",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " can point back to a noun, a situation, or an entire previous clause. With actions, Norwegian often uses "
            },
            {
              "kind": "foreign_term",
              "value": "gjøre det",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " as a pro-verb: a stand-in for the repeated action."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "When "
            },
            {
              "kind": "foreign_term",
              "value": "gjøre det",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " points back to an action, keep the finite verb in the right tense: "
            },
            {
              "kind": "foreign_term",
              "value": "gjør",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " in the present, "
            },
            {
              "kind": "foreign_term",
              "value": "gjorde",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " in the simple past."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Liker du å lese på toget? Ja, det gjør jeg."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Do you like reading on the train? Yes, I do."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Han sa at han skulle ringe, men han gjorde det ikke."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "He said he would call, but he did not do it."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Møtet ble utsatt, og det overrasket ingen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The meeting was postponed, and that surprised no one."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "en"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "What points back"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Norwegian form"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Use"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "A thing or whole idea"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "det"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "that, it"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "A repeated action"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "gjøre det"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "do it, do so"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "A shared feeling or situation"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "samme her"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "same here"
                }
              ]
            ]
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_002",
      "role": "contrast",
      "objective_ids": [
        "obj_short_replies"
      ],
      "title": "Short Replies Are Complete Enough",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Short answers in Norwegian are often grammatically complete because the missing material is already active in the conversation. You do not need to repeat the whole verb phrase when a short answer is clearer and more natural."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "foreign_term",
              "value": "Gjerne",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " accepts an offer or invitation; "
            },
            {
              "kind": "foreign_term",
              "value": "samme her",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " says that the previous statement also applies to you; "
            },
            {
              "kind": "foreign_term",
              "value": "det gjør jeg",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " confirms a repeated action or habit."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Kan du sende meg rapporten? Gjerne."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Can you send me the report? Happy to."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg savner sommeren. Samme her."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I miss summer. Same here."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Trener du fortsatt på onsdager? Ja, det gjør jeg."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Do you still exercise on Wednesdays? Yes, I do."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "warning",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Do not translate every English short answer word for word. Norwegian often prefers a compact response that points back instead of repeating the full sentence."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_003",
      "role": "model",
      "objective_ids": [
        "obj_slik"
      ],
      "title": "Slik Points Back to a Way",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "foreign_term",
              "value": "Slik",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " means in this way, in that way, or like that. It points back to a method, manner, pattern, or wording rather than to a single object."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Use "
            },
            {
              "kind": "foreign_term",
              "value": "slik",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " when the reference is to how something is done, said, arranged, or understood."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun forklarte planen tydelig, og slik forstod alle hva de skulle gjøre."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She explained the plan clearly, and in that way everyone understood what they should do."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Du trenger ikke formulere det slik."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "You do not need to phrase it like that."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi gjorde det slik fordi fristen var kort."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We did it that way because the deadline was short."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_004",
      "role": "recap",
      "objective_ids": [
        "obj_ellipsis",
        "obj_det_gjore",
        "obj_short_replies",
        "obj_slik"
      ],
      "title": "Keep the Reference Clear",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The main question is always: what does the short form point back to? If it points to an offer, "
            },
            {
              "kind": "foreign_term",
              "value": "gjerne",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " may be enough. If it points to your matching situation, use "
            },
            {
              "kind": "foreign_term",
              "value": "samme her",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". If it points to a repeated action, use "
            },
            {
              "kind": "foreign_term",
              "value": "gjøre det",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ". If it points to a way or manner, use "
            },
            {
              "kind": "foreign_term",
              "value": "slik",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "text",
                "value": "For a whole idea or situation, use "
              },
              {
                "kind": "foreign_term",
                "value": "det",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            [
              {
                "kind": "text",
                "value": "For a repeated action, use "
              },
              {
                "kind": "foreign_term",
                "value": "gjøre det",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " with the correct tense."
              }
            ],
            [
              {
                "kind": "text",
                "value": "For an accepted offer, use "
              },
              {
                "kind": "foreign_term",
                "value": "gjerne",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            [
              {
                "kind": "text",
                "value": "For a shared situation, use "
              },
              {
                "kind": "foreign_term",
                "value": "samme her",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            [
              {
                "kind": "text",
                "value": "For a manner or pattern, use "
              },
              {
                "kind": "foreign_term",
                "value": "slik",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": "."
              }
            ]
          ]
        }
      ]
    },
