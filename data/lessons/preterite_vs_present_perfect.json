{
  "key": "preterite_vs_present_perfect",
  "concept_slug": "preterite_vs_present_perfect",
  "grounding_mode": "fallback_no_wiki",
  "title": "Past Tense or Present Perfect?",
  "cefr_level": "B1",
  "goal": "Choose between past tense and present perfect when talking about specific past events, experiences, results, unfinished periods, duration, and narrative sequences.",
  "objectives": [
    {
      "id": "o1",
      "statement": "Choose correctly between preteritum and presens perfektum based on whether a specific past time is given or the present result matters.",
      "bloom_targets": [
        "remember",
        "apply"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "s1",
      "role": "orient",
      "objective_ids": [
        "o1"
      ],
      "title": "Two ways to look back",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian often uses "
            },
            {
              "kind": "foreign_term",
              "value": "preteritum",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " (the simple past tense) for events placed at a specific past time, and "
            },
            {
              "kind": "foreign_term",
              "value": "presens perfektum",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " (the present perfect, har + participle) for past events connected to now: experience, result, or an unfinished time period."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg så filmen i går."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I saw the film yesterday."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg har sett filmen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I have seen the film."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "s2",
      "role": "model",
      "objective_ids": [
        "o1"
      ],
      "title": "Specific past time: preteritum",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Use preteritum when the sentence gives a specific past time, or when the situation clearly answers when?"
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Time phrases like "
            },
            {
              "kind": "foreign_term",
              "value": "i går, på mandag, i 2020, for to år siden",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " normally point to preteritum."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun flyttet til Trondheim i 2021."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She moved to Trondheim in 2021."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Questions with "
            },
            {
              "kind": "foreign_term",
              "value": "når",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " about a past event also ask for a specific time, so they normally use preteritum: "
            },
            {
              "kind": "foreign_term",
              "value": "Når flyttet du?",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " Clauses with past-time "
            },
            {
              "kind": "foreign_term",
              "value": "da",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " usually do the same: "
            },
            {
              "kind": "foreign_term",
              "value": "da han bodde i USA",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "s3",
      "role": "model",
      "objective_ids": [
        "o1"
      ],
      "title": "No specific time: present perfect",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Use present perfect when the exact time is not important or not mentioned. It often focuses on experience or present result."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg har vært i Tromsø."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I have been to Tromsø."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Han har mistet nøkkelen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "He has lost the key."
            }
          ]
        }
      ]
    },
    {
