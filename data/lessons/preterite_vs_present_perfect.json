    {
      "element_kind": "section",
      "id": "s5",
      "role": "model",
      "objective_ids": [
        "o1"
      ],
      "title": "Unfinished time and duration",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "With an unfinished period that includes now, Norwegian often uses present perfect. With duration, the tense can show whether the situation is still true."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg har jobbet mye denne uka."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I have worked a lot this week."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg har gjort leksene, så nå kan vi gå."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I have done the homework, so now we can leave."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg har bodd i Bergen i tre år."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I have lived in Bergen for three years. I still live there."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg bodde i Bergen i tre år."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I lived in Bergen for three years. The period is finished."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "s6",
      "role": "model",
      "objective_ids": [
        "o1"
      ],
      "title": "Stories use preteritum",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "When you tell a sequence of events in the past, preteritum is the normal narrative tense."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi kom hjem, laget middag og så en film."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We came home, made dinner and watched a film."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "s7",
      "role": "recap",
      "objective_ids": [
        "o1"
      ],
      "title": "A practical choice",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Use preteritum for a specific past time and for story sequences. Use present perfect when the time is not specified, the result matters now, the sentence talks about life experience, or the time period is still open."
            }
          ]
        }
      ]
    },
