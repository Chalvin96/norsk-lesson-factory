{
  "key": "fixed_prepositional_expressions",
  "concept_slug": "fixed_prepositional_expressions",
  "grounding_mode": "fallback_no_wiki",
  "title": "Fixed Prepositions After Common Norwegian Words",
  "cefr_level": "B1",
  "goal": "Use common fixed Norwegian word-plus-preposition expressions accurately in short sentences.",
  "objectives": [
    {
      "id": "obj_notice_fixed_pairs",
      "statement": "Recognize common fixed verb, adjective, and noun plus preposition patterns as single lexical units.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_choose_preposition",
      "statement": "Choose the correct preposition in frequent fixed expressions, even when English uses a different preposition.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_build_sentences",
      "statement": "Build natural Bokmål sentences with fixed prepositional expressions and a following noun, pronoun, or infinitive phrase.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [
        "obj_notice_fixed_pairs"
      ],
      "title": "Learn the Pair, Not Just the Word",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Norwegian often links a word to one fixed preposition. The main word can be an adjective, a verb, an action or state word, or a noun, a person, place, thing, or idea word. Treat the combination as one vocabulary item."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Learn fixed expressions as whole pairs: "
            },
            {
              "kind": "foreign_term",
              "value": "interessert i",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "flink til",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "redd for",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "avhengig av",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and "
            },
            {
              "kind": "foreign_term",
              "value": "glad i",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": "."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "These prepositions do not map one-to-one to English. You may say "
            },
            {
              "kind": "foreign_term",
              "value": "interessert i",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " even though English says interested in, but you say "
            },
            {
              "kind": "foreign_term",
              "value": "flink til",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " where English often says good at."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg er interessert i norsk historie."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I am interested in Norwegian history."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun er flink til å forklare grammatikk."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She is good at explaining grammar."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Barnet er redd for hunder."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "The child is afraid of dogs."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_001",
      "role": "model",
      "objective_ids": [
        "obj_notice_fixed_pairs"
      ],
      "title": "Common Adjective Pairs",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Many everyday fixed expressions use an adjective plus a preposition. The adjective changes meaning together with its preposition, so memorize the pair and then add the thing, person, or activity after it."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "no",
            "en",
            "en"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Norwegian pair"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Natural English meaning"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Typical continuation"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "interessert i"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "interested in"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "a topic, person, or activity"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "flink til"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "good at"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "a skill or an infinitive phrase"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "redd for"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "afraid of"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "something feared"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "avhengig av"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "dependent on"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "a person, thing, or condition"
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "glad i"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "fond of, love"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "a person, animal, food, place, or activity"
                }
              ]
            ]
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi er avhengige av bussen om morgenen."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We depend on the bus in the morning."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg er glad i kaffe, men jeg drikker ikke mye."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I like coffee, but I do not drink much."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "warning",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "Do not translate the English preposition automatically. Say "
                },
                {
                  "kind": "foreign_term",
                  "value": "glad i",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": " for being fond of someone or something, not "
                },
                {
                  "kind": "foreign_term",
                  "value": "glad av",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": "."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_002",
      "role": "model",
      "objective_ids": [
        "obj_notice_fixed_pairs"
      ],
      "title": "Verbs and Nouns Also Choose Prepositions",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Fixed prepositions are not only after adjectives. Some verbs and nouns also carry a preferred preposition. The preposition belongs to the expression, and the next word or phrase completes the meaning."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg venter på toget."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I am waiting for the train."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Han tenker på familien sin."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "He is thinking about his family."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "De har behov for mer tid."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "They need more time."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun har lyst til å reise i sommer."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She wants to travel this summer."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "After many fixed expressions, you can add a noun, a pronoun, or an infinitive, the base form with "
            },
            {
              "kind": "foreign_term",
              "value": "å",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " plus a verb, depending on the expression."
            }
          ]
        }
      ]
    },
    {
      "element_kind": "section",
      "id": "imported_section_003",
      "role": "contrast",
      "objective_ids": [
        "obj_choose_preposition"
      ],
      "title": "Where English Can Mislead You",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "English can point you in the right direction for meaning, but not always for the Norwegian preposition. Build a habit of checking the Norwegian pair before you speak or write."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "en",
            "no",
            "en"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "English idea"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Bokmål expression"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Why it matters"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "good at something"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "flink til noe"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Norwegian uses til, not a direct copy of at."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "afraid of something"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "redd for noe"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Norwegian uses for in this expression."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "dependent on something"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "avhengig av noe"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Norwegian uses av here."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "fond of something"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "glad i noe"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Norwegian uses i, not av."
                }
              ]
            ]
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Er du interessert i politikk?"
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Are you interested in politics?"
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg er ikke redd for å snakke norsk."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I am not afraid of speaking Norwegian."
            }
          ]
        }
      ]
    },
