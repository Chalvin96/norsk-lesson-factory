    {
      "element_kind": "section",
      "id": "imported_section_002",
      "role": "model",
      "objective_ids": [
        "obj_gender_groups"
      ],
      "title": "Learn Gender With the Noun",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "Gender belongs to the individual noun. You cannot reliably guess it from the English meaning, so the useful habit is to learn a small gender marker together with each new noun."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Learn a noun as a pair: gender marker plus noun."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg kjøper en bok."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I am buying a book."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hun åpner ei dør."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "She opens a door."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "De bor i et hus."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "They live in a house."
            }
          ]
        },
        {
          "kind": "callout",
          "level": "tip",
          "blocks": [
            {
              "kind": "paragraph",
              "spans": [
                {
                  "kind": "text",
                  "value": "When you write vocabulary notes, include the marker: "
                },
                {
                  "kind": "foreign_term",
                  "value": "en stol",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ", "
                },
                {
                  "kind": "foreign_term",
                  "value": "ei dør",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": ", "
                },
                {
                  "kind": "foreign_term",
                  "value": "et hus",
                  "lang": "no"
                },
                {
                  "kind": "text",
                  "value": "."
                }
              ]
            }
          ]
        }
      ]
