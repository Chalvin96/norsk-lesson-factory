          "no": [
            {
              "kind": "text",
              "value": "Jeg lukker ei dør."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I close a door."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg lukker en dør."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I close a door."
            }
          ]
        },
