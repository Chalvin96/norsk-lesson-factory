  "grounding_mode": "fallback_no_wiki",
  "title": "Noun Gender: en, ei, et",
  "cefr_level": "A1",
  "goal": "Recognize and use the gender of common Norwegian nouns.",
  "objectives": [
    {
      "id": "obj_gender_groups",
      "statement": "Identify the three Bokmål noun genders: masculine, feminine, and neuter.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_use_known_forms",
      "statement": "Choose the correct gender marker for familiar singular nouns.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_feminine_variant",
      "statement": "Recognize that many feminine nouns can also use masculine marking in Bokmål.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_gender_lexical",
      "statement": "Explain that a noun's gender belongs to the noun and must be learned with it.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [],
      "title": "Three Genders",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A noun is a word for a person, place, thing, or idea. In Bokmål, singular nouns belong to one of three genders: masculine, feminine, or neuter. This is grammatical gender, not natural gender."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "Bokmål nouns can be masculine, feminine, or neuter."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg har en stol."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I have a chair."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Her er ei dør."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Here is a door."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi ser et hus."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We see a house."
            }
          ]
        },
        {
          "kind": "list",
          "ordered": false,
          "items": [
            [
              {
                "kind": "foreign_term",
                "value": "en stol",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " shows a masculine noun."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "ei dør",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " shows a feminine noun."
              }
            ],
            [
              {
                "kind": "foreign_term",
                "value": "et hus",
                "lang": "no"
              },
              {
                "kind": "text",
                "value": " shows a neuter noun."
              }
            ]
          ]
        }
      ]
    },
