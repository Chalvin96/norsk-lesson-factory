              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is the clear feminine marker. At the same time, many feminine nouns are also commonly used with "
            },
            {
              "kind": "foreign_term",
              "value": "en",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " in Bokmål."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "For many feminine nouns, both "
            },
            {
              "kind": "foreign_term",
              "value": "ei",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " and "
            },
            {
              "kind": "foreign_term",
              "value": "en",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " can be acceptable in Bokmål."
            }
          ]
        },
