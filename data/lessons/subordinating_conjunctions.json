      ],
      "title": "Seven Useful Subordinating Conjunctions",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "These common words cover reported ideas, reasons, conditions, time, yes or no content, and concession. A concession means that something is true even though another fact might make it surprising."
            }
          ]
        },
        {
          "kind": "table",
          "col_langs": [
            "no",
            "en",
            "no"
          ],
          "headers": [
            [
              {
                "kind": "text",
                "value": "Subordinating conjunction"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Core use"
              }
            ],
            [
              {
                "kind": "text",
                "value": "Example"
              }
            ]
          ],
          "rows": [
            [
              [
                {
                  "kind": "text",
                  "value": "at"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "that, after verbs like think, say, know"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Hun sier at hun er trøtt."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "fordi"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "because, reason"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Han blir hjemme fordi han er syk."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "hvis"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "if, condition"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Hvis du vil, kan vi lage kaffe."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
                  "value": "når"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "when, future or repeated time"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Når jeg kommer hjem, ringer jeg deg."
                }
              ]
            ],
            [
              [
                {
                  "kind": "text",
