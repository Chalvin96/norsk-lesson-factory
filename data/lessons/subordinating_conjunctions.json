                }
              ],
              [
                {
                  "kind": "text",
                  "value": "even though"
                }
              ],
              [
                {
                  "kind": "text",
                  "value": "Hun går tur selv om det regner."
                }
              ]
            ]
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "In English you may sometimes leave out that, as in I think she is coming. In Norwegian, "
            },
            {
              "kind": "foreign_term",
              "value": "at",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " is normally kept in this kind of sentence."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg håper at du forstår."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I hope that you understand."
            }
          ]
        }
      ]
