    {
      "element_kind": "section",
      "id": "imported_section_009",
      "role": "model",
      "objective_ids": [
        "obj_dependency"
      ],
      "title": "Where the Clause Can Go",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A sentence can put the main clause first or the dependent clause first. A main clause is a clause that can stand alone as a full sentence. When the dependent clause comes first, Norwegian usually puts a comma before the main clause."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi spiser inne hvis det regner."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We eat inside if it rains."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Hvis det regner, spiser vi inne."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "If it rains, we eat inside."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "You may notice that word order changes around the clause boundary. The finite verb behaves differently depending on whether you are inside the dependent clause or back in the main clause. Focus on choosing the right subordinating conjunction and keeping the dependent idea attached to a main idea."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "A dependent clause can come before or after the main clause, but it should not be left alone as a complete sentence."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Selv om jeg er trøtt, må jeg jobbe."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "Even though I am tired, I have to work."
            }
          ]
        }
      ]
