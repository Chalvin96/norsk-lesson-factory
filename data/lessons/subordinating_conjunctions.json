          "kind": "text",
          "value": "Choose the sentence that has a dependent clause introduced by a subordinating conjunction."
        }
      ],
      "explanation": [
        {
          "kind": "text",
          "value": "Good noticing: "
        },
        {
          "kind": "foreign_term",
          "value": "fordi",
          "lang": "no"
        },
        {
          "kind": "text",
          "value": " starts a dependent reason clause, so the sentence needs the main idea too."
        }
      ],
      "derived_from": [],
      "payload": {
        "options": [
          {
            "option_id": "a",
            "text": "Jeg lager middag fordi jeg er sulten.",
            "why": "Correct. Fordi introduces the reason clause."
          },
          {
            "option_id": "b",
            "text": "Jeg lager middag, og jeg er sulten.",
            "why": "Og joins two main ideas; it does not introduce a dependent clause."
          },
          {
            "option_id": "c",
            "text": "Jeg lager middag nå.",
            "why": "Nå is a time word here, not a subordinating conjunction."
          }
        ],
        "answer_id": "a",
        "stem": [
          {
            "kind": "text",
            "value": "Which sentence has a dependent clause introduced by a subordinating conjunction?"
          }
        ]
      }
    },
    {
