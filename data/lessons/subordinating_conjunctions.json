{
  "key": "subordinating_conjunctions",
  "concept_slug": "subordinating_conjunctions",
  "grounding_mode": "fallback_no_wiki",
  "title": "Common Subordinating Conjunctions",
  "cefr_level": "A2",
  "goal": "Choose common Norwegian subordinating conjunctions and recognize the dependent clauses they introduce.",
  "objectives": [
    {
      "id": "obj_dependency",
      "statement": "Recognize that a subordinating conjunction introduces a dependent clause that needs another clause to make a full sentence.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_meanings",
      "statement": "Match common subordinating conjunctions to their core meanings and uses.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_contrasts",
      "statement": "Choose between key contrasts such as fordi and for, and da and når in simple contexts.",
      "bloom_targets": [
        "understand"
      ]
    },
    {
      "id": "obj_produce",
      "statement": "Build short sentences with a main clause and a subordinating conjunction clause.",
      "bloom_targets": [
        "understand"
      ]
    }
  ],
  "elements": [
    {
      "element_kind": "section",
      "id": "imported_section_000",
      "role": "orient",
      "objective_ids": [],
      "title": "What These Words Do",
      "blocks": [
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "A subordinating conjunction is a joining word that starts a dependent clause, a clause that cannot stand alone as a full sentence. In Norwegian, words like "
            },
            {
              "kind": "foreign_term",
              "value": "at",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", "
            },
            {
              "kind": "foreign_term",
              "value": "fordi",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": ", and "
            },
            {
              "kind": "foreign_term",
              "value": "hvis",
              "lang": "no"
            },
            {
              "kind": "text",
              "value": " tell you how one idea depends on another."
            }
          ]
        },
        {
          "kind": "rule",
          "statement": [
            {
              "kind": "text",
              "value": "A subordinating conjunction introduces a dependent clause; the full sentence usually also needs a main clause."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Jeg tror at hun kommer."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "I think that she is coming."
            }
          ]
        },
        {
          "kind": "example",
          "no": [
            {
              "kind": "text",
              "value": "Vi går hjem fordi det regner."
            }
          ],
          "en": [
            {
              "kind": "text",
              "value": "We are going home because it is raining."
            }
          ]
        },
        {
          "kind": "paragraph",
          "spans": [
            {
              "kind": "text",
              "value": "The dependent clause can come after the main clause, as in the examples above. It can also come first, but the important first step is to notice the subordinating conjunction and the clause it opens."
            }
          ]
        }
      ]
    },
    {
